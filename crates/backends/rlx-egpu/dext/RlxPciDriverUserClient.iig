#ifndef RlxPciDriverUserClient_h
#define RlxPciDriverUserClient_h

#include <Availability.h>
#include <DriverKit/IOUserClient.iig>

/// External method selectors. These are the contract `rlx-egpu` expects; see
/// `docs/egpu.md`. Renumbering them breaks every client.
enum RlxPciSelector {
    kRlxPciReadConfig  = 0,
    kRlxPciWriteConfig = 1,
    kRlxPciReset       = 2,
    kRlxPciPrepareDma  = 3,
};

/// Memory types for CopyClientMemoryForType. Values below `kRlxPciBarLimit`
/// name a BAR; anything at or above it is a DMA allocation whose *size* is the
/// type value.
enum {
    kRlxPciBarLimit = 6,
};

class RlxPciDriverUserClient: public IOUserClient
{
public:
    virtual bool init() override;
    virtual void free() override;
    virtual kern_return_t Start(IOService *provider) override;
    virtual kern_return_t Stop(IOService *provider) override;

    virtual kern_return_t ExternalMethod(uint64_t selector,
                                         IOUserClientMethodArguments *arguments,
                                         const IOUserClientMethodDispatch *dispatch,
                                         OSObject *target,
                                         void *reference) override;

    virtual kern_return_t CopyClientMemoryForType(uint64_t type,
                                                  uint64_t *options,
                                                  IOMemoryDescriptor **memory) override;
};

#endif /* RlxPciDriverUserClient_h */
