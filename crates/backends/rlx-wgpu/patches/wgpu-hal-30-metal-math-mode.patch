+/// `WGPU_METAL_MATH_MODE=safe|relaxed|fast` (unset: Metal's default, fast):
+/// the math mode WGSL→MSL libraries are compiled in. Safe also selects the
+/// precise transcendental functions.
+fn apply_math_mode(options: &objc2_metal::MTLCompileOptions) {
+    use objc2_metal::{MTLMathFloatingPointFunctions, MTLMathMode};
+    let Ok(mode) = std::env::var("WGPU_METAL_MATH_MODE") else {
+        return;
+    };
+    let (m, precise) = match mode.as_str() {
+        "safe" => (MTLMathMode::Safe, true),
+        "relaxed" => (MTLMathMode::Relaxed, false),
+        _ => (MTLMathMode::Fast, false),
+    };
+    if objc2::available!(macos = 15.0, ios = 18.0, tvos = 18.0, visionos = 2.0) {
+        options.setMathMode(m);
+        if precise {
+            options.setMathFloatingPointFunctions(MTLMathFloatingPointFunctions::Precise);
+        }
+    } else {
+        #[allow(deprecated)]
+        options.setFastMathEnabled(m == MTLMathMode::Fast);
+    }
+}
