// GGUF dequant — one thread per GGUF block. Block size varies per scheme:
//
//   scheme_id | scheme    | block elems | block bytes
//   ----------|-----------|-------------|------------
//      0      | Q4_K      | 256         | 144
//      1      | Q5_K      | 256         | 176
//      2      | Q6_K      | 256         | 210
//      3      | Q8_K      | 256         | 292
//      4      | Q2_K      | 256         | 84
//      5      | Q3_K      | 256         | 110
//      6      | IQ4_NL    | 32          | 18
//      7      | IQ4_XS    | 256         | 136
//      8      | TQ1_0     | 256         | 54
//      9      | TQ2_0     | 256         | 66
//     10      | MXFP4     | 32          | 17
//     11      | NVFP4     | 16          | 9
//     12      | IQ2_XXS   | 256         | 66    (uses grid LUT)
//     13      | IQ2_XS    | 256         | 74    (uses grid LUT)
//     14      | IQ2_S     | 256         | 82    (uses grid LUT)
//     15      | IQ3_XXS   | 256         | 98    (uses grid LUT)
//     16      | IQ3_S     | 256         | 110   (uses grid LUT)
//     17      | IQ1_S     | 256         | 50    (uses grid LUT)
//     18      | IQ1_M     | 256         | 56    (uses grid LUT)
//     19      | Q4_0      | 32          | 18
//     20      | Q8_0      | 32          | 34
//     21      | Q4_1      | 32          | 20
//     22      | Q5_0      | 32          | 22
//     23      | Q5_1      | 32          | 24
//     24      | Q1_0      | 128         | 18   (prism-ml Bonsai-27B)
//     25      | Q2_0      | 128         | 34
//
// Full backend matrix: docs/gguf-backend-paths.md
//
// Caller passes `num_blocks = total_elements / scheme.block_elems`.
//
// IQ-family schemes (12..=18) consult grid lookup tables held in a
// device buffer at `buffer(5)`. Tables are staged once at session init
// from rlx_gguf::iq_grids by `iq_grid_buffer()`. Layout (concatenated):
//
//   offset    bytes    table
//   0         8        KMASK_IQ2XS (u8 × 8)
//   8         128      KSIGNS_IQ2XS (u8 × 128)
//   136       2048     KGRID_IQ2XXS (u64 × 256)
//   2184      4096     KGRID_IQ2XS (u64 × 512)
//   6280      8192     KGRID_IQ2S (u64 × 1024)
//   14472     1024     KGRID_IQ3XXS (u32 × 256)
//   15496     2048     KGRID_IQ3S (u32 × 512)
//   17544     16384    KGRID_IQ1S (u64 × 2048)

constant uint DQ_QK_K = 256u;
constant uint DQ_K_SCALE_SIZE = 12u;
constant uint DQ_QK4_NL = 32u;
constant uint DQ_QK_MXFP4 = 32u;
constant uint DQ_QK_NVFP4 = 16u;

constant uint IQ_GRID_OFF_KMASK     = 0u;
constant uint IQ_GRID_OFF_KSIGNS    = 8u;
constant uint IQ_GRID_OFF_IQ2XXS    = 136u;
constant uint IQ_GRID_OFF_IQ2XS     = 2184u;
constant uint IQ_GRID_OFF_IQ2S      = 6280u;
constant uint IQ_GRID_OFF_IQ3XXS    = 14472u;
constant uint IQ_GRID_OFF_IQ3S      = 15496u;
constant uint IQ_GRID_OFF_IQ1S      = 17544u;

// IQ4_NL / IQ4_XS non-linear LUT.
constant int kvalues_iq4nl_lut[16] = {
    -127, -104, -83, -65, -49, -35, -22, -10, 1, 13, 25, 38, 53, 69, 89, 113
};

inline float dq_read_f16(device const uchar* b, uint off) {
    ushort bits = ushort(b[off]) | (ushort(b[off + 1u]) << 8u);
    uint sign = (uint(bits) >> 15u) & 1u;
    uint exp  = (uint(bits) >> 10u) & 0x1Fu;
    uint mant = uint(bits) & 0x3FFu;
    float v;
    if (exp == 0u) {
        v = float(mant) / 1024.0f * exp2(-14.0f);
    } else if (exp == 31u) {
        v = (mant == 0u) ? INFINITY : 0.0f;
    } else {
        v = (1.0f + float(mant) / 1024.0f) * exp2(float(int(exp) - 15));
    }
    return (sign != 0u) ? -v : v;
}

inline void dq_get_scale_min_k4(device const uchar* q, uint j, thread uint& sc, thread uint& mn) {
    if (j < 4u) {
        sc = uint(q[j]) & 63u;
        mn = uint(q[j + 4u]) & 63u;
    } else {
        sc = (uint(q[j + 4u]) & 0x0Fu) | (((uint(q[j - 4u]) >> 6u) & 3u) << 4u);
        mn = (uint(q[j + 4u]) >> 4u) | (((uint(q[j]) >> 6u) & 3u) << 4u);
    }
}

// Read one byte from the LUT buffer.
inline uchar lut_u8(device const uchar* lut, uint off) {
    return lut[off];
}

// Read one i8 grid byte at `entry_off + byte_idx`.
inline int lut_i8(device const uchar* lut, uint off) {
    return int((char)lut[off]);
}

inline uint lut_u16(device const uchar* lut, uint off) {
    return uint(lut[off]) | (uint(lut[off + 1u]) << 8u);
}

inline uint lut_u32(device const uchar* lut, uint off) {
    return uint(lut[off])
         | (uint(lut[off + 1u]) << 8u)
         | (uint(lut[off + 2u]) << 16u)
         | (uint(lut[off + 3u]) << 24u);
}

kernel void dequant_gguf(
    device float* arena        [[buffer(0)]],
    constant ulong& w_byte_off   [[buffer(1)]],
    constant ulong& dst_f32_off  [[buffer(2)]],
    constant uint& scheme_id     [[buffer(3)]],
    constant uint& num_blocks    [[buffer(4)]],
    device const uchar* iq_lut   [[buffer(5)]],
    uint gid                     [[thread_position_in_grid]]
) {
    if (gid >= num_blocks) return;

    // w_byte_off / dst_f32_off are 64-bit because for ≥4 GB models the
    // activation byte offsets exceed u32 (task #50: 12B Q4 GGUF arena ≈14 GB).
    device uchar* w_base = (device uchar*)((device char*)arena + w_byte_off);

    // ── 256-elem block schemes (K-quants, IQ4_XS, IQ2/3/1, TQ) ─────
    if (scheme_id != 6u && scheme_id != 10u && scheme_id != 11u
        && scheme_id != 19u && scheme_id != 20u
        && scheme_id != 21u && scheme_id != 22u && scheme_id != 23u
        && scheme_id != 24u && scheme_id != 25u) {
        device float* dst = arena + dst_f32_off + gid * DQ_QK_K;

        if (scheme_id == 3u) {
            uint off = gid * (4u + DQ_QK_K + (DQ_QK_K / 16u) * 2u);
            float d = as_type<float>(*(device uint*)(w_base + off));
            device const uchar* qs = w_base + off + 4u;
            for (uint i = 0; i < DQ_QK_K; ++i) dst[i] = d * float(int8_t(qs[i]));
            return;
        }

        if (scheme_id == 26u) {
            // FV5 (Neutrino-8B ternary): f32 s_lo | f32 s_hi | three 32-byte
            // bit-planes bp(+1) | bn(-1) | br(hi-mag select). 104 bytes / 256
            // elements, LSB-first. w = (bp-bn) * (br ? s_hi : s_lo).
            uint off = gid * 104u;
            float s_lo = as_type<float>(*(device uint*)(w_base + off));
            float s_hi = as_type<float>(*(device uint*)(w_base + off + 4u));
            device const uchar* bp = w_base + off + 8u;
            device const uchar* bn = w_base + off + 40u;
            device const uchar* br = w_base + off + 72u;
            for (uint j = 0u; j < DQ_QK_K; ++j) {
                uint byte = j >> 3u;
                uint bit = 1u << (j & 7u);
                int sign = int((bp[byte] & bit) != 0u) - int((bn[byte] & bit) != 0u);
                float mag = ((br[byte] & bit) != 0u) ? s_hi : s_lo;
                dst[j] = float(sign) * mag;
            }
            return;
        }

        if (scheme_id == 27u) {
            // FV5B (Neutrino-8B): f32 s | 256 int8 codes (260 bytes / 256 elems).
            uint off = gid * 260u;
            float s = as_type<float>(*(device uint*)(w_base + off));
            device const uchar* qs = w_base + off + 4u;
            for (uint i = 0; i < DQ_QK_K; ++i) dst[i] = s * float(int8_t(qs[i]));
            return;
        }

        if (scheme_id == 0u) {
            uint blk = 2u + 2u + DQ_K_SCALE_SIZE + DQ_QK_K / 2u;
            uint off = gid * blk;
            float d = dq_read_f16(w_base, off);
            float dmin = dq_read_f16(w_base, off + 2u);
            device const uchar* scales = w_base + off + 4u;
            device const uchar* qs = w_base + off + 4u + DQ_K_SCALE_SIZE;
            uint is = 0u, out_i = 0u;
            for (uint j = 0u; j < 8u; j += 2u) {
                uint sc0, m0, sc1, m1;
                dq_get_scale_min_k4(scales, j, sc0, m0);
                dq_get_scale_min_k4(scales, j + 1u, sc1, m1);
                float d0 = d * float(sc0), m0f = dmin * float(m0);
                float d1 = d * float(sc1), m1f = dmin * float(m1);
                for (uint l = 0u; l < 32u; ++l) dst[out_i++] = d0 * float(qs[is + l] & 0x0Fu) - m0f;
                for (uint l = 0u; l < 32u; ++l) dst[out_i++] = d1 * float(qs[is + l] >> 4) - m1f;
                is += 32u;
            }
            return;
        }

        if (scheme_id == 1u) {
            uint blk = 2u + 2u + DQ_K_SCALE_SIZE + DQ_QK_K / 8u + DQ_QK_K / 2u;
            uint off = gid * blk;
            float d = dq_read_f16(w_base, off);
            float dmin = dq_read_f16(w_base, off + 2u);
            device const uchar* scales = w_base + off + 4u;
            uint qh_off = off + 4u + DQ_K_SCALE_SIZE;
            device const uchar* qh = w_base + qh_off;
            device const uchar* qs = w_base + qh_off + DQ_QK_K / 8u;
            uint is = 0u, out_i = 0u;
            uchar u1 = 1u, u2 = 2u;
            for (uint j = 0u; j < 8u; j += 2u) {
                uint sc0, m0, sc1, m1;
                dq_get_scale_min_k4(scales, j, sc0, m0);
                dq_get_scale_min_k4(scales, j + 1u, sc1, m1);
                float d0 = d * float(sc0), m0f = dmin * float(m0);
                float d1 = d * float(sc1), m1f = dmin * float(m1);
                for (uint l = 0u; l < 32u; ++l) {
                    uint lo = uint(qs[is + l]) & 0x0Fu;
                    uint hi = (qh[l] & u1) != 0u ? 16u : 0u;
                    dst[out_i++] = d0 * float(lo + hi) - m0f;
                }
                for (uint l = 0u; l < 32u; ++l) {
                    uint lo = uint(qs[is + l]) >> 4u;
                    uint hi = (qh[l] & u2) != 0u ? 16u : 0u;
                    dst[out_i++] = d1 * float(lo + hi) - m1f;
                }
                is += 32u;
                u1 <<= 2;
                u2 <<= 2;
            }
            return;
        }

        if (scheme_id == 2u) {
            uint ql_len = DQ_QK_K / 2u, qh_len = DQ_QK_K / 4u, sc_len = DQ_QK_K / 16u;
            uint blk = ql_len + qh_len + sc_len + 2u;
            uint off = gid * blk;
            device const uchar* ql = w_base + off;
            device const uchar* qh = w_base + off + ql_len;
            device const uchar* sc = w_base + off + ql_len + qh_len;
            float d = dq_read_f16(w_base, off + ql_len + qh_len + sc_len);
            for (uint h = 0u; h < 2u; ++h) {
                uint dst_base = h * 128u, ql_off = h * 64u, qh_off_h = h * 32u, sc_off = h * 8u;
                for (uint l = 0u; l < 32u; ++l) {
                    uint is = l / 16u;
                    uchar qh_b = qh[qh_off_h + l];
                    float q1 = float(int(((ql[ql_off + l] & 0x0Fu) | (((qh_b >> 0) & 3u) << 4u)) - 32));
                    float q2 = float(int(((ql[ql_off + l + 32u] & 0x0Fu) | (((qh_b >> 2) & 3u) << 4u)) - 32));
                    float q3 = float(int(((ql[ql_off + l] >> 4) | (((qh_b >> 4) & 3u) << 4u)) - 32));
                    float q4 = float(int(((ql[ql_off + l + 32u] >> 4) | (((qh_b >> 6) & 3u) << 4u)) - 32));
                    dst[dst_base + l] = d * float(int8_t(sc[sc_off + is])) * q1;
                    dst[dst_base + l + 32u] = d * float(int8_t(sc[sc_off + is + 2u])) * q2;
                    dst[dst_base + l + 64u] = d * float(int8_t(sc[sc_off + is + 4u])) * q3;
                    dst[dst_base + l + 96u] = d * float(int8_t(sc[sc_off + is + 6u])) * q4;
                }
            }
            return;
        }

        if (scheme_id == 4u) {
            // Q2_K: scales[16] | qs[64] | d (f16) | dmin (f16).
            uint blk = 2u + 2u + DQ_QK_K / 16u + DQ_QK_K / 4u;
            uint off = gid * blk;
            uint scales_off = off;
            uint qs_off = off + DQ_QK_K / 16u;
            uint d_off = qs_off + DQ_QK_K / 4u;
            float d = dq_read_f16(w_base, d_off);
            float min_v = dq_read_f16(w_base, d_off + 2u);
            device const uchar* q = w_base + qs_off;
            uint is = 0u, out_i = 0u;
            for (uint sb = 0u; sb < 2u; ++sb) {
                uint shift = 0u;
                for (uint t = 0u; t < 4u; ++t) {
                    uchar sc = w_base[scales_off + is]; is += 1u;
                    float dl = d * float(sc & 0xFu); float ml = min_v * float(sc >> 4);
                    for (uint l = 0u; l < 16u; ++l) dst[out_i++] = dl * float((q[l] >> shift) & 3u) - ml;
                    sc = w_base[scales_off + is]; is += 1u;
                    dl = d * float(sc & 0xFu); ml = min_v * float(sc >> 4);
                    for (uint l = 0u; l < 16u; ++l) dst[out_i++] = dl * float((q[l + 16u] >> shift) & 3u) - ml;
                    shift += 2u;
                }
                q += 32u;
            }
            return;
        }

        if (scheme_id == 5u) {
            // Q3_K: hmask[32] | qs[64] | scales[12] | d (f16).
            const uint KMASK1 = 0x03030303u;
            const uint KMASK2 = 0x0f0f0f0fu;
            uint blk = 2u + DQ_K_SCALE_SIZE + DQ_QK_K / 8u + DQ_QK_K / 4u;
            uint off = gid * blk;
            uint hm_off = off;
            uint qs_off = off + DQ_QK_K / 8u;
            uint scales_off = qs_off + DQ_QK_K / 4u;
            uint d_off = scales_off + DQ_K_SCALE_SIZE;
            float d_all = dq_read_f16(w_base, d_off);
            device const uchar* hm = w_base + hm_off;
            device const uchar* q = w_base + qs_off;
            uint aux0 = uint(w_base[scales_off + 0u]) | (uint(w_base[scales_off + 1u]) << 8u)
                      | (uint(w_base[scales_off + 2u]) << 16u) | (uint(w_base[scales_off + 3u]) << 24u);
            uint aux1 = uint(w_base[scales_off + 4u]) | (uint(w_base[scales_off + 5u]) << 8u)
                      | (uint(w_base[scales_off + 6u]) << 16u) | (uint(w_base[scales_off + 7u]) << 24u);
            uint aux2 = uint(w_base[scales_off + 8u]) | (uint(w_base[scales_off + 9u]) << 8u)
                      | (uint(w_base[scales_off + 10u]) << 16u) | (uint(w_base[scales_off + 11u]) << 24u);
            uint tmp = aux2;
            // 16 six-bit sub-block scales (QK_K=256 → is runs 0..15). aux2/aux3
            // must be derived from the ORIGINAL aux0/aux1 before they are
            // overwritten below (matches ggml `dequantize_row_q3_K`).
            aux2 = ((aux0 >> 4) & KMASK2) | (((tmp >> 4) & KMASK1) << 4);
            uint aux3 = ((aux1 >> 4) & KMASK2) | (((tmp >> 6) & KMASK1) << 4);
            aux0 = (aux0 & KMASK2) | (((tmp >> 0) & KMASK1) << 4);
            aux1 = (aux1 & KMASK2) | (((tmp >> 2) & KMASK1) << 4);
            thread char scales[16];
            *((thread uint*)&scales[0]) = aux0;
            *((thread uint*)&scales[4]) = aux1;
            *((thread uint*)&scales[8]) = aux2;
            *((thread uint*)&scales[12]) = aux3;
            uint is = 0u; uchar m = 1u; uint out_i = 0u;
            for (uint sb = 0u; sb < 2u; ++sb) {
                uint shift = 0u;
                for (uint t = 0u; t < 4u; ++t) {
                    float dl = d_all * float(int(scales[is]) - 32); is += 1u;
                    for (uint l = 0u; l < 16u; ++l) {
                        int h = (hm[l] & m) != 0u ? 0 : 4;
                        dst[out_i++] = dl * float(int(((q[l] >> shift) & 3u)) - h);
                    }
                    dl = d_all * float(int(scales[is]) - 32); is += 1u;
                    for (uint l = 0u; l < 16u; ++l) {
                        int h = (hm[l + 16u] & m) != 0u ? 0 : 4;
                        dst[out_i++] = dl * float(int(((q[l + 16u] >> shift) & 3u)) - h);
                    }
                    shift += 2u; m <<= 1;
                }
                q += 32u;
            }
            return;
        }

        if (scheme_id == 7u) {
            // IQ4_XS: 136 bytes / 256 elems.
            uint blk = 2u + 2u + DQ_QK_K / 64u + DQ_QK_K / 2u;
            uint off = gid * blk;
            float d = dq_read_f16(w_base, off);
            uint scales_h = uint(w_base[off + 2u]) | (uint(w_base[off + 3u]) << 8u);
            device const uchar* scales_l = w_base + off + 4u;
            device const uchar* qs = w_base + off + 4u + DQ_QK_K / 64u;
            uint out_i = 0u, qs_idx = 0u;
            for (uint ib = 0u; ib < DQ_QK_K / 32u; ++ib) {
                uint lo = (uint(scales_l[ib / 2u]) >> (4u * (ib % 2u))) & 0xFu;
                uint hi = (scales_h >> (2u * ib)) & 0x3u;
                int ls = int(lo | (hi << 4u));
                float dl = d * float(ls - 32);
                for (uint j = 0u; j < 16u; ++j) {
                    uchar bx = qs[qs_idx + j];
                    dst[out_i + j] = dl * float(kvalues_iq4nl_lut[bx & 0x0Fu]);
                    dst[out_i + j + 16u] = dl * float(kvalues_iq4nl_lut[bx >> 4]);
                }
                out_i += 32u;
                qs_idx += 16u;
            }
            return;
        }

        if (scheme_id == 8u) {
            // TQ1_0: qs[48] | qh[4] | d (f16). Trit unpacking via the
            // (q * pow3[n] * 3) >> 8 trick — see rlx_gguf::tq_dequant.
            const uchar POW3[5] = { 1, 3, 9, 27, 81 };
            uint off = gid * 54u;
            device const uchar* qs = w_base + off;
            device const uchar* qh = w_base + off + 48u;
            float d = dq_read_f16(w_base, off + 52u);
            uint y = 0u;
            // First chunk: 32 bytes packing 160 trits.
            for (uint n = 0u; n < 5u; ++n) {
                for (uint m = 0u; m < 32u; ++m) {
                    uchar q = uchar(uint(qs[m]) * uint(POW3[n]));
                    int xi = int((uint(q) * 3u) >> 8u);
                    dst[y++] = float(xi - 1) * d;
                }
            }
            // Second chunk: 16 bytes packing 80 trits.
            for (uint n = 0u; n < 5u; ++n) {
                for (uint m = 0u; m < 16u; ++m) {
                    uchar q = uchar(uint(qs[32u + m]) * uint(POW3[n]));
                    int xi = int((uint(q) * 3u) >> 8u);
                    dst[y++] = float(xi - 1) * d;
                }
            }
            // qh: 4 bytes packing 16 trits.
            for (uint n = 0u; n < 4u; ++n) {
                for (uint j = 0u; j < 4u; ++j) {
                    uchar q = uchar(uint(qh[j]) * uint(POW3[n]));
                    int xi = int((uint(q) * 3u) >> 8u);
                    dst[y++] = float(xi - 1) * d;
                }
            }
            return;
        }

        if (scheme_id == 9u) {
            // TQ2_0: qs[64] | d (f16). 4 trits per byte (low→high) but
            // emission order is (j+m, slot l) → element index out_y.
            uint off = gid * 66u;
            device const uchar* qs = w_base + off;
            float d = dq_read_f16(w_base, off + 64u);
            uint y = 0u;
            for (uint j = 0u; j < 64u; j += 32u) {
                for (uint l = 0u; l < 4u; ++l) {
                    for (uint m = 0u; m < 32u; ++m) {
                        int q = int((qs[j + m] >> (l * 2u)) & 3u);
                        dst[y++] = float(q - 1) * d;
                    }
                }
            }
            return;
        }

        if (scheme_id == 12u) {
            // IQ2_XXS: f16 d | u16 qs[32] (= 64 bytes). 4 u16 per
            // 32-elem sub-block; aux32[0] = 4 grid indices (u8),
            // aux32[1] = 4 × 7-bit sign masks + 4-bit scale.
            uint off = gid * 66u;
            float d = dq_read_f16(w_base, off);
            device const uchar* qs = w_base + off + 2u;
            uint y = 0u;
            for (uint ib32 = 0u; ib32 < 8u; ++ib32) {
                uint base = 8u * ib32;
                uint aux32_0 = uint(qs[base + 0u]) | (uint(qs[base + 1u]) << 8u)
                             | (uint(qs[base + 2u]) << 16u) | (uint(qs[base + 3u]) << 24u);
                uint aux32_1 = uint(qs[base + 4u]) | (uint(qs[base + 5u]) << 8u)
                             | (uint(qs[base + 6u]) << 16u) | (uint(qs[base + 7u]) << 24u);
                uchar a0 = uchar(aux32_0 & 0xFFu);
                uchar a1 = uchar((aux32_0 >> 8) & 0xFFu);
                uchar a2 = uchar((aux32_0 >> 16) & 0xFFu);
                uchar a3 = uchar((aux32_0 >> 24) & 0xFFu);
                float db = d * (0.5f + float(aux32_1 >> 28)) * 0.25f;
                uchar grid_bytes[4] = { a0, a1, a2, a3 };
                for (uint l = 0u; l < 4u; ++l) {
                    uint grid_off = IQ_GRID_OFF_IQ2XXS + uint(grid_bytes[l]) * 8u;
                    uchar signs = lut_u8(iq_lut, IQ_GRID_OFF_KSIGNS + ((aux32_1 >> (7u * l)) & 127u));
                    for (uint j = 0u; j < 8u; ++j) {
                        int gv = lut_i8(iq_lut, grid_off + j);
                        uchar mask = lut_u8(iq_lut, IQ_GRID_OFF_KMASK + j);
                        float s = (signs & mask) != 0u ? -1.0f : 1.0f;
                        dst[y + j] = db * float(gv) * s;
                    }
                    y += 8u;
                }
            }
            return;
        }

        if (scheme_id == 13u) {
            // IQ2_XS: f16 d | u16 qs[32] | u8 scales[8] = 74 bytes.
            uint off = gid * 74u;
            float d = dq_read_f16(w_base, off);
            device const uchar* qs = w_base + off + 2u;
            device const uchar* scales = w_base + off + 2u + 64u;
            uint y = 0u;
            for (uint ib32 = 0u; ib32 < 8u; ++ib32) {
                float db0 = d * (0.5f + float(scales[ib32] & 0xFu)) * 0.25f;
                float db1 = d * (0.5f + float(scales[ib32] >> 4u)) * 0.25f;
                for (uint l = 0u; l < 4u; ++l) {
                    uint pos = (4u * ib32 + l) * 2u;
                    uint q = uint(qs[pos]) | (uint(qs[pos + 1u]) << 8u);
                    uint grid_off = IQ_GRID_OFF_IQ2XS + (q & 511u) * 8u;
                    uchar signs = lut_u8(iq_lut, IQ_GRID_OFF_KSIGNS + (q >> 9));
                    float dl = (l / 2u == 0u) ? db0 : db1;
                    for (uint j = 0u; j < 8u; ++j) {
                        int gv = lut_i8(iq_lut, grid_off + j);
                        uchar mask = lut_u8(iq_lut, IQ_GRID_OFF_KMASK + j);
                        float s = (signs & mask) != 0u ? -1.0f : 1.0f;
                        dst[y + j] = dl * float(gv) * s;
                    }
                    y += 8u;
                }
            }
            return;
        }

        if (scheme_id == 14u) {
            // IQ2_S: f16 d | qs[64] | qh[8] | scales[8] = 82 bytes.
            uint off = gid * 82u;
            float d = dq_read_f16(w_base, off);
            device const uchar* qs = w_base + off + 2u;
            device const uchar* qh = w_base + off + 2u + 64u;
            device const uchar* scales = w_base + off + 2u + 64u + 8u;
            uint y = 0u;
            uint qs_idx = 0u, signs_idx = 32u;
            for (uint ib32 = 0u; ib32 < 8u; ++ib32) {
                float db0 = d * (0.5f + float(scales[ib32] & 0xFu)) * 0.25f;
                float db1 = d * (0.5f + float(scales[ib32] >> 4u)) * 0.25f;
                for (uint l = 0u; l < 4u; ++l) {
                    float dl = (l / 2u == 0u) ? db0 : db1;
                    uint q = uint(qs[qs_idx + l]);
                    uint qh_b = uint(qh[ib32]);
                    uint idx = q | ((qh_b << (8u - 2u * l)) & 0x300u);
                    uint grid_off = IQ_GRID_OFF_IQ2S + idx * 8u;
                    uchar sign = qs[signs_idx + l];
                    for (uint j = 0u; j < 8u; ++j) {
                        int gv = lut_i8(iq_lut, grid_off + j);
                        uchar mask = lut_u8(iq_lut, IQ_GRID_OFF_KMASK + j);
                        float s = (sign & mask) != 0u ? -1.0f : 1.0f;
                        dst[y + j] = dl * float(gv) * s;
                    }
                    y += 8u;
                }
                qs_idx += 4u; signs_idx += 4u;
            }
            return;
        }

        if (scheme_id == 15u) {
            // IQ3_XXS: f16 d | qs[64] | scales_and_signs[32] = 98 bytes.
            uint off = gid * 98u;
            float d = dq_read_f16(w_base, off);
            device const uchar* qs = w_base + off + 2u;
            device const uchar* sas = w_base + off + 2u + 64u;
            uint y = 0u, qs_idx = 0u;
            for (uint ib32 = 0u; ib32 < 8u; ++ib32) {
                uint aux32 = uint(sas[4u*ib32]) | (uint(sas[4u*ib32+1u]) << 8u)
                           | (uint(sas[4u*ib32+2u]) << 16u) | (uint(sas[4u*ib32+3u]) << 24u);
                float db = d * (0.5f + float(aux32 >> 28)) * 0.5f;
                for (uint l = 0u; l < 4u; ++l) {
                    uchar signs = lut_u8(iq_lut, IQ_GRID_OFF_KSIGNS + ((aux32 >> (7u * l)) & 127u));
                    uint g1_off = IQ_GRID_OFF_IQ3XXS + uint(qs[qs_idx + 2u * l]) * 4u;
                    uint g2_off = IQ_GRID_OFF_IQ3XXS + uint(qs[qs_idx + 2u * l + 1u]) * 4u;
                    for (uint j = 0u; j < 4u; ++j) {
                        int g1 = lut_i8(iq_lut, g1_off + j);
                        int g2 = lut_i8(iq_lut, g2_off + j);
                        uchar m0 = lut_u8(iq_lut, IQ_GRID_OFF_KMASK + j);
                        uchar m1 = lut_u8(iq_lut, IQ_GRID_OFF_KMASK + j + 4u);
                        float s0 = (signs & m0) != 0u ? -1.0f : 1.0f;
                        float s1 = (signs & m1) != 0u ? -1.0f : 1.0f;
                        dst[y + j] = db * float(g1) * s0;
                        dst[y + j + 4u] = db * float(g2) * s1;
                    }
                    y += 8u;
                }
                qs_idx += 8u;
            }
            return;
        }

        if (scheme_id == 16u) {
            // IQ3_S: f16 d | qs[64] | qh[8] | signs[32] | scales[4] = 110 bytes.
            uint off = gid * 110u;
            float d = dq_read_f16(w_base, off);
            device const uchar* qs = w_base + off + 2u;
            device const uchar* qh = w_base + off + 2u + 64u;
            device const uchar* signs = w_base + off + 2u + 64u + 8u;
            device const uchar* scales = w_base + off + 2u + 64u + 8u + 32u;
            uint y = 0u, qs_walk = 0u, signs_walk = 0u, qh_walk = 0u;
            for (uint ib32 = 0u; ib32 < 8u; ib32 += 2u) {
                float db1 = d * (1.0f + 2.0f * float(scales[ib32 / 2u] & 0xFu));
                float db2 = d * (1.0f + 2.0f * float(scales[ib32 / 2u] >> 4u));
                for (uint half_iter = 0u; half_iter < 2u; ++half_iter) {
                    float dl = (half_iter == 0u) ? db1 : db2;
                    uint qh_byte = uint(qh[qh_walk + half_iter]);
                    for (uint l = 0u; l < 4u; ++l) {
                        uint idx1 = uint(qs[qs_walk + 2u * l]) | (((qh_byte << (8u - 2u * l)) & 256u));
                        uint idx2 = uint(qs[qs_walk + 2u * l + 1u]) | (((qh_byte << (7u - 2u * l)) & 256u));
                        uint g1_off = IQ_GRID_OFF_IQ3S + idx1 * 4u;
                        uint g2_off = IQ_GRID_OFF_IQ3S + idx2 * 4u;
                        uchar sign = signs[signs_walk + l];
                        for (uint j = 0u; j < 4u; ++j) {
                            int g1 = lut_i8(iq_lut, g1_off + j);
                            int g2 = lut_i8(iq_lut, g2_off + j);
                            uchar m0 = lut_u8(iq_lut, IQ_GRID_OFF_KMASK + j);
                            uchar m1 = lut_u8(iq_lut, IQ_GRID_OFF_KMASK + j + 4u);
                            float s0 = (sign & m0) != 0u ? -1.0f : 1.0f;
                            float s1 = (sign & m1) != 0u ? -1.0f : 1.0f;
                            dst[y + j] = dl * float(g1) * s0;
                            dst[y + j + 4u] = dl * float(g2) * s1;
                        }
                        y += 8u;
                    }
                    qs_walk += 8u; signs_walk += 4u;
                }
                qh_walk += 2u;
            }
            return;
        }

        if (scheme_id == 17u) {
            // IQ1_S: f16 d | qs[32] | qh[16] (u16 × 8) = 50 bytes.
            uint off = gid * 50u;
            float d = dq_read_f16(w_base, off);
            device const uchar* qs = w_base + off + 2u;
            device const uchar* qh_bytes = w_base + off + 2u + 32u;
            uint y = 0u, qs_idx = 0u;
            for (uint ib = 0u; ib < 8u; ++ib) {
                uint qh = uint(qh_bytes[2u * ib]) | (uint(qh_bytes[2u * ib + 1u]) << 8u);
                float dl = d * (2.0f * float((qh >> 12) & 7u) + 1.0f);
                float delta = (qh & 0x8000u) != 0u ? -0.125f : 0.125f;
                for (uint l = 0u; l < 4u; ++l) {
                    uint idx = uint(qs[qs_idx + l]) | (((qh >> (3u * l)) & 7u) << 8u);
                    uint grid_off = IQ_GRID_OFF_IQ1S + idx * 8u;
                    for (uint j = 0u; j < 8u; ++j) {
                        int gv = lut_i8(iq_lut, grid_off + j);
                        dst[y + j] = dl * (float(gv) + delta);
                    }
                    y += 8u;
                }
                qs_idx += 4u;
            }
            return;
        }

        if (scheme_id == 18u) {
            // IQ1_M: qs[32] | qh[16] | scales[8] = 56 bytes (no leading d!).
            uint off = gid * 56u;
            device const uchar* qs = w_base + off;
            device const uchar* qh = w_base + off + 32u;
            device const uchar* scales_b = w_base + off + 48u;
            // Reconstruct f16 scale from 4 packed nibbles.
            uint sc0 = lut_u16(scales_b, 0u);
            uint sc1 = lut_u16(scales_b, 2u);
            uint sc2 = lut_u16(scales_b, 4u);
            uint sc3 = lut_u16(scales_b, 6u);
            uint sc_u16 = (sc0 >> 12) | ((sc1 >> 8) & 0x00F0u)
                        | ((sc2 >> 4) & 0x0F00u) | (sc3 & 0xF000u);
            // Inline f16 decode.
            uint sign = (sc_u16 >> 15) & 1u;
            uint exp_v = (sc_u16 >> 10) & 0x1Fu;
            uint mant = sc_u16 & 0x3FFu;
            float d;
            if (exp_v == 0u) d = float(mant) / 1024.0f * exp2(-14.0f);
            else if (exp_v == 31u) d = (mant == 0u) ? INFINITY : 0.0f;
            else d = (1.0f + float(mant) / 1024.0f) * exp2(float(int(exp_v) - 15));
            if (sign != 0u) d = -d;
            uint sc_arr[4] = { sc0, sc1, sc2, sc3 };
            uint y = 0u, qs_walk = 0u, qh_walk = 0u;
            for (uint ib = 0u; ib < 8u; ++ib) {
                float dl1 = d * (2.0f * float((sc_arr[ib / 2u] >> (6u * (ib % 2u))) & 0x7u) + 1.0f);
                float dl2 = d * (2.0f * float((sc_arr[ib / 2u] >> (6u * (ib % 2u) + 3u)) & 0x7u) + 1.0f);
                uint idx[4];
                idx[0] = uint(qs[qs_walk]) | ((uint(qh[qh_walk]) << 8) & 0x700u);
                idx[1] = uint(qs[qs_walk + 1u]) | ((uint(qh[qh_walk]) << 4) & 0x700u);
                idx[2] = uint(qs[qs_walk + 2u]) | ((uint(qh[qh_walk + 1u]) << 8) & 0x700u);
                idx[3] = uint(qs[qs_walk + 3u]) | ((uint(qh[qh_walk + 1u]) << 4) & 0x700u);
                float delta[4];
                delta[0] = (qh[qh_walk] & 0x08u) != 0u ? -0.125f : 0.125f;
                delta[1] = (qh[qh_walk] & 0x80u) != 0u ? -0.125f : 0.125f;
                delta[2] = (qh[qh_walk + 1u] & 0x08u) != 0u ? -0.125f : 0.125f;
                delta[3] = (qh[qh_walk + 1u] & 0x80u) != 0u ? -0.125f : 0.125f;
                float dls[4] = { dl1, dl1, dl2, dl2 };
                for (uint l = 0u; l < 4u; ++l) {
                    uint grid_off = IQ_GRID_OFF_IQ1S + idx[l] * 8u;
                    for (uint j = 0u; j < 8u; ++j) {
                        int gv = lut_i8(iq_lut, grid_off + j);
                        dst[y + j] = dls[l] * (float(gv) + delta[l]);
                    }
                    y += 8u;
                }
                qs_walk += 4u; qh_walk += 2u;
            }
            return;
        }
        return;
    }

    // ── 32-elem block schemes: IQ4_NL, Q4_0, Q8_0, MXFP4 ──────────
    if (scheme_id == 19u) {
        // Q4_0: f16 d | 16 packed nibbles (18 bytes / 32 elements).
        uint off = gid * 18u;
        float d = dq_read_f16(w_base, off);
        device const uchar* qs = w_base + off + 2u;
        device float* dst = arena + dst_f32_off + gid * DQ_QK4_NL;
        for (uint j = 0u; j < DQ_QK4_NL / 2u; ++j) {
            uchar bx = qs[j];
            dst[j] = d * float(int(bx & 0x0Fu) - 8);
            dst[j + DQ_QK4_NL / 2u] = d * float(int(bx >> 4) - 8);
        }
        return;
    }

    if (scheme_id == 20u) {
        // Q8_0: f16 d | 32 i8 quants (34 bytes / 32 elements).
        uint off = gid * 34u;
        float d = dq_read_f16(w_base, off);
        device const uchar* qs = w_base + off + 2u;
        device float* dst = arena + dst_f32_off + gid * DQ_QK4_NL;
        for (uint j = 0u; j < DQ_QK4_NL; ++j) {
            dst[j] = d * float(int8_t(qs[j]));
        }
        return;
    }

    if (scheme_id == 24u) {
        // Q1_0 (prism-ml Bonsai-27B): f16 d | 16 sign-bit bytes
        // (18 bytes / 128 elements). Bit LSB-first; 1 -> +d, 0 -> -d.
        uint off = gid * 18u;
        float d = dq_read_f16(w_base, off);
        float neg_d = -d;
        device const uchar* qs = w_base + off + 2u;
        device float* dst = arena + dst_f32_off + gid * 128u;
        for (uint j = 0u; j < 128u; ++j) {
            uint bit = (uint(qs[j >> 3u]) >> (j & 7u)) & 1u;
            dst[j] = (bit != 0u) ? d : neg_d;
        }
        return;
    }

    if (scheme_id == 25u) {
        // Q2_0: f16 d | 32 two-bit bytes (34 bytes / 128 elements).
        uint off = gid * 34u;
        float d = dq_read_f16(w_base, off);
        device const uchar* qs = w_base + off + 2u;
        device float* dst = arena + dst_f32_off + gid * 128u;
        for (uint j = 0u; j < 128u; ++j) {
            uint q = (uint(qs[j >> 2u]) >> ((j & 3u) * 2u)) & 3u;
            dst[j] = float(int(q) - 1) * d;
        }
        return;
    }

    if (scheme_id == 21u) {
        // Q4_1: f16 d | f16 min | 16 packed nibbles (20 bytes / 32 elements).
        uint off = gid * 20u;
        float d = dq_read_f16(w_base, off);
        float m = dq_read_f16(w_base, off + 2u);
        device const uchar* qs = w_base + off + 4u;
        device float* dst = arena + dst_f32_off + gid * DQ_QK4_NL;
        for (uint j = 0u; j < DQ_QK4_NL / 2u; ++j) {
            uchar bx = qs[j];
            dst[j] = d * float(bx & 0x0Fu) + m;
            dst[j + DQ_QK4_NL / 2u] = d * float(bx >> 4) + m;
        }
        return;
    }

    if (scheme_id == 22u) {
        // Q5_0: f16 d | u32 qh | 16 packed nibbles (22 bytes / 32 elements).
        uint off = gid * 22u;
        float d = dq_read_f16(w_base, off);
        uint qh = uint(w_base[off + 2u]) | (uint(w_base[off + 3u]) << 8u)
            | (uint(w_base[off + 4u]) << 16u) | (uint(w_base[off + 5u]) << 24u);
        device const uchar* qs = w_base + off + 6u;
        device float* dst = arena + dst_f32_off + gid * DQ_QK4_NL;
        for (uint j = 0u; j < DQ_QK4_NL / 2u; ++j) {
            uchar bx = qs[j];
            uint xh0 = ((qh >> j) & 0x01u) << 4u;
            uint xh1 = ((qh >> (j + 16u)) & 0x01u) << 4u;
            dst[j] = d * float(int((bx & 0x0Fu) | xh0) - 16);
            dst[j + DQ_QK4_NL / 2u] = d * float(int((bx >> 4) | xh1) - 16);
        }
        return;
    }

    if (scheme_id == 23u) {
        // Q5_1: f16 d | f16 min | u32 qh | 16 packed nibbles (24 bytes / 32 elements).
        uint off = gid * 24u;
        float d = dq_read_f16(w_base, off);
        float m = dq_read_f16(w_base, off + 2u);
        uint qh = uint(w_base[off + 4u]) | (uint(w_base[off + 5u]) << 8u)
            | (uint(w_base[off + 6u]) << 16u) | (uint(w_base[off + 7u]) << 24u);
        device const uchar* qs = w_base + off + 8u;
        device float* dst = arena + dst_f32_off + gid * DQ_QK4_NL;
        for (uint j = 0u; j < DQ_QK4_NL / 2u; ++j) {
            uchar bx = qs[j];
            uint xh0 = ((qh >> j) & 0x01u) << 4u;
            uint xh1 = ((qh >> (j + 16u)) & 0x01u) << 4u;
            dst[j] = d * float((bx & 0x0Fu) | xh0) + m;
            dst[j + DQ_QK4_NL / 2u] = d * float((bx >> 4) | xh1) + m;
        }
        return;
    }

    if (scheme_id == 6u) {
        // IQ4_NL: 18 bytes / 32 elements.
        uint off = gid * 18u;
        float d = dq_read_f16(w_base, off);
        device const uchar* qs = w_base + off + 2u;
        device float* dst = arena + dst_f32_off + gid * DQ_QK4_NL;
        for (uint j = 0u; j < DQ_QK4_NL / 2u; ++j) {
            uchar bx = qs[j];
            dst[j] = d * float(kvalues_iq4nl_lut[bx & 0x0Fu]);
            dst[j + DQ_QK4_NL / 2u] = d * float(kvalues_iq4nl_lut[bx >> 4]);
        }
        return;
    }

    if (scheme_id == 10u) {
        // MXFP4: E8M0 scale + 16 nibbles = 17 bytes / 32 elements.
        // FP4 E2M1 LUT inline (saves a table lookup).
        const float FP4[16] = {
            0.0f, 0.5f, 1.0f, 1.5f, 2.0f, 3.0f, 4.0f, 6.0f,
            -0.0f, -0.5f, -1.0f, -1.5f, -2.0f, -3.0f, -4.0f, -6.0f
        };
        uint off = gid * 17u;
        uchar e = w_base[off];
        float s;
        if (e == 0xFFu) s = 0.0f;
        else s = exp2(float(int(uint(e)) - 127));
        device const uchar* qs = w_base + off + 1u;
        device float* dst = arena + dst_f32_off + gid * DQ_QK_MXFP4;
        for (uint j = 0u; j < DQ_QK_MXFP4 / 2u; ++j) {
            uchar bx = qs[j];
            dst[2u * j] = s * FP4[bx & 0x0Fu];
            dst[2u * j + 1u] = s * FP4[bx >> 4];
        }
        return;
    }

    // ── 16-elem block schemes: NVFP4 ──────────────────────────────
    if (scheme_id == 11u) {
        // NVFP4: E4M3 scale + 8 nibbles = 9 bytes / 16 elements.
        const float FP4[16] = {
            0.0f, 0.5f, 1.0f, 1.5f, 2.0f, 3.0f, 4.0f, 6.0f,
            -0.0f, -0.5f, -1.0f, -1.5f, -2.0f, -3.0f, -4.0f, -6.0f
        };
        uint off = gid * 9u;
        uchar e = w_base[off];
        // Inline E4M3 decode.
        float s;
        uint sign_b = (uint(e) >> 7) & 1u;
        uint exp_v = (uint(e) >> 3) & 0x0Fu;
        uint mant = uint(e) & 0x7u;
        if (exp_v == 0u) {
            s = (mant == 0u) ? 0.0f : (float(mant) / 8.0f) * exp2(-6.0f);
        } else if (exp_v == 0x0Fu && mant == 0x7u) {
            s = 0.0f;
        } else {
            s = (1.0f + float(mant) / 8.0f) * exp2(float(int(exp_v) - 7));
        }
        if (sign_b != 0u) s = -s;
        device const uchar* qs = w_base + off + 1u;
        device float* dst = arena + dst_f32_off + gid * DQ_QK_NVFP4;
        for (uint j = 0u; j < DQ_QK_NVFP4 / 2u; ++j) {
            uchar bx = qs[j];
            dst[2u * j] = s * FP4[bx & 0x0Fu];
            dst[2u * j + 1u] = s * FP4[bx >> 4];
        }
        return;
    }
}

// ── Fused Q4_0 / Q8_0 GEMV (m == 1, k % 32 == 0) ───────────────────────────

kernel void q4_0_mv_f32(
    device float* arena         [[buffer(0)]],
    constant ulong& x_off         [[buffer(1)]],
    constant ulong& w_off         [[buffer(2)]],
    constant ulong& dst_off       [[buffer(3)]],
    constant uint& k_dim          [[buffer(4)]],
    constant uint& n_dim          [[buffer(5)]],
    uint gid                     [[thread_position_in_grid]]
) {
    if (gid >= n_dim) return;
    const uint nblocks = k_dim / 32u;
    const uint BLK_BYTES = 18u;
    device const float* x   = (device const float*)((device char*)arena + x_off);
    device const uchar* w0  = (device const uchar*)arena + w_off + gid * nblocks * BLK_BYTES;
    device float*       dst = (device float*)((device char*)arena + dst_off);
    // GGML Q4_0 block layout (match `dequant_gguf` scheme 19 / quantize_q4_0):
    // qs[j] low nibble → elems 0..15, high nibble → elems 16..31.
    float acc = 0.0f;
    uint x_idx = 0u;
    for (uint b = 0u; b < nblocks; ++b) {
        uint off = b * BLK_BYTES;
        float d = dq_read_f16(w0, off);
        device const uchar* qs = w0 + off + 2u;
        for (uint j = 0u; j < 16u; ++j) {
            acc += x[x_idx++] * (d * float(int(qs[j] & 0x0Fu) - 8));
        }
        for (uint j = 0u; j < 16u; ++j) {
            acc += x[x_idx++] * (d * float(int(qs[j] >> 4) - 8));
        }
    }
    dst[gid] = acc;
}

kernel void q4_1_mv_f32(
    device float* arena         [[buffer(0)]],
    constant ulong& x_off         [[buffer(1)]],
    constant ulong& w_off         [[buffer(2)]],
    constant ulong& dst_off       [[buffer(3)]],
    constant uint& k_dim          [[buffer(4)]],
    constant uint& n_dim          [[buffer(5)]],
    uint gid                     [[thread_position_in_grid]]
) {
    if (gid >= n_dim) return;
    const uint nblocks = k_dim / 32u;
    const uint BLK_BYTES = 20u;
    device const float* x   = (device const float*)((device char*)arena + x_off);
    device const uchar* w0  = (device const uchar*)arena + w_off + gid * nblocks * BLK_BYTES;
    device float*       dst = (device float*)((device char*)arena + dst_off);
    float acc = 0.0f;
    uint x_idx = 0u;
    for (uint b = 0u; b < nblocks; ++b) {
        uint off = b * BLK_BYTES;
        float d = dq_read_f16(w0, off);
        float m = dq_read_f16(w0, off + 2u);
        device const uchar* qs = w0 + off + 4u;
        for (uint j = 0u; j < 16u; ++j) {
            acc += x[x_idx++] * (d * float(qs[j] & 0x0Fu) + m);
        }
        for (uint j = 0u; j < 16u; ++j) {
            acc += x[x_idx++] * (d * float(qs[j] >> 4) + m);
        }
    }
    dst[gid] = acc;
}

kernel void q8_0_mv_f32(
    device float* arena         [[buffer(0)]],
    constant ulong& x_off         [[buffer(1)]],
    constant ulong& w_off         [[buffer(2)]],
    constant ulong& dst_off       [[buffer(3)]],
    constant uint& k_dim          [[buffer(4)]],
    constant uint& n_dim          [[buffer(5)]],
    uint gid                     [[thread_position_in_grid]]
) {
    if (gid >= n_dim) return;
    const uint nblocks = k_dim / 32u;
    const uint BLK_BYTES = 34u;
    device const float* x   = (device const float*)((device char*)arena + x_off);
    device const uchar* w0  = (device const uchar*)arena + w_off + gid * nblocks * BLK_BYTES;
    device float*       dst = (device float*)((device char*)arena + dst_off);
    float4 acc4 = float4(0.0f);
    uint x_idx = 0u;
    for (uint b = 0u; b < nblocks; ++b) {
        uint off = b * BLK_BYTES;
        float d = dq_read_f16(w0, off);
        device const char* qs = (device const char*)(w0 + off + 2u);
        for (uint l = 0u; l < 32u; l += 4u) {
            float4 ww;
            ww.x = d * float(qs[l]);
            ww.y = d * float(qs[l + 1u]);
            ww.z = d * float(qs[l + 2u]);
            ww.w = d * float(qs[l + 3u]);
            float4 xv = *(device const float4*)(x + x_idx);
            acc4 += xv * ww;
            x_idx += 4u;
        }
    }
    dst[gid] = acc4.x + acc4.y + acc4.z + acc4.w;
}

// ── Fused Q1_0 GEMV (prism-ml Bonsai-27B): dst[n] = sum_k x[k]*dequant(w[n,k])
//
// Custom 1-bit format: 18-byte blocks of 128 weights (f16 scale `d` + 16 sign
// bytes, LSB-first, bit1→+d bit0→−d). Reads the packed weight row straight from
// the arena — NO f32 dequant scratch, so it can't race the shared scratch that
// the `dequant_gguf + encode_mps_sgemm_bt` path reuses across every DequantMatMul
// (that race zeroed large-n Q1_0 projections in the real 27B graph). Decode-only
// (m == 1); `k_dim % 128 == 0` guaranteed by the caller.
kernel void q1_0_mv_f32(
    device float* arena         [[buffer(0)]],
    constant ulong& x_off         [[buffer(1)]],
    constant ulong& w_off         [[buffer(2)]],
    constant ulong& dst_off       [[buffer(3)]],
    constant uint& k_dim          [[buffer(4)]],
    constant uint& n_dim          [[buffer(5)]],
    device const uchar* wbuf     [[buffer(7)]],
    uint gid                     [[thread_position_in_grid]]
) {
    if (gid >= n_dim) return;
    const uint nblocks = k_dim / 128u;
    const uint BLK_BYTES = 18u;
    // `wbuf` is the arena for inline weights or the external weight MTLBuffer
    // for large (>256 KB) params; `w_off` is the raw (untagged) offset into it.
    device const float* x   = (device const float*)((device char*)arena + x_off);
    device const uchar* w0  = wbuf + w_off + (ulong)gid * nblocks * BLK_BYTES;
    device float*       dst = (device float*)((device char*)arena + dst_off);
    float4 acc4 = float4(0.0f);
    uint x_idx = 0u;
    for (uint b = 0u; b < nblocks; ++b) {
        uint off = b * BLK_BYTES;
        float d  = dq_read_f16(w0, off);
        float nd = -d;
        device const uchar* qs = w0 + off + 2u;
        for (uint byte = 0u; byte < 16u; ++byte) {
            uint bits = uint(qs[byte]);
            float4 wlo, whi;
            wlo.x = (bits & 1u)   != 0u ? d : nd;
            wlo.y = (bits & 2u)   != 0u ? d : nd;
            wlo.z = (bits & 4u)   != 0u ? d : nd;
            wlo.w = (bits & 8u)   != 0u ? d : nd;
            whi.x = (bits & 16u)  != 0u ? d : nd;
            whi.y = (bits & 32u)  != 0u ? d : nd;
            whi.z = (bits & 64u)  != 0u ? d : nd;
            whi.w = (bits & 128u) != 0u ? d : nd;
            float4 xlo = *(device const float4*)(x + x_idx);
            float4 xhi = *(device const float4*)(x + x_idx + 4u);
            acc4 += xlo * wlo + xhi * whi;
            x_idx += 8u;
        }
    }
    dst[gid] = acc4.x + acc4.y + acc4.z + acc4.w;
}

// ── Simdgroup-cooperative Q1_0 GEMV (8 outputs per simdgroup) ───────────
//
// Same math as `q1_0_mv_f32` but 32 threads cooperate on 8 output columns
// with `simd_sum`, matching llama.cpp `kernel_mul_mv_q1_0_f32_impl`.
// Each thread owns a 16-float slice of every 4th block (`ix = tiisg/8`,
// `il = (tiisg%8)*16`) so x reads are shared across the simdgroup instead
// of every thread re-streaming the full k vector.
//
// Identity: Σ x[i]·(±d) = d · (2·Σ_{bit=1} x[i] − Σ x[i]).
// Constraint: `n_dim % 8 == 0` (else fall back to `q1_0_mv_f32`).
// Grid: one threadgroup per group-of-8 outputs × NSG=2 simdgroups.
// `flags` bit0: x is f16; bit1: dst is f16 (AMP residual stream).
constant uint Q1_NR0 = 8u;
constant uint Q1_BLK_BYTES = 18u;
constant uint Q1_QK = 128u;

kernel void q1_0_mv_f32_sg(
    device float* arena           [[buffer(0)]],
    constant ulong& x_off         [[buffer(1)]],
    constant ulong& w_off         [[buffer(2)]],
    constant ulong& dst_off       [[buffer(3)]],
    constant uint& k_dim          [[buffer(4)]],
    constant uint& n_dim          [[buffer(5)]],
    constant uint& flags          [[buffer(6)]], // bit0: x is f16
    device const uchar* wbuf      [[buffer(7)]],
    uint3 tgpig                   [[threadgroup_position_in_grid]],
    ushort tiisg                  [[thread_index_in_simdgroup]],
    ushort sgitg                  [[simdgroup_index_in_threadgroup]]
) {
    const short ix = (short)(tiisg / 8u);   // 0..3 — block stride
    const short il = (short)(tiisg % 8u) * 16; // 0,16,...,112 within block
    const uint nb = k_dim / Q1_QK;
    const bool x_f16 = (flags & 1u) != 0u;
    const bool dst_f16 = (flags & 2u) != 0u;

    const uint NSG = 2u;
    const uint first_row = (tgpig.x * NSG + sgitg) * Q1_NR0;
    if (first_row >= n_dim) return;

    device const float* x_base = (device const float*)((device char*)arena + x_off);
    device const half*  x_half = (device const half*)((device char*)arena + x_off);
    device float*       dst_f  = (device float*)((device char*)arena + dst_off);
    device half*        dst_h  = (device half*)((device char*)arena + dst_off);

    device const uchar* ax[Q1_NR0];
    #pragma unroll
    for (ushort row = 0; row < Q1_NR0; ++row) {
        ax[row] = wbuf + w_off + (ulong)(first_row + row) * (ulong)nb * Q1_BLK_BYTES;
    }

    float yl[16];
    float sumf[Q1_NR0] = {0.f};

    for (uint ib = ix; ib < nb; ib += 4u) {
        const uint x_base_i = ib * Q1_QK + (uint)il;
        float sumy = 0.f;
        #pragma unroll
        for (short i = 0; i < 16; ++i) {
            const uint xi = x_base_i + (uint)i;
            yl[i] = x_f16 ? float(x_half[xi]) : x_base[xi];
            sumy += yl[i];
        }

        #pragma unroll
        for (ushort row = 0; row < Q1_NR0; ++row) {
            device const uchar* blk = ax[row] + ib * Q1_BLK_BYTES;
            const float d = dq_read_f16(blk, 0u);
            device const uchar* qs = blk + 2u + (il / 8);
            const uint b0 = uint(qs[0]);
            const uint b1 = uint(qs[1]);
            float acc = 0.f;
            acc += select(0.f, yl[0],  (b0 & 1u)   != 0u);
            acc += select(0.f, yl[1],  (b0 & 2u)   != 0u);
            acc += select(0.f, yl[2],  (b0 & 4u)   != 0u);
            acc += select(0.f, yl[3],  (b0 & 8u)   != 0u);
            acc += select(0.f, yl[4],  (b0 & 16u)  != 0u);
            acc += select(0.f, yl[5],  (b0 & 32u)  != 0u);
            acc += select(0.f, yl[6],  (b0 & 64u)  != 0u);
            acc += select(0.f, yl[7],  (b0 & 128u) != 0u);
            acc += select(0.f, yl[8],  (b1 & 1u)   != 0u);
            acc += select(0.f, yl[9],  (b1 & 2u)   != 0u);
            acc += select(0.f, yl[10], (b1 & 4u)   != 0u);
            acc += select(0.f, yl[11], (b1 & 8u)   != 0u);
            acc += select(0.f, yl[12], (b1 & 16u)  != 0u);
            acc += select(0.f, yl[13], (b1 & 32u)  != 0u);
            acc += select(0.f, yl[14], (b1 & 64u)  != 0u);
            acc += select(0.f, yl[15], (b1 & 128u) != 0u);
            sumf[row] += d * (2.f * acc - sumy);
        }
    }

    for (ushort row = 0; row < Q1_NR0; ++row) {
        const uint row_idx = first_row + row;
        if (row_idx >= n_dim) break;
        const float total = simd_sum(sumf[row]);
        if (tiisg == 0u) {
            if (dst_f16) dst_h[row_idx] = half(total);
            else         dst_f[row_idx] = total;
        }
    }
}

// Shared-x dual Q1_0 GEMV: one yl[] stream feeds two weight matrices
// (e.g. attn_qkv + attn_gate). n0/n1 may differ; cover max(n0,n1) rows.
// dims.w bit0: x is f16.
kernel void q1_0_dual_mv_f32_sg(
    device float* arena            [[buffer(0)]],
    constant ulong& x_off          [[buffer(1)]],
    constant ulong& w0_off         [[buffer(2)]],
    constant ulong& w1_off         [[buffer(3)]],
    constant ulong& dst0_off       [[buffer(4)]],
    constant ulong& dst1_off       [[buffer(5)]],
    constant uint4& dims           [[buffer(6)]], // k, n0, n1, flags(bit0=x_f16)
    device const uchar* wbuf       [[buffer(7)]],
    uint3 tgpig                    [[threadgroup_position_in_grid]],
    ushort tiisg                   [[thread_index_in_simdgroup]],
    ushort sgitg                   [[simdgroup_index_in_threadgroup]]
) {
    const uint k_dim = dims.x;
    const uint n0 = dims.y;
    const uint n1 = dims.z;
    const bool x_f16 = (dims.w & 1u) != 0u;
    const bool dst_f16 = (dims.w & 2u) != 0u;
    const uint n_max = n0 > n1 ? n0 : n1;
    const short ix = (short)(tiisg / 8u);
    const short il = (short)(tiisg % 8u) * 16;
    const uint nb = k_dim / Q1_QK;
    const uint NSG = 2u;
    const uint first_row = (tgpig.x * NSG + sgitg) * Q1_NR0;
    if (first_row >= n_max) return;

    device const float* x_base = (device const float*)((device char*)arena + x_off);
    device const half*  x_half = (device const half*)((device char*)arena + x_off);
    device float* dst0_f = (device float*)((device char*)arena + dst0_off);
    device float* dst1_f = (device float*)((device char*)arena + dst1_off);
    device half*  dst0_h = (device half*)((device char*)arena + dst0_off);
    device half*  dst1_h = (device half*)((device char*)arena + dst1_off);

    device const uchar* a0[Q1_NR0];
    device const uchar* a1[Q1_NR0];
    #pragma unroll
    for (ushort row = 0; row < Q1_NR0; ++row) {
        const ulong row_base = (ulong)(first_row + row) * (ulong)nb * Q1_BLK_BYTES;
        a0[row] = wbuf + w0_off + row_base;
        a1[row] = wbuf + w1_off + row_base;
    }

    float yl[16];
    float sum0[Q1_NR0] = {0.f};
    float sum1[Q1_NR0] = {0.f};

    for (uint ib = ix; ib < nb; ib += 4u) {
        const uint x_base_i = ib * Q1_QK + (uint)il;
        float sumy = 0.f;
        #pragma unroll
        for (short i = 0; i < 16; ++i) {
            const uint xi = x_base_i + (uint)i;
            yl[i] = x_f16 ? float(x_half[xi]) : x_base[xi];
            sumy += yl[i];
        }
        #pragma unroll
        for (ushort row = 0; row < Q1_NR0; ++row) {
            const uint row_idx = first_row + row;
            device const uchar* b0 = a0[row] + ib * Q1_BLK_BYTES;
            device const uchar* b1 = a1[row] + ib * Q1_BLK_BYTES;
            if (row_idx < n0) {
                const float d = dq_read_f16(b0, 0u);
                device const uchar* qs = b0 + 2u + (il / 8);
                const uint q0 = uint(qs[0]), q1 = uint(qs[1]);
                float acc = 0.f;
                acc += select(0.f, yl[0],  (q0 & 1u)   != 0u);
                acc += select(0.f, yl[1],  (q0 & 2u)   != 0u);
                acc += select(0.f, yl[2],  (q0 & 4u)   != 0u);
                acc += select(0.f, yl[3],  (q0 & 8u)   != 0u);
                acc += select(0.f, yl[4],  (q0 & 16u)  != 0u);
                acc += select(0.f, yl[5],  (q0 & 32u)  != 0u);
                acc += select(0.f, yl[6],  (q0 & 64u)  != 0u);
                acc += select(0.f, yl[7],  (q0 & 128u) != 0u);
                acc += select(0.f, yl[8],  (q1 & 1u)   != 0u);
                acc += select(0.f, yl[9],  (q1 & 2u)   != 0u);
                acc += select(0.f, yl[10], (q1 & 4u)   != 0u);
                acc += select(0.f, yl[11], (q1 & 8u)   != 0u);
                acc += select(0.f, yl[12], (q1 & 16u)  != 0u);
                acc += select(0.f, yl[13], (q1 & 32u)  != 0u);
                acc += select(0.f, yl[14], (q1 & 64u)  != 0u);
                acc += select(0.f, yl[15], (q1 & 128u) != 0u);
                sum0[row] += d * (2.f * acc - sumy);
            }
            if (row_idx < n1) {
                const float d = dq_read_f16(b1, 0u);
                device const uchar* qs = b1 + 2u + (il / 8);
                const uint q0 = uint(qs[0]), q1 = uint(qs[1]);
                float acc = 0.f;
                acc += select(0.f, yl[0],  (q0 & 1u)   != 0u);
                acc += select(0.f, yl[1],  (q0 & 2u)   != 0u);
                acc += select(0.f, yl[2],  (q0 & 4u)   != 0u);
                acc += select(0.f, yl[3],  (q0 & 8u)   != 0u);
                acc += select(0.f, yl[4],  (q0 & 16u)  != 0u);
                acc += select(0.f, yl[5],  (q0 & 32u)  != 0u);
                acc += select(0.f, yl[6],  (q0 & 64u)  != 0u);
                acc += select(0.f, yl[7],  (q0 & 128u) != 0u);
                acc += select(0.f, yl[8],  (q1 & 1u)   != 0u);
                acc += select(0.f, yl[9],  (q1 & 2u)   != 0u);
                acc += select(0.f, yl[10], (q1 & 4u)   != 0u);
                acc += select(0.f, yl[11], (q1 & 8u)   != 0u);
                acc += select(0.f, yl[12], (q1 & 16u)  != 0u);
                acc += select(0.f, yl[13], (q1 & 32u)  != 0u);
                acc += select(0.f, yl[14], (q1 & 64u)  != 0u);
                acc += select(0.f, yl[15], (q1 & 128u) != 0u);
                sum1[row] += d * (2.f * acc - sumy);
            }
        }
    }

    for (ushort row = 0; row < Q1_NR0; ++row) {
        const uint row_idx = first_row + row;
        if (row_idx < n0) {
            const float total = simd_sum(sum0[row]);
            if (tiisg == 0u) {
                if (dst_f16) dst0_h[row_idx] = half(total);
                else         dst0_f[row_idx] = total;
            }
        }
        if (row_idx < n1) {
            const float total = simd_sum(sum1[row]);
            if (tiisg == 0u) {
                if (dst_f16) dst1_h[row_idx] = half(total);
                else         dst1_f[row_idx] = total;
            }
        }
    }
}

// ── Fused Q1_0 GEMM (m > 1, prefill): one thread per (col, row-tile) ─────
// Mirrors q4k_mm_f32 — TM=8 output rows per thread, reads packed 1-bit weight
// directly. Replaces the dequant-to-scratch + MPS sgemm path for Q1_0 (fixes
// the large-n zero-output race and skips the ~28× f32 blow-up). `k_dim % 128 == 0`.
constant uint Q1_MM_TM = 8u;

kernel void q1_0_mm_f32(
    device float* arena    [[buffer(0)]],
    constant ulong& x_off  [[buffer(1)]],
    constant ulong& w_off  [[buffer(2)]],
    constant ulong& dst_off[[buffer(3)]],
    constant uint& m_dim   [[buffer(4)]],
    constant uint& k_dim   [[buffer(5)]],
    constant uint& n_dim   [[buffer(6)]],
    device const uchar* wbuf [[buffer(7)]],
    uint2 gid [[thread_position_in_grid]]
) {
    const uint col  = gid.x;
    const uint row0 = gid.y * Q1_MM_TM;
    if (col >= n_dim || row0 >= m_dim) return;
    const uint nblocks   = k_dim / 128u;
    const uint BLK_BYTES = 18u;
    // `wbuf` = arena (inline) or external weight buffer; `w_off` raw offset.
    device const float* x   = (device const float*)((device char*)arena + x_off);
    device const uchar* w0  = wbuf + w_off
                            + (ulong)col * nblocks * BLK_BYTES;
    device float*       dst = (device float*)((device char*)arena + dst_off);
    float acc[Q1_MM_TM];
    for (uint r = 0u; r < Q1_MM_TM; ++r) acc[r] = 0.0f;
    uint p = 0u;
    for (uint b = 0u; b < nblocks; ++b) {
        uint off = b * BLK_BYTES;
        float d  = dq_read_f16(w0, off);
        float nd = -d;
        device const uchar* qs = w0 + off + 2u;
        for (uint byte = 0u; byte < 16u; ++byte) {
            uint bits = uint(qs[byte]);
            float ww[8];
            ww[0] = (bits & 1u)   != 0u ? d : nd;
            ww[1] = (bits & 2u)   != 0u ? d : nd;
            ww[2] = (bits & 4u)   != 0u ? d : nd;
            ww[3] = (bits & 8u)   != 0u ? d : nd;
            ww[4] = (bits & 16u)  != 0u ? d : nd;
            ww[5] = (bits & 32u)  != 0u ? d : nd;
            ww[6] = (bits & 64u)  != 0u ? d : nd;
            ww[7] = (bits & 128u) != 0u ? d : nd;
            for (uint r = 0u; r < Q1_MM_TM; ++r) {
                uint rr = row0 + r;
                uint rc = min(rr, m_dim - 1u);
                device const float* xr = x + (ulong)rc * k_dim + p;
                float s = xr[0]*ww[0] + xr[1]*ww[1] + xr[2]*ww[2] + xr[3]*ww[3]
                        + xr[4]*ww[4] + xr[5]*ww[5] + xr[6]*ww[6] + xr[7]*ww[7];
                if (rr < m_dim) acc[r] += s;
            }
            p += 8u;
        }
    }
    for (uint r = 0u; r < Q1_MM_TM; ++r) {
        uint rr = row0 + r;
        if (rr < m_dim)
            dst[(ulong)rr * n_dim + col] = acc[r];
    }
}

// ── Fused Q4_K_M GEMV: dst[n] = sum_k x[k] * dequant(w[n,k]) ─────────────
//
// Skips the f32 dequant scratch entirely — each thread streams one
// output column's worth of Q4K blocks through registers, multiplies by
// the corresponding slice of x, and accumulates to a single float.
//
// Weight layout: row-major `[n_dim, k_dim]` Q4K, i.e. row `n` starts at
// byte `w_off + n * (k_dim/256) * 144`. Activations `x[k_dim]` are f32
// at `x_off`. Output `dst[n_dim]` is f32 at `dst_off`.
//
// Grid: one thread per output column (`n_dim` threads total). `k_dim`
// must be a multiple of 256 — caller guarantees this for Q4K tensors.
kernel void q4k_mv_f32(
    device float* arena         [[buffer(0)]],
    constant ulong& x_off         [[buffer(1)]],
    constant ulong& w_off         [[buffer(2)]],
    constant ulong& dst_off       [[buffer(3)]],
    constant uint& k_dim          [[buffer(4)]],
    constant uint& n_dim          [[buffer(5)]],
    uint gid                     [[thread_position_in_grid]]
) {
    if (gid >= n_dim) return;

    const uint nblocks   = k_dim / DQ_QK_K;
    const uint BLK_BYTES = 2u + 2u + DQ_K_SCALE_SIZE + DQ_QK_K / 2u; // 144

    // u64 offsets — task #50: ≥4 GB models have activation/scratch byte
    // offsets that exceed u32.
    device const float* x   = (device const float*)((device char*)arena + x_off);
    device const uchar* w0  = (device const uchar*)arena + w_off + gid * nblocks * BLK_BYTES;
    device float*       dst = (device float*)((device char*)arena + dst_off);

    float4 acc4 = float4(0.0f);
    uint  x_idx = 0u;

    for (uint b = 0u; b < nblocks; ++b) {
        uint off = b * BLK_BYTES;
        float d    = dq_read_f16(w0, off);
        float dmin = dq_read_f16(w0, off + 2u);
        device const uchar* scales = w0 + off + 4u;
        device const uchar* qs     = w0 + off + 4u + DQ_K_SCALE_SIZE;
        uint is = 0u;
        for (uint j = 0u; j < 8u; j += 2u) {
            uint sc0, m0, sc1, m1;
            dq_get_scale_min_k4(scales, j,      sc0, m0);
            dq_get_scale_min_k4(scales, j + 1u, sc1, m1);
            float d0  = d * float(sc0);
            float m0f = dmin * float(m0);
            float d1  = d * float(sc1);
            float m1f = dmin * float(m1);
            // Low nibble half: 32 elements (8 float4 chunks of 4 consecutive
            // bytes; each byte's low nibble contributes one element). `qs`
            // starts 16 bytes into the 144-byte block so is u32-aligned, and
            // `is` increments in 32s — all `qs+is+l` are u32-aligned for
            // l%4==0. x is dispatched from a 64-byte-aligned arena offset
            // and x_idx steps by 4 → float4 reads are aligned.
            for (uint l = 0u; l < 32u; l += 4u) {
                uint q4 = *(device const uint*)(qs + is + l);
                float4 ww;
                ww.x = d0 * float(q4         & 0x0Fu) - m0f;
                ww.y = d0 * float((q4 >>  8) & 0x0Fu) - m0f;
                ww.z = d0 * float((q4 >> 16) & 0x0Fu) - m0f;
                ww.w = d0 * float((q4 >> 24) & 0x0Fu) - m0f;
                float4 xv = *(device const float4*)(x + x_idx);
                acc4 += xv * ww;
                x_idx += 4;
            }
            // High nibble half: same 32 bytes of `qs`, upper 4 bits each.
            for (uint l = 0u; l < 32u; l += 4u) {
                uint q4 = *(device const uint*)(qs + is + l);
                float4 ww;
                ww.x = d1 * float((q4 >>  4) & 0x0Fu) - m1f;
                ww.y = d1 * float((q4 >> 12) & 0x0Fu) - m1f;
                ww.z = d1 * float((q4 >> 20) & 0x0Fu) - m1f;
                ww.w = d1 * float((q4 >> 28) & 0x0Fu) - m1f;
                float4 xv = *(device const float4*)(x + x_idx);
                acc4 += xv * ww;
                x_idx += 4;
            }
            is += 32u;
        }
    }

    dst[gid] = acc4.x + acc4.y + acc4.z + acc4.w;
}

// ── Fused single-pass Q3_K GEMV (one output row per thread) ────────────
// Reads the PACKED Q3_K row (110 B / 256 elems) and dequantizes each block
// in-register while accumulating dot(w, x) — replaces the "dequant the whole
// weight to an f32 scratch, then MPS sgemm" path that made Q3_K_S decode
// ~60× slower than the memory-bandwidth ceiling. Math mirrors the scheme_id==5
// block dequant above (ggml `dequantize_row_q3_K`), so it is bit-identical.
// Decode-only (m==1), k % 256 == 0 (always true for GGUF Q3_K).
kernel void q3k_mv_f32(
    device float* arena         [[buffer(0)]],
    constant ulong& x_off         [[buffer(1)]],
    constant ulong& w_off         [[buffer(2)]],
    constant ulong& dst_off       [[buffer(3)]],
    constant uint& k_dim          [[buffer(4)]],
    constant uint& n_dim          [[buffer(5)]],
    uint gid                     [[thread_position_in_grid]]
) {
    if (gid >= n_dim) return;

    const uint nblocks   = k_dim / DQ_QK_K;
    // hmask[QK_K/8] | qs[QK_K/4] | scales[12] | d(f16) = 110
    const uint BLK_BYTES = DQ_QK_K / 8u + DQ_QK_K / 4u + DQ_K_SCALE_SIZE + 2u;
    const uint KMASK1 = 0x03030303u;
    const uint KMASK2 = 0x0f0f0f0fu;

    device const float* x   = (device const float*)((device char*)arena + x_off);
    device const uchar* w0  = (device const uchar*)arena + w_off + (ulong)gid * nblocks * BLK_BYTES;
    device float*       dst = (device float*)((device char*)arena + dst_off);

    float4 acc4 = float4(0.0f);
    uint  x_base = 0u;

    for (uint b = 0u; b < nblocks; ++b) {
        uint off        = b * BLK_BYTES;
        uint qs_off     = off + DQ_QK_K / 8u;        // +32
        uint scales_off = qs_off + DQ_QK_K / 4u;     // +96
        uint d_off      = scales_off + DQ_K_SCALE_SIZE; // +108
        float d_all = dq_read_f16(w0, d_off);
        device const uchar* hm = w0 + off;
        device const uchar* q  = w0 + qs_off;

        uint aux0 = uint(w0[scales_off + 0u]) | (uint(w0[scales_off + 1u]) << 8u)
                  | (uint(w0[scales_off + 2u]) << 16u) | (uint(w0[scales_off + 3u]) << 24u);
        uint aux1 = uint(w0[scales_off + 4u]) | (uint(w0[scales_off + 5u]) << 8u)
                  | (uint(w0[scales_off + 6u]) << 16u) | (uint(w0[scales_off + 7u]) << 24u);
        uint aux2 = uint(w0[scales_off + 8u]) | (uint(w0[scales_off + 9u]) << 8u)
                  | (uint(w0[scales_off + 10u]) << 16u) | (uint(w0[scales_off + 11u]) << 24u);
        uint tmp = aux2;
        aux2 = ((aux0 >> 4) & KMASK2) | (((tmp >> 4) & KMASK1) << 4);
        uint aux3 = ((aux1 >> 4) & KMASK2) | (((tmp >> 6) & KMASK1) << 4);
        aux0 = (aux0 & KMASK2) | (((tmp >> 0) & KMASK1) << 4);
        aux1 = (aux1 & KMASK2) | (((tmp >> 2) & KMASK1) << 4);
        thread char scales[16];
        *((thread uint*)&scales[0])  = aux0;
        *((thread uint*)&scales[4])  = aux1;
        *((thread uint*)&scales[8])  = aux2;
        *((thread uint*)&scales[12]) = aux3;

        uint is = 0u; uchar m = 1u; uint out_i = 0u;
        for (uint sb = 0u; sb < 2u; ++sb) {
            uint shift = 0u;
            for (uint t = 0u; t < 4u; ++t) {
                // Low 16 (q[0..16]) and high 16 (q[16..32]) of this 32-lane
                // sub-block, 4-wide. x rows are 16B-aligned (out_i steps by 4);
                // q/hm stay per-byte reads — the 110-byte block is not u32-aligned.
                float dl0 = d_all * float(int(scales[is]) - 32); is += 1u;
                for (uint l = 0u; l < 16u; l += 4u) {
                    float4 ww;
                    ww.x = dl0 * (float((q[l]      >> shift) & 3u) - ((hm[l]      & m) != 0u ? 0.0f : 4.0f));
                    ww.y = dl0 * (float((q[l + 1u] >> shift) & 3u) - ((hm[l + 1u] & m) != 0u ? 0.0f : 4.0f));
                    ww.z = dl0 * (float((q[l + 2u] >> shift) & 3u) - ((hm[l + 2u] & m) != 0u ? 0.0f : 4.0f));
                    ww.w = dl0 * (float((q[l + 3u] >> shift) & 3u) - ((hm[l + 3u] & m) != 0u ? 0.0f : 4.0f));
                    acc4 += ww * (*(device const float4*)(x + x_base + out_i)); out_i += 4u;
                }
                float dl1 = d_all * float(int(scales[is]) - 32); is += 1u;
                for (uint l = 0u; l < 16u; l += 4u) {
                    float4 ww;
                    ww.x = dl1 * (float((q[l + 16u] >> shift) & 3u) - ((hm[l + 16u] & m) != 0u ? 0.0f : 4.0f));
                    ww.y = dl1 * (float((q[l + 17u] >> shift) & 3u) - ((hm[l + 17u] & m) != 0u ? 0.0f : 4.0f));
                    ww.z = dl1 * (float((q[l + 18u] >> shift) & 3u) - ((hm[l + 18u] & m) != 0u ? 0.0f : 4.0f));
                    ww.w = dl1 * (float((q[l + 19u] >> shift) & 3u) - ((hm[l + 19u] & m) != 0u ? 0.0f : 4.0f));
                    acc4 += ww * (*(device const float4*)(x + x_base + out_i)); out_i += 4u;
                }
                shift += 2u; m <<= 1;
            }
            q += 32u;
        }
        x_base += DQ_QK_K;
    }

    dst[gid] = acc4.x + acc4.y + acc4.z + acc4.w;
}

// ── Fused single-pass Q6_K GEMV (one output row per thread) ────────────
// The Q6_K LM head (`output.weight`, 5120×248320) otherwise dequantized ~5 GB
// to an f32 scratch + MPS sgemm every decode step. Reads the packed row
// (210 B / 256 elems) and dequantizes in-register. Math mirrors scheme_id==2.
kernel void q6k_mv_f32(
    device float* arena         [[buffer(0)]],
    constant ulong& x_off         [[buffer(1)]],
    constant ulong& w_off         [[buffer(2)]],
    constant ulong& dst_off       [[buffer(3)]],
    constant uint& k_dim          [[buffer(4)]],
    constant uint& n_dim          [[buffer(5)]],
    uint gid                     [[thread_position_in_grid]]
) {
    if (gid >= n_dim) return;

    const uint nblocks = k_dim / DQ_QK_K;
    const uint ql_len = DQ_QK_K / 2u;  // 128
    const uint qh_len = DQ_QK_K / 4u;  // 64
    const uint sc_len = DQ_QK_K / 16u; // 16
    const uint BLK_BYTES = ql_len + qh_len + sc_len + 2u; // 210

    device const float* x   = (device const float*)((device char*)arena + x_off);
    device const uchar* w0  = (device const uchar*)arena + w_off + (ulong)gid * nblocks * BLK_BYTES;
    device float*       dst = (device float*)((device char*)arena + dst_off);

    float acc    = 0.0f;
    uint  x_base = 0u;

    for (uint b = 0u; b < nblocks; ++b) {
        uint off = b * BLK_BYTES;
        device const uchar* ql = w0 + off;
        device const uchar* qh = w0 + off + ql_len;
        device const uchar* sc = w0 + off + ql_len + qh_len;
        float d = dq_read_f16(w0, off + ql_len + qh_len + sc_len);
        for (uint hh = 0u; hh < 2u; ++hh) {
            uint dst_base = hh * 128u, ql_off = hh * 64u, qh_off_h = hh * 32u, sc_off = hh * 8u;
            for (uint l = 0u; l < 32u; ++l) {
                uint is = l / 16u;
                uchar qh_b = qh[qh_off_h + l];
                float q1 = float(int(((ql[ql_off + l]       & 0x0Fu) | (((qh_b >> 0) & 3u) << 4u)) - 32));
                float q2 = float(int(((ql[ql_off + l + 32u] & 0x0Fu) | (((qh_b >> 2) & 3u) << 4u)) - 32));
                float q3 = float(int(((ql[ql_off + l]       >> 4)    | (((qh_b >> 4) & 3u) << 4u)) - 32));
                float q4 = float(int(((ql[ql_off + l + 32u] >> 4)    | (((qh_b >> 6) & 3u) << 4u)) - 32));
                acc += (d * float(int8_t(sc[sc_off + is]))      * q1) * x[x_base + dst_base + l];
                acc += (d * float(int8_t(sc[sc_off + is + 2u])) * q2) * x[x_base + dst_base + l + 32u];
                acc += (d * float(int8_t(sc[sc_off + is + 4u])) * q3) * x[x_base + dst_base + l + 64u];
                acc += (d * float(int8_t(sc[sc_off + is + 6u])) * q4) * x[x_base + dst_base + l + 96u];
            }
        }
        x_base += DQ_QK_K;
    }

    dst[gid] = acc;
}

// ── Simdgroup-cooperative Q4_K_M GEMV (8 outputs per simdgroup) ─────────
//
// Same math as `q4k_mv_f32` but 32 threads cooperate on 8 output columns
// with `simd_sum` at the end. Each thread does 1/4 of the k blocks for
// all 8 outputs in parallel, sharing x reads through register/cluster
// cache instead of every thread re-reading the same x slice. Adapted
// from llama.cpp's `kernel_mul_mv_q4_K_f32_impl`.
//
// Constraint: `n_dim % 8 == 0` (else fall back to `q4k_mv_f32`).
//
// Grid: one threadgroup per group-of-8 outputs. Threadgroup size = 32
// (one simdgroup). `tgpig.x` = output-group index.
constant uint Q4K_NR0 = 8u;
constant uint Q4K_BLK_BYTES = 144u;
constant uint Q4K_KSCALE_OFF = 4u;
constant uint Q4K_QS_OFF     = 4u + 12u;

kernel void q4k_mv_f32_sg(
    device float* arena         [[buffer(0)]],
    constant ulong& x_off         [[buffer(1)]],
    constant ulong& w_off         [[buffer(2)]],
    constant ulong& dst_off       [[buffer(3)]],
    constant uint& k_dim          [[buffer(4)]],
    constant uint& n_dim          [[buffer(5)]],
    uint3 tgpig                  [[threadgroup_position_in_grid]],
    ushort tiisg                 [[thread_index_in_simdgroup]],
    ushort sgitg                 [[simdgroup_index_in_threadgroup]]
) {
    const ushort kmask1 = 0x3f3fu;
    const ushort kmask2 = 0x0f0fu;
    const ushort kmask3 = 0xc0c0u;

    const short ix = (short)(tiisg / 8u);  // 0..3 — block-stride
    const short it = (short)(tiisg % 8u);  // 0..7 — partition
    const short iq = it / 4;               // 0 or 1 — low/high half
    const short ir = it % 4;               // 0..3 — 8-elem chunk

    const uint nb = k_dim / DQ_QK_K;       // blocks per row

    // Each simdgroup within the threadgroup handles its own group of 8
    // outputs. NSG simdgroups per threadgroup → NSG*8 outputs per tg.
    const uint NSG = 4u;
    const uint first_row = (tgpig.x * NSG + sgitg) * Q4K_NR0;
    if (first_row >= n_dim) return;

    device const float* x_base = (device const float*)((device char*)arena + x_off);
    device float*       dst    = (device float*)((device char*)arena + dst_off);
    device const uchar* w_base = (device const uchar*)arena + w_off;

    float yl[16];
    float yh[16];
    float sumf[Q4K_NR0] = {0.f};

    // x slice for this thread: 16 floats from yl + 16 from yh covers
    // 32 of 256 elements per block, picked by (iq, ir).
    device const float* y4 = x_base + ix * DQ_QK_K + 64u * iq + 8u * ir;

    uint16_t sc16[4];
    thread const uint8_t* sc8 = (thread const uint8_t*)sc16;

    for (uint ib = ix; ib < nb; ib += 4u) {
        float4 sumy = float4(0.f);

        for (short i = 0; i < 8; ++i) {
            yl[i+0] = y4[i+  0]; sumy[0] += yl[i+0];
            yl[i+8] = y4[i+ 32]; sumy[1] += yl[i+8];
            yh[i+0] = y4[i+128]; sumy[2] += yh[i+0];
            yh[i+8] = y4[i+160]; sumy[3] += yh[i+8];
        }

        for (ushort row = 0; row < Q4K_NR0; ++row) {
            const uint row_idx = first_row + row;
            if (row_idx >= n_dim) break;

            // Block ib of row row_idx
            device const uchar* blk = w_base
                + (row_idx * nb + ib) * Q4K_BLK_BYTES;
            const float d    = dq_read_f16(blk, 0u);
            const float dmin = dq_read_f16(blk, 2u);

            device const uint16_t* sc = (device const uint16_t*)(blk + Q4K_KSCALE_OFF) + iq;
            sc16[0] = sc[0] & kmask1;
            sc16[1] = sc[2] & kmask1;
            sc16[2] = ((sc[4] >> 0) & kmask2) | ((sc[0] & kmask3) >> 2);
            sc16[3] = ((sc[4] >> 4) & kmask2) | ((sc[2] & kmask3) >> 2);

            device const uint16_t* q1 = (device const uint16_t*)(blk + Q4K_QS_OFF)
                                       + 16u * iq + 4u * ir;
            device const uint16_t* q2 = q1 + 32u;

            float4 acc1 = float4(0.f);
            float4 acc2 = float4(0.f);

            // Unrolled 4-iteration inner sum (matches llama's
            // `FOR_UNROLL` over `i=0..3`).
            #pragma unroll
            for (short i = 0; i < 4; ++i) {
                acc1[0] += yl[2*i + 0] * (q1[i] & 0x000Fu);
                acc1[1] += yl[2*i + 1] * (q1[i] & 0x0F00u);
                acc1[2] += yl[2*i + 8] * (q1[i] & 0x00F0u);
                acc1[3] += yl[2*i + 9] * (q1[i] & 0xF000u);
                acc2[0] += yh[2*i + 0] * (q2[i] & 0x000Fu);
                acc2[1] += yh[2*i + 1] * (q2[i] & 0x0F00u);
                acc2[2] += yh[2*i + 8] * (q2[i] & 0x00F0u);
                acc2[3] += yh[2*i + 9] * (q2[i] & 0xF000u);
            }

            sumf[row] += d * ((acc1[0] + acc1[1] * (1.f/256.f)) * sc8[0] +
                              (acc1[2] + acc1[3] * (1.f/256.f)) * sc8[1] * (1.f/16.f) +
                              (acc2[0] + acc2[1] * (1.f/256.f)) * sc8[4] +
                              (acc2[2] + acc2[3] * (1.f/256.f)) * sc8[5] * (1.f/16.f))
                       - dmin * (sumy[0] * sc8[2] + sumy[1] * sc8[3]
                               + sumy[2] * sc8[6] + sumy[3] * sc8[7]);
        }

        y4 += 4u * DQ_QK_K;
    }

    for (ushort row = 0; row < Q4K_NR0; ++row) {
        const uint row_idx = first_row + row;
        if (row_idx >= n_dim) break;
        const float total = simd_sum(sumf[row]);
        if (tiisg == 0u) {
            dst[row_idx] = total;
        }
    }
}

// ── Fused Q4_K / Q6_K GEMM (m > 1, prefill) ────────────────────────────────
//
// Computes C[m,n] = A[m,k] @ dequant(B)[n,k]^T directly from the packed GGUF
// weight — no f32 dequant scratch, no MPS sgemm. Mirrors the m==1 GEMV kernels
// (`q4k_mv_f32`) but accumulates a tile of up to TM rows per output column, so
// each weight super-block is dequantized once and reused across the tile.
//
// Grid: x = output column j (0..n), y = row-tile (0..ceil(m/TM)). Each thread
// owns one (column, row-tile). Loads of x are clamped to a valid row so the
// fixed-TM unroll keeps `acc[]` in registers (out-of-tile rows simply don't
// accumulate). Matches the CPU reference in rlx-cpu gguf_matmul (`gguf_matmul_bt`).

constant uint Q4K_MM_TM = 8u;

kernel void q4k_mm_f32(
    device float* arena    [[buffer(0)]],
    constant ulong& x_off  [[buffer(1)]],
    constant ulong& w_off  [[buffer(2)]],
    constant ulong& dst_off[[buffer(3)]],
    constant uint& m_dim   [[buffer(4)]],
    constant uint& k_dim   [[buffer(5)]],
    constant uint& n_dim   [[buffer(6)]],
    uint2 gid [[thread_position_in_grid]]
) {
    const uint col  = gid.x;
    const uint row0 = gid.y * Q4K_MM_TM;
    if (col >= n_dim || row0 >= m_dim) return;

    const uint nblocks   = k_dim / DQ_QK_K;
    const uint BLK_BYTES = 144u;        // 2+2+12+128
    device const float* x   = (device const float*)((device char*)arena + x_off);
    device const uchar* w0  = (device const uchar*)arena + w_off
                            + (ulong)col * nblocks * BLK_BYTES;
    device float*       dst = (device float*)((device char*)arena + dst_off);

    float4 acc[Q4K_MM_TM];
    for (uint r = 0u; r < Q4K_MM_TM; ++r) acc[r] = float4(0.0f);

    uint p = 0u;  // running k position within the row
    for (uint b = 0u; b < nblocks; ++b) {
        uint off = b * BLK_BYTES;
        float d    = dq_read_f16(w0, off);
        float dmin = dq_read_f16(w0, off + 2u);
        device const uchar* scales = w0 + off + 4u;
        device const uchar* qs     = w0 + off + 4u + DQ_K_SCALE_SIZE;
        uint is = 0u;
        for (uint j = 0u; j < 8u; j += 2u) {
            uint sc0, m0, sc1, m1;
            dq_get_scale_min_k4(scales, j,      sc0, m0);
            dq_get_scale_min_k4(scales, j + 1u, sc1, m1);
            float d0 = d * float(sc0), m0f = dmin * float(m0);
            float d1 = d * float(sc1), m1f = dmin * float(m1);
            // low-nibble half (32 elements, 8 float4 chunks)
            for (uint l = 0u; l < 32u; l += 4u) {
                uint q4 = *(device const uint*)(qs + is + l);
                float4 ww;
                ww.x = d0 * float(q4         & 0x0Fu) - m0f;
                ww.y = d0 * float((q4 >>  8) & 0x0Fu) - m0f;
                ww.z = d0 * float((q4 >> 16) & 0x0Fu) - m0f;
                ww.w = d0 * float((q4 >> 24) & 0x0Fu) - m0f;
                for (uint r = 0u; r < Q4K_MM_TM; ++r) {
                    uint rr = row0 + r;
                    uint rc = min(rr, m_dim - 1u);
                    float4 xv = *(device const float4*)(x + (ulong)rc * k_dim + p);
                    if (rr < m_dim) acc[r] += xv * ww;
                }
                p += 4u;
            }
            // high-nibble half
            for (uint l = 0u; l < 32u; l += 4u) {
                uint q4 = *(device const uint*)(qs + is + l);
                float4 ww;
                ww.x = d1 * float((q4 >>  4) & 0x0Fu) - m1f;
                ww.y = d1 * float((q4 >> 12) & 0x0Fu) - m1f;
                ww.z = d1 * float((q4 >> 20) & 0x0Fu) - m1f;
                ww.w = d1 * float((q4 >> 28) & 0x0Fu) - m1f;
                for (uint r = 0u; r < Q4K_MM_TM; ++r) {
                    uint rr = row0 + r;
                    uint rc = min(rr, m_dim - 1u);
                    float4 xv = *(device const float4*)(x + (ulong)rc * k_dim + p);
                    if (rr < m_dim) acc[r] += xv * ww;
                }
                p += 4u;
            }
            is += 32u;
        }
    }

    for (uint r = 0u; r < Q4K_MM_TM; ++r) {
        uint rr = row0 + r;
        if (rr < m_dim)
            dst[(ulong)rr * n_dim + col] = acc[r].x + acc[r].y + acc[r].z + acc[r].w;
    }
}

constant uint Q6K_MM_TM = 8u;

kernel void q6k_mm_f32(
    device float* arena    [[buffer(0)]],
    constant ulong& x_off  [[buffer(1)]],
    constant ulong& w_off  [[buffer(2)]],
    constant ulong& dst_off[[buffer(3)]],
    constant uint& m_dim   [[buffer(4)]],
    constant uint& k_dim   [[buffer(5)]],
    constant uint& n_dim   [[buffer(6)]],
    uint2 gid [[thread_position_in_grid]]
) {
    const uint col  = gid.x;
    const uint row0 = gid.y * Q6K_MM_TM;
    if (col >= n_dim || row0 >= m_dim) return;

    const uint nblocks = k_dim / DQ_QK_K;
    const uint BLK     = 210u;          // 128 ql + 64 qh + 16 sc + 2 d(f16)
    device const float* x   = (device const float*)((device char*)arena + x_off);
    device const uchar* w0  = (device const uchar*)arena + w_off
                            + (ulong)col * nblocks * BLK;
    device float*       dst = (device float*)((device char*)arena + dst_off);

    float acc[Q6K_MM_TM];
    for (uint r = 0u; r < Q6K_MM_TM; ++r) acc[r] = 0.0f;

    for (uint b = 0u; b < nblocks; ++b) {
        uint off = b * BLK;
        uint pbase = b * DQ_QK_K;
        device const uchar* ql = w0 + off;
        device const uchar* qh = w0 + off + 128u;
        device const uchar* sc = w0 + off + 192u;
        float d = dq_read_f16(w0, off + 208u);
        for (uint h = 0u; h < 2u; ++h) {
            uint dst_base = h * 128u, ql_off = h * 64u, qh_off_h = h * 32u, sc_off = h * 8u;
            for (uint l = 0u; l < 32u; ++l) {
                uint is = l / 16u;
                uchar qh_b = qh[qh_off_h + l];
                float q1 = float(int(((ql[ql_off + l] & 0x0Fu)        | (((qh_b >> 0) & 3u) << 4u))) - 32);
                float q2 = float(int(((ql[ql_off + l + 32u] & 0x0Fu)  | (((qh_b >> 2) & 3u) << 4u))) - 32);
                float q3 = float(int(((ql[ql_off + l] >> 4)           | (((qh_b >> 4) & 3u) << 4u))) - 32);
                float q4 = float(int(((ql[ql_off + l + 32u] >> 4)     | (((qh_b >> 6) & 3u) << 4u))) - 32);
                float w1 = d * float(int8_t(sc[sc_off + is]))       * q1;
                float w2 = d * float(int8_t(sc[sc_off + is + 2u]))  * q2;
                float w3 = d * float(int8_t(sc[sc_off + is + 4u]))  * q3;
                float w4 = d * float(int8_t(sc[sc_off + is + 6u]))  * q4;
                uint p1 = pbase + dst_base + l;
                uint p2 = p1 + 32u;
                uint p3 = p1 + 64u;
                uint p4 = p1 + 96u;
                for (uint r = 0u; r < Q6K_MM_TM; ++r) {
                    uint rr = row0 + r;
                    uint rc = min(rr, m_dim - 1u);
                    device const float* xr = x + (ulong)rc * k_dim;
                    float a = xr[p1] * w1 + xr[p2] * w2 + xr[p3] * w3 + xr[p4] * w4;
                    if (rr < m_dim) acc[r] += a;
                }
            }
        }
    }

    for (uint r = 0u; r < Q6K_MM_TM; ++r) {
        uint rr = row0 + r;
        if (rr < m_dim) dst[(ulong)rr * n_dim + col] = acc[r];
    }
}

// ── Fused IQ4_NL / IQ2_XXS GEMV (m == 1) ───────────────────────────────────

kernel void iq4_nl_mv_f32(
    device float* arena         [[buffer(0)]],
    constant ulong& x_off         [[buffer(1)]],
    constant ulong& w_off         [[buffer(2)]],
    constant ulong& dst_off       [[buffer(3)]],
    constant uint& k_dim          [[buffer(4)]],
    constant uint& n_dim          [[buffer(5)]],
    uint gid                     [[thread_position_in_grid]]
) {
    if (gid >= n_dim) return;
    const uint nblocks = k_dim / DQ_QK4_NL;
    const uint BLK_BYTES = 18u;
    device const float* x   = (device const float*)((device char*)arena + x_off);
    device const uchar* w0  = (device const uchar*)arena + w_off + gid * nblocks * BLK_BYTES;
    device float*       dst = (device float*)((device char*)arena + dst_off);
    float acc = 0.0f;
    uint x_idx = 0u;
    for (uint b = 0u; b < nblocks; ++b) {
        uint off = b * BLK_BYTES;
        float d = dq_read_f16(w0, off);
        device const uchar* qs = w0 + off + 2u;
        for (uint j = 0u; j < 16u; ++j) {
            uint nib = uint(qs[j]) & 0x0Fu;
            acc += x[x_idx++] * (d * float(kvalues_iq4nl_lut[nib]));
        }
        for (uint j = 0u; j < 16u; ++j) {
            uint nib = uint(qs[j]) >> 4;
            acc += x[x_idx++] * (d * float(kvalues_iq4nl_lut[nib]));
        }
    }
    dst[gid] = acc;
}

kernel void iq2_xxs_mv_f32(
    device float* arena         [[buffer(0)]],
    constant ulong& x_off         [[buffer(1)]],
    constant ulong& w_off         [[buffer(2)]],
    constant ulong& dst_off       [[buffer(3)]],
    constant uint& k_dim          [[buffer(4)]],
    constant uint& n_dim          [[buffer(5)]],
    device const uchar* iq_lut   [[buffer(6)]],
    uint gid                     [[thread_position_in_grid]]
) {
    if (gid >= n_dim) return;
    const uint nblocks = k_dim / DQ_QK_K;
    const uint BLK_BYTES = 66u;
    device const float* x   = (device const float*)((device char*)arena + x_off);
    device const uchar* w0  = (device const uchar*)arena + w_off + gid * nblocks * BLK_BYTES;
    device float*       dst = (device float*)((device char*)arena + dst_off);
    float acc = 0.0f;
    uint x_idx = 0u;
    for (uint b = 0u; b < nblocks; ++b) {
        uint off = b * BLK_BYTES;
        float d = dq_read_f16(w0, off);
        device const uchar* qs = w0 + off + 2u;
        for (uint ib32 = 0u; ib32 < 8u; ++ib32) {
            uint base = 8u * ib32;
            uint aux32_0 = uint(qs[base + 0u]) | (uint(qs[base + 1u]) << 8u)
                         | (uint(qs[base + 2u]) << 16u) | (uint(qs[base + 3u]) << 24u);
            uint aux32_1 = uint(qs[base + 4u]) | (uint(qs[base + 5u]) << 8u)
                         | (uint(qs[base + 6u]) << 16u) | (uint(qs[base + 7u]) << 24u);
            uchar a0 = uchar(aux32_0 & 0xFFu);
            uchar a1 = uchar((aux32_0 >> 8) & 0xFFu);
            uchar a2 = uchar((aux32_0 >> 16) & 0xFFu);
            uchar a3 = uchar((aux32_0 >> 24) & 0xFFu);
            float db = d * (0.5f + float(aux32_1 >> 28)) * 0.25f;
            uchar grid_bytes[4] = { a0, a1, a2, a3 };
            for (uint l = 0u; l < 4u; ++l) {
                uint grid_off = IQ_GRID_OFF_IQ2XXS + uint(grid_bytes[l]) * 8u;
                uchar signs = lut_u8(iq_lut, IQ_GRID_OFF_KSIGNS + ((aux32_1 >> (7u * l)) & 127u));
                for (uint j = 0u; j < 8u; ++j) {
                    int gv = lut_i8(iq_lut, grid_off + j);
                    uchar mask = lut_u8(iq_lut, IQ_GRID_OFF_KMASK + j);
                    float s = (signs & mask) != 0u ? -1.0f : 1.0f;
                    acc += x[x_idx] * (db * float(gv) * s);
                    x_idx += 1u;
                }
            }
        }
    }
    dst[gid] = acc;
}

// NOTE: the codebook weight-synthesis kernels — synth_matmul_codebook{,_h}
// (split-K, decode) and synth_matmul_codebook_mm{,_h} (one-per-output, prefill)
// — are generated from ONE template for both f32 and f16 by the
// `synth_matmul_kernels!` Rust macro in kernels.rs (so the dtype variants can't
// drift), and appended to the library by `msl_source()`.

// KAN Gaussian-RBF spline activation. One thread per output element
// `gid ∈ [0, total)` (total = rows·channels); channel `c = gid % channels`.
//   y[gid] = Σ_g coeff[c,g] · exp(-((x[gid] - center_g) · inv_h)²)
// with centers uniform on [grid_min, grid_max]. All operands are f32 arena
// tensors. Avoids materializing the [.., C, num_basis] basis intermediate.
kernel void spline_activation(
    device float* arena          [[buffer(0)]],
    constant ulong& x_off        [[buffer(1)]],
    constant ulong& coeff_off    [[buffer(2)]],
    constant ulong& dst_off      [[buffer(3)]],
    constant uint& total         [[buffer(4)]],
    constant uint& channels      [[buffer(5)]],
    constant uint& num_basis     [[buffer(6)]],
    constant float& grid_min     [[buffer(7)]],
    constant float& grid_max     [[buffer(8)]],
    uint gid                     [[thread_position_in_grid]]
) {
    if (gid >= total) return;
    uint c = gid % channels;
    device const float* x     = (device const float*)((device const char*)arena + x_off);
    device const float* coeff = (device const float*)((device const char*)arena + coeff_off)
                              + (ulong)c * num_basis;
    device float*       dst   = (device float*)((device char*)arena + dst_off);
    float step = (num_basis > 1u) ? (grid_max - grid_min) / (float(num_basis) - 1.0f) : 1.0f;
    float inv_h = 1.0f / step;
    float xv = x[gid];
    float acc = 0.0f;
    for (uint g = 0u; g < num_basis; ++g) {
        float center = grid_min + float(g) * step;
        float z = (xv - center) * inv_h;
        acc += coeff[g] * exp(-(z * z));
    }
    dst[gid] = acc;
}

// Fused KAN spline VJP → dx. Builds basis + derivative in registers (loop over
// num_basis), no materialized [.., C, G] tensor. dx = upstream·Σ_g coeff·B_g'.
kernel void spline_activation_backward_x(
    device float* arena          [[buffer(0)]],
    constant ulong& x_off        [[buffer(1)]],
    constant ulong& coeff_off    [[buffer(2)]],
    constant ulong& up_off       [[buffer(3)]],
    constant ulong& dx_off       [[buffer(4)]],
    constant uint& total         [[buffer(5)]],
    constant uint& channels      [[buffer(6)]],
    constant uint& num_basis     [[buffer(7)]],
    constant float& grid_min     [[buffer(8)]],
    constant float& grid_max     [[buffer(9)]],
    uint gid                     [[thread_position_in_grid]]
) {
    if (gid >= total) return;
    uint c = gid % channels;
    device const float* x     = (device const float*)((device const char*)arena + x_off);
    device const float* coeff = (device const float*)((device const char*)arena + coeff_off)
                              + (ulong)c * num_basis;
    device const float* up    = (device const float*)((device const char*)arena + up_off);
    device float*       dx    = (device float*)((device char*)arena + dx_off);
    float step = (num_basis > 1u) ? (grid_max - grid_min) / (float(num_basis) - 1.0f) : 1.0f;
    float inv_h = 1.0f / step;
    float xv = x[gid];
    float s = 0.0f;
    for (uint g = 0u; g < num_basis; ++g) {
        float center = grid_min + float(g) * step;
        float z = (xv - center) * inv_h;
        float B = exp(-(z * z));
        float Bp = B * (-2.0f * z * inv_h);   // d/dx exp(-z²)
        s += coeff[g] * Bp;
    }
    dx[gid] = up[gid] * s;
}

// Fused KAN spline VJP → dcoeff[C, num_basis] (atomic-accumulate; caller pre-zeros).
kernel void spline_activation_backward_coeff(
    device float* arena          [[buffer(0)]],
    constant ulong& x_off        [[buffer(1)]],
    constant ulong& up_off       [[buffer(2)]],
    constant ulong& dcoeff_off   [[buffer(3)]],
    constant uint& total         [[buffer(4)]],
    constant uint& channels      [[buffer(5)]],
    constant uint& num_basis     [[buffer(6)]],
    constant float& grid_min     [[buffer(7)]],
    constant float& grid_max     [[buffer(8)]],
    uint gid                     [[thread_position_in_grid]]
) {
    if (gid >= total) return;
    uint c = gid % channels;
    device const float* x  = (device const float*)((device const char*)arena + x_off);
    device const float* up = (device const float*)((device const char*)arena + up_off);
    device atomic_float* dcoeff = (device atomic_float*)((device char*)arena + dcoeff_off)
                                + (ulong)c * num_basis;
    float step = (num_basis > 1u) ? (grid_max - grid_min) / (float(num_basis) - 1.0f) : 1.0f;
    float inv_h = 1.0f / step;
    float xv = x[gid], u = up[gid];
    for (uint g = 0u; g < num_basis; ++g) {
        float center = grid_min + float(g) * step;
        float z = (xv - center) * inv_h;
        float B = exp(-(z * z));
        atomic_fetch_add_explicit(&dcoeff[g], u * B, memory_order_relaxed);
    }
}

kernel void iq2_xs_mv_f32(
    device float* arena         [[buffer(0)]],
    constant ulong& x_off         [[buffer(1)]],
    constant ulong& w_off         [[buffer(2)]],
    constant ulong& dst_off       [[buffer(3)]],
    constant uint& k_dim          [[buffer(4)]],
    constant uint& n_dim          [[buffer(5)]],
    device const uchar* iq_lut   [[buffer(6)]],
    uint gid                     [[thread_position_in_grid]]
) {
    if (gid >= n_dim) return;
    const uint nblocks = k_dim / DQ_QK_K;
    const uint BLK_BYTES = 74u;
    device const float* x   = (device const float*)((device char*)arena + x_off);
    device const uchar* w0  = (device const uchar*)arena + w_off + gid * nblocks * BLK_BYTES;
    device float*       dst = (device float*)((device char*)arena + dst_off);
    float acc = 0.0f;
    uint x_idx = 0u;
    for (uint b = 0u; b < nblocks; ++b) {
        uint off = b * BLK_BYTES;
        float d = dq_read_f16(w0, off);
        device const uchar* qs = w0 + off + 2u;
        device const uchar* scales = w0 + off + 2u + 64u;
        for (uint ib32 = 0u; ib32 < 8u; ++ib32) {
            float db0 = d * (0.5f + float(scales[ib32] & 0xFu)) * 0.25f;
            float db1 = d * (0.5f + float(scales[ib32] >> 4u)) * 0.25f;
            for (uint l = 0u; l < 4u; ++l) {
                uint pos = (4u * ib32 + l) * 2u;
                uint q = uint(qs[pos]) | (uint(qs[pos + 1u]) << 8u);
                uint grid_off = IQ_GRID_OFF_IQ2XS + (q & 511u) * 8u;
                uchar signs = lut_u8(iq_lut, IQ_GRID_OFF_KSIGNS + (q >> 9));
                float dl = (l / 2u == 0u) ? db0 : db1;
                for (uint j = 0u; j < 8u; ++j) {
                    int gv = lut_i8(iq_lut, grid_off + j);
                    uchar mask = lut_u8(iq_lut, IQ_GRID_OFF_KMASK + j);
                    float s = (signs & mask) != 0u ? -1.0f : 1.0f;
                    acc += x[x_idx] * (dl * float(gv) * s);
                    x_idx += 1u;
                }
            }
        }
    }
    dst[gid] = acc;
}

kernel void iq3_xxs_mv_f32(
    device float* arena         [[buffer(0)]],
    constant ulong& x_off         [[buffer(1)]],
    constant ulong& w_off         [[buffer(2)]],
    constant ulong& dst_off       [[buffer(3)]],
    constant uint& k_dim          [[buffer(4)]],
    constant uint& n_dim          [[buffer(5)]],
    device const uchar* iq_lut   [[buffer(6)]],
    uint gid                     [[thread_position_in_grid]]
) {
    if (gid >= n_dim) return;
    const uint nblocks = k_dim / DQ_QK_K;
    const uint BLK_BYTES = 98u;
    device const float* x   = (device const float*)((device char*)arena + x_off);
    device const uchar* w0  = (device const uchar*)arena + w_off + gid * nblocks * BLK_BYTES;
    device float*       dst = (device float*)((device char*)arena + dst_off);
    float acc = 0.0f;
    uint x_idx = 0u;
    for (uint b = 0u; b < nblocks; ++b) {
        uint off = b * BLK_BYTES;
        float d = dq_read_f16(w0, off);
        device const uchar* qs = w0 + off + 2u;
        device const uchar* sas = w0 + off + 2u + 64u;
        uint qs_idx = 0u;
        for (uint ib32 = 0u; ib32 < 8u; ++ib32) {
            uint aux32 = uint(sas[4u * ib32]) | (uint(sas[4u * ib32 + 1u]) << 8u)
                       | (uint(sas[4u * ib32 + 2u]) << 16u) | (uint(sas[4u * ib32 + 3u]) << 24u);
            float db = d * (0.5f + float(aux32 >> 28)) * 0.5f;
            for (uint l = 0u; l < 4u; ++l) {
                uchar signs = lut_u8(iq_lut, IQ_GRID_OFF_KSIGNS + ((aux32 >> (7u * l)) & 127u));
                uint g1_off = IQ_GRID_OFF_IQ3XXS + uint(qs[qs_idx + 2u * l]) * 4u;
                uint g2_off = IQ_GRID_OFF_IQ3XXS + uint(qs[qs_idx + 2u * l + 1u]) * 4u;
                for (uint j = 0u; j < 4u; ++j) {
                    int g1 = lut_i8(iq_lut, g1_off + j);
                    uchar m0 = lut_u8(iq_lut, IQ_GRID_OFF_KMASK + j);
                    float s0 = (signs & m0) != 0u ? -1.0f : 1.0f;
                    acc += x[x_idx] * (db * float(g1) * s0);
                    x_idx += 1u;
                }
                for (uint j = 0u; j < 4u; ++j) {
                    int g2 = lut_i8(iq_lut, g2_off + j);
                    uchar m1 = lut_u8(iq_lut, IQ_GRID_OFF_KMASK + j + 4u);
                    float s1 = (signs & m1) != 0u ? -1.0f : 1.0f;
                    acc += x[x_idx] * (db * float(g2) * s1);
                    x_idx += 1u;
                }
            }
            qs_idx += 8u;
        }
    }
    dst[gid] = acc;
}

kernel void iq2_s_mv_f32(
    device float* arena         [[buffer(0)]],
    constant ulong& x_off         [[buffer(1)]],
    constant ulong& w_off         [[buffer(2)]],
    constant ulong& dst_off       [[buffer(3)]],
    constant uint& k_dim          [[buffer(4)]],
    constant uint& n_dim          [[buffer(5)]],
    device const uchar* iq_lut   [[buffer(6)]],
    uint gid                     [[thread_position_in_grid]]
) {
    if (gid >= n_dim) return;
    const uint nblocks = k_dim / DQ_QK_K;
    const uint BLK_BYTES = 82u;
    device const float* x   = (device const float*)((device char*)arena + x_off);
    device const uchar* w0  = (device const uchar*)arena + w_off + gid * nblocks * BLK_BYTES;
    device float*       dst = (device float*)((device char*)arena + dst_off);
    float acc = 0.0f;
    uint x_idx = 0u;
    for (uint b = 0u; b < nblocks; ++b) {
        uint off = b * BLK_BYTES;
        float d = dq_read_f16(w0, off);
        device const uchar* qs = w0 + off + 2u;
        device const uchar* qh = w0 + off + 2u + 64u;
        device const uchar* scales = w0 + off + 2u + 64u + 8u;
        uint qs_idx = 0u, signs_idx = 32u;
        for (uint ib32 = 0u; ib32 < 8u; ++ib32) {
            float db0 = d * (0.5f + float(scales[ib32] & 0xFu)) * 0.25f;
            float db1 = d * (0.5f + float(scales[ib32] >> 4u)) * 0.25f;
            for (uint l = 0u; l < 4u; ++l) {
                float dl = (l / 2u == 0u) ? db0 : db1;
                uint q = uint(qs[qs_idx + l]);
                uint qh_b = uint(qh[ib32]);
                uint idx = q | ((qh_b << (8u - 2u * l)) & 0x300u);
                uint grid_off = IQ_GRID_OFF_IQ2S + idx * 8u;
                uchar sign = qs[signs_idx + l];
                for (uint j = 0u; j < 8u; ++j) {
                    int gv = lut_i8(iq_lut, grid_off + j);
                    uchar mask = lut_u8(iq_lut, IQ_GRID_OFF_KMASK + j);
                    float s = (sign & mask) != 0u ? -1.0f : 1.0f;
                    acc += x[x_idx] * (dl * float(gv) * s);
                    x_idx += 1u;
                }
            }
            qs_idx += 4u;
            signs_idx += 4u;
        }
    }
    dst[gid] = acc;
}

kernel void iq3_s_mv_f32(
    device float* arena         [[buffer(0)]],
    constant ulong& x_off         [[buffer(1)]],
    constant ulong& w_off         [[buffer(2)]],
    constant ulong& dst_off       [[buffer(3)]],
    constant uint& k_dim          [[buffer(4)]],
    constant uint& n_dim          [[buffer(5)]],
    device const uchar* iq_lut   [[buffer(6)]],
    uint gid                     [[thread_position_in_grid]]
) {
    if (gid >= n_dim) return;
    const uint nblocks = k_dim / DQ_QK_K;
    const uint BLK_BYTES = 110u;
    device const float* x   = (device const float*)((device char*)arena + x_off);
    device const uchar* w0  = (device const uchar*)arena + w_off + gid * nblocks * BLK_BYTES;
    device float*       dst = (device float*)((device char*)arena + dst_off);
    float acc = 0.0f;
    uint x_idx = 0u;
    for (uint b = 0u; b < nblocks; ++b) {
        uint off = b * BLK_BYTES;
        float d = dq_read_f16(w0, off);
        device const uchar* qs = w0 + off + 2u;
        device const uchar* qh = w0 + off + 2u + 64u;
        device const uchar* signs = w0 + off + 2u + 64u + 8u;
        device const uchar* scales = w0 + off + 2u + 64u + 8u + 32u;
        uint qs_walk = 0u, signs_walk = 0u, qh_walk = 0u;
        for (uint ib32 = 0u; ib32 < 8u; ib32 += 2u) {
            float db1 = d * (1.0f + 2.0f * float(scales[ib32 / 2u] & 0xFu));
            float db2 = d * (1.0f + 2.0f * float(scales[ib32 / 2u] >> 4u));
            for (uint half_iter = 0u; half_iter < 2u; ++half_iter) {
                float dl = (half_iter == 0u) ? db1 : db2;
                uint qh_byte = uint(qh[qh_walk + half_iter]);
                for (uint l = 0u; l < 4u; ++l) {
                    uint idx1 = uint(qs[qs_walk + 2u * l]) | (((qh_byte << (8u - 2u * l)) & 256u));
                    uint idx2 = uint(qs[qs_walk + 2u * l + 1u]) | (((qh_byte << (7u - 2u * l)) & 256u));
                    uint g1_off = IQ_GRID_OFF_IQ3S + idx1 * 4u;
                    uint g2_off = IQ_GRID_OFF_IQ3S + idx2 * 4u;
                    uchar sign = signs[signs_walk + l];
                    for (uint j = 0u; j < 4u; ++j) {
                        int g1 = lut_i8(iq_lut, g1_off + j);
                        uchar m0 = lut_u8(iq_lut, IQ_GRID_OFF_KMASK + j);
                        float s0 = (sign & m0) != 0u ? -1.0f : 1.0f;
                        acc += x[x_idx] * (dl * float(g1) * s0);
                        x_idx += 1u;
                    }
                    for (uint j = 0u; j < 4u; ++j) {
                        int g2 = lut_i8(iq_lut, g2_off + j);
                        uchar m1 = lut_u8(iq_lut, IQ_GRID_OFF_KMASK + j + 4u);
                        float s1 = (sign & m1) != 0u ? -1.0f : 1.0f;
                        acc += x[x_idx] * (dl * float(g2) * s1);
                        x_idx += 1u;
                    }
                }
                qs_walk += 8u;
                signs_walk += 4u;
            }
            qh_walk += 2u;
        }
    }
    dst[gid] = acc;
}

kernel void iq1_s_mv_f32(
    device float* arena         [[buffer(0)]],
    constant ulong& x_off         [[buffer(1)]],
    constant ulong& w_off         [[buffer(2)]],
    constant ulong& dst_off       [[buffer(3)]],
    constant uint& k_dim          [[buffer(4)]],
    constant uint& n_dim          [[buffer(5)]],
    device const uchar* iq_lut   [[buffer(6)]],
    uint gid                     [[thread_position_in_grid]]
) {
    if (gid >= n_dim) return;
    const uint nblocks = k_dim / DQ_QK_K;
    const uint BLK_BYTES = 50u;
    device const float* x   = (device const float*)((device char*)arena + x_off);
    device const uchar* w0  = (device const uchar*)arena + w_off + gid * nblocks * BLK_BYTES;
    device float*       dst = (device float*)((device char*)arena + dst_off);
    float acc = 0.0f;
    uint x_idx = 0u;
    for (uint b = 0u; b < nblocks; ++b) {
        uint off = b * BLK_BYTES;
        float d = dq_read_f16(w0, off);
        device const uchar* qs = w0 + off + 2u;
        device const uchar* qh_bytes = w0 + off + 2u + 32u;
        uint qs_idx = 0u;
        for (uint ib = 0u; ib < 8u; ++ib) {
            uint qh = uint(qh_bytes[2u * ib]) | (uint(qh_bytes[2u * ib + 1u]) << 8u);
            float dl = d * (2.0f * float((qh >> 12) & 7u) + 1.0f);
            float delta = (qh & 0x8000u) != 0u ? -0.125f : 0.125f;
            for (uint l = 0u; l < 4u; ++l) {
                uint idx = uint(qs[qs_idx + l]) | (((qh >> (3u * l)) & 7u) << 8u);
                uint grid_off = IQ_GRID_OFF_IQ1S + idx * 8u;
                for (uint j = 0u; j < 8u; ++j) {
                    int gv = lut_i8(iq_lut, grid_off + j);
                    acc += x[x_idx] * (dl * (float(gv) + delta));
                    x_idx += 1u;
                }
            }
            qs_idx += 4u;
        }
    }
    dst[gid] = acc;
}

kernel void iq1_m_mv_f32(
    device float* arena         [[buffer(0)]],
    constant ulong& x_off         [[buffer(1)]],
    constant ulong& w_off         [[buffer(2)]],
    constant ulong& dst_off       [[buffer(3)]],
    constant uint& k_dim          [[buffer(4)]],
    constant uint& n_dim          [[buffer(5)]],
    device const uchar* iq_lut   [[buffer(6)]],
    uint gid                     [[thread_position_in_grid]]
) {
    if (gid >= n_dim) return;
    const uint nblocks = k_dim / DQ_QK_K;
    const uint BLK_BYTES = 56u;
    device const float* x   = (device const float*)((device char*)arena + x_off);
    device const uchar* w0  = (device const uchar*)arena + w_off + gid * nblocks * BLK_BYTES;
    device float*       dst = (device float*)((device char*)arena + dst_off);
    float acc = 0.0f;
    uint x_idx = 0u;
    for (uint b = 0u; b < nblocks; ++b) {
        uint off = b * BLK_BYTES;
        device const uchar* qs = w0 + off;
        device const uchar* qh = w0 + off + 32u;
        device const uchar* scales_b = w0 + off + 48u;
        uint sc0 = lut_u16(scales_b, 0u);
        uint sc1 = lut_u16(scales_b, 2u);
        uint sc2 = lut_u16(scales_b, 4u);
        uint sc3 = lut_u16(scales_b, 6u);
        uint sc_u16 = (sc0 >> 12) | ((sc1 >> 8) & 0x00F0u)
                    | ((sc2 >> 4) & 0x0F00u) | (sc3 & 0xF000u);
        uint sign = (sc_u16 >> 15) & 1u;
        uint exp_v = (sc_u16 >> 10) & 0x1Fu;
        uint mant = sc_u16 & 0x3FFu;
        float d;
        if (exp_v == 0u) d = float(mant) / 1024.0f * exp2(-14.0f);
        else if (exp_v == 31u) d = (mant == 0u) ? INFINITY : 0.0f;
        else d = (1.0f + float(mant) / 1024.0f) * exp2(float(int(exp_v) - 15));
        if (sign != 0u) d = -d;
        uint sc_arr[4] = { sc0, sc1, sc2, sc3 };
        uint qs_walk = 0u, qh_walk = 0u;
        for (uint ib = 0u; ib < 8u; ++ib) {
            float dl1 = d * (2.0f * float((sc_arr[ib / 2u] >> (6u * (ib % 2u))) & 0x7u) + 1.0f);
            float dl2 = d * (2.0f * float((sc_arr[ib / 2u] >> (6u * (ib % 2u) + 3u)) & 0x7u) + 1.0f);
            uint idx[4];
            idx[0] = uint(qs[qs_walk]) | ((uint(qh[qh_walk]) << 8) & 0x700u);
            idx[1] = uint(qs[qs_walk + 1u]) | ((uint(qh[qh_walk]) << 4) & 0x700u);
            idx[2] = uint(qs[qs_walk + 2u]) | ((uint(qh[qh_walk + 1u]) << 8) & 0x700u);
            idx[3] = uint(qs[qs_walk + 3u]) | ((uint(qh[qh_walk + 1u]) << 4) & 0x700u);
            float delta[4];
            delta[0] = (qh[qh_walk] & 0x08u) != 0u ? -0.125f : 0.125f;
            delta[1] = (qh[qh_walk] & 0x80u) != 0u ? -0.125f : 0.125f;
            delta[2] = (qh[qh_walk + 1u] & 0x08u) != 0u ? -0.125f : 0.125f;
            delta[3] = (qh[qh_walk + 1u] & 0x80u) != 0u ? -0.125f : 0.125f;
            float dls[4] = { dl1, dl1, dl2, dl2 };
            for (uint l = 0u; l < 4u; ++l) {
                uint grid_off = IQ_GRID_OFF_IQ1S + idx[l] * 8u;
                for (uint j = 0u; j < 8u; ++j) {
                    int gv = lut_i8(iq_lut, grid_off + j);
                    acc += x[x_idx] * (dls[l] * (float(gv) + delta[l]));
                    x_idx += 1u;
                }
            }
            qs_walk += 4u;
            qh_walk += 2u;
        }
    }
    dst[gid] = acc;
}

// ── Fused decode-layer MLP kernels (m == 1) ────────────────────────────────
//
// These collapse the per-layer SwiGLU MLP op chain
//   rms_norm → gate(DequantMatMul) → up(DequantMatMul) → silu(gate) →
//   mul(silu,up) → down(DequantMatMul) → add(residual)
// into TWO dispatches instead of the unfused six. The GEMV math is a
// byte-for-byte copy of `q4k_mv_f32` / `q6k_mm_f32` (m==1 row), so with the
// simdgroup GEMV disabled the fused output is bit-identical to the unfused
// per-op path. Off-switch lives in the Rust scheduler (RLX_METAL_FUSE_DECODE).

// One Q4_K GEMV output column: `dst = sum_k x[k] * dequant(w_row[k])`.
// Identical accumulation order to `q4k_mv_f32` (float4 acc, low/high nibble).
inline float q4k_gemv_row_f32(device const float* x, device const uchar* w0, uint nblocks) {
    const uint BLK_BYTES = 144u;        // 2 d + 2 dmin + 12 scales + 128 qs
    float4 acc4 = float4(0.0f);
    uint  x_idx = 0u;
    for (uint b = 0u; b < nblocks; ++b) {
        uint off = b * BLK_BYTES;
        float d    = dq_read_f16(w0, off);
        float dmin = dq_read_f16(w0, off + 2u);
        device const uchar* scales = w0 + off + 4u;
        device const uchar* qs     = w0 + off + 4u + DQ_K_SCALE_SIZE;
        uint is = 0u;
        for (uint j = 0u; j < 8u; j += 2u) {
            uint sc0, m0, sc1, m1;
            dq_get_scale_min_k4(scales, j,      sc0, m0);
            dq_get_scale_min_k4(scales, j + 1u, sc1, m1);
            float d0  = d * float(sc0);
            float m0f = dmin * float(m0);
            float d1  = d * float(sc1);
            float m1f = dmin * float(m1);
            for (uint l = 0u; l < 32u; l += 4u) {
                uint q4 = *(device const uint*)(qs + is + l);
                float4 ww;
                ww.x = d0 * float(q4         & 0x0Fu) - m0f;
                ww.y = d0 * float((q4 >>  8) & 0x0Fu) - m0f;
                ww.z = d0 * float((q4 >> 16) & 0x0Fu) - m0f;
                ww.w = d0 * float((q4 >> 24) & 0x0Fu) - m0f;
                float4 xv = *(device const float4*)(x + x_idx);
                acc4 += xv * ww;
                x_idx += 4;
            }
            for (uint l = 0u; l < 32u; l += 4u) {
                uint q4 = *(device const uint*)(qs + is + l);
                float4 ww;
                ww.x = d1 * float((q4 >>  4) & 0x0Fu) - m1f;
                ww.y = d1 * float((q4 >> 12) & 0x0Fu) - m1f;
                ww.z = d1 * float((q4 >> 20) & 0x0Fu) - m1f;
                ww.w = d1 * float((q4 >> 28) & 0x0Fu) - m1f;
                float4 xv = *(device const float4*)(x + x_idx);
                acc4 += xv * ww;
                x_idx += 4;
            }
            is += 32u;
        }
    }
    return acc4.x + acc4.y + acc4.z + acc4.w;
}

// One Q6_K GEMV output column. Identical accumulation order to the m==1 row of
// `q6k_mm_f32` (the prefill GEMM already validated against the CPU reference).
inline float q6k_gemv_row_f32(device const float* x, device const uchar* w0, uint nblocks) {
    const uint BLK = 210u;              // 128 ql + 64 qh + 16 sc + 2 d(f16)
    float acc = 0.0f;
    for (uint b = 0u; b < nblocks; ++b) {
        uint off = b * BLK;
        uint pbase = b * DQ_QK_K;
        device const uchar* ql = w0 + off;
        device const uchar* qh = w0 + off + 128u;
        device const uchar* sc = w0 + off + 192u;
        float d = dq_read_f16(w0, off + 208u);
        for (uint h = 0u; h < 2u; ++h) {
            uint dst_base = h * 128u, ql_off = h * 64u, qh_off_h = h * 32u, sc_off = h * 8u;
            for (uint l = 0u; l < 32u; ++l) {
                uint is = l / 16u;
                uchar qh_b = qh[qh_off_h + l];
                float q1 = float(int(((ql[ql_off + l] & 0x0Fu)        | (((qh_b >> 0) & 3u) << 4u))) - 32);
                float q2 = float(int(((ql[ql_off + l + 32u] & 0x0Fu)  | (((qh_b >> 2) & 3u) << 4u))) - 32);
                float q3 = float(int(((ql[ql_off + l] >> 4)           | (((qh_b >> 4) & 3u) << 4u))) - 32);
                float q4 = float(int(((ql[ql_off + l + 32u] >> 4)     | (((qh_b >> 6) & 3u) << 4u))) - 32);
                float w1 = d * float(int8_t(sc[sc_off + is]))       * q1;
                float w2 = d * float(int8_t(sc[sc_off + is + 2u]))  * q2;
                float w3 = d * float(int8_t(sc[sc_off + is + 4u]))  * q3;
                float w4 = d * float(int8_t(sc[sc_off + is + 6u]))  * q4;
                uint p1 = pbase + dst_base + l;
                uint p2 = p1 + 32u;
                uint p3 = p1 + 64u;
                uint p4 = p1 + 96u;
                acc += x[p1] * w1 + x[p2] * w2 + x[p3] * w3 + x[p4] * w4;
            }
        }
    }
    return acc;
}

// One Q5_0 GEMV output column (32-elem blocks, 22 bytes/block).
inline float q5_0_gemv_row_f32(device const float* x, device const uchar* w0, uint nblocks) {
    const uint BLK = 22u;
    float acc = 0.0f;
    uint x_idx = 0u;
    for (uint b = 0u; b < nblocks; ++b) {
        uint off = b * BLK;
        float d = dq_read_f16(w0, off);
        uint qh = uint(w0[off + 2u]) | (uint(w0[off + 3u]) << 8u)
            | (uint(w0[off + 4u]) << 16u) | (uint(w0[off + 5u]) << 24u);
        device const uchar* qs = w0 + off + 6u;
        for (uint j = 0u; j < 16u; ++j) {
            uchar bx = qs[j];
            uint xh0 = ((qh >> j) & 0x01u) << 4u;
            uint xh1 = ((qh >> (j + 16u)) & 0x01u) << 4u;
            float w0v = d * float(int((bx & 0x0Fu) | xh0) - 16);
            float w1v = d * float(int((bx >> 4) | xh1) - 16);
            acc += x[x_idx] * w0v;
            acc += x[x_idx + 1u] * w1v;
            x_idx += 2u;
        }
    }
    return acc;
}

// Fused gate_proj + up_proj + silu + mul (Q4_K, m == 1).
//   dst[i] = up[i] * (gate[i] / (1 + exp(-gate[i])))
// One thread per intermediate column i; each thread runs two Q4_K GEMVs over
// the shared (rms-normed) input row. Replaces 4 unfused dispatches
// (gate matmul, up matmul, silu, elementwise mul) with one.
kernel void q4k_swiglu_mv_f32(
    device float* arena       [[buffer(0)]],
    constant ulong& x_off     [[buffer(1)]],
    constant ulong& gate_off  [[buffer(2)]],
    constant ulong& up_off    [[buffer(3)]],
    constant ulong& dst_off   [[buffer(4)]],
    constant uint& k_dim      [[buffer(5)]],
    constant uint& n_dim      [[buffer(6)]],
    uint gid                  [[thread_position_in_grid]]
) {
    if (gid >= n_dim) return;
    const uint nblocks = k_dim / DQ_QK_K;
    const uint BLK_BYTES = 144u;
    device const float* x  = (device const float*)((device char*)arena + x_off);
    device const uchar* wg = (device const uchar*)arena + gate_off + (ulong)gid * nblocks * BLK_BYTES;
    device const uchar* wu = (device const uchar*)arena + up_off   + (ulong)gid * nblocks * BLK_BYTES;
    device float* dst       = (device float*)((device char*)arena + dst_off);
    float gate = q4k_gemv_row_f32(x, wg, nblocks);
    float up   = q4k_gemv_row_f32(x, wu, nblocks);
    // Match `silu_inplace` (gate/(1+exp(-gate))) then commutative `* up`.
    dst[gid] = up * (gate / (1.0f + exp(-gate)));
}

// Fused gate+up Q4_K GEMV with GELU-approx epilogue (Gemma MLP).
//   dst[i] = up[i] * gelu_approx(gate[i])
kernel void q4k_gelu_mv_f32(
    device float* arena       [[buffer(0)]],
    constant ulong& x_off     [[buffer(1)]],
    constant ulong& gate_off  [[buffer(2)]],
    constant ulong& up_off    [[buffer(3)]],
    constant ulong& dst_off   [[buffer(4)]],
    constant uint& k_dim      [[buffer(5)]],
    constant uint& n_dim      [[buffer(6)]],
    uint gid                  [[thread_position_in_grid]]
) {
    if (gid >= n_dim) return;
    const uint nblocks = k_dim / DQ_QK_K;
    const uint BLK_BYTES = 144u;
    device const float* x  = (device const float*)((device char*)arena + x_off);
    device const uchar* wg = (device const uchar*)arena + gate_off + (ulong)gid * nblocks * BLK_BYTES;
    device const uchar* wu = (device const uchar*)arena + up_off   + (ulong)gid * nblocks * BLK_BYTES;
    device float* dst       = (device float*)((device char*)arena + dst_off);
    float gate = q4k_gemv_row_f32(x, wg, nblocks);
    float up   = q4k_gemv_row_f32(x, wu, nblocks);
    const float kAlpha = 0.044715f;
    const float kSqrt2OverPi = 0.7978845608f;
    float x3 = gate * gate * gate;
    float gelu = 0.5f * gate * (1.0f + tanh(kSqrt2OverPi * (gate + kAlpha * x3)));
    dst[gid] = up * gelu;
}

// Fused gate+up Q5_0 GEMV with SwiGLU epilogue (Gemma 270M gate_up at hidden=640).
kernel void q5_0_swiglu_mv_f32(
    device float* arena       [[buffer(0)]],
    constant ulong& x_off     [[buffer(1)]],
    constant ulong& gate_off  [[buffer(2)]],
    constant ulong& up_off    [[buffer(3)]],
    constant ulong& dst_off   [[buffer(4)]],
    constant uint& k_dim      [[buffer(5)]],
    constant uint& n_dim      [[buffer(6)]],
    uint gid                  [[thread_position_in_grid]]
) {
    if (gid >= n_dim) return;
    const uint nblocks = (k_dim + 31u) / 32u;
    const uint BLK_BYTES = 22u;
    device const float* x  = (device const float*)((device char*)arena + x_off);
    device const uchar* wg = (device const uchar*)arena + gate_off + (ulong)gid * nblocks * BLK_BYTES;
    device const uchar* wu = (device const uchar*)arena + up_off   + (ulong)gid * nblocks * BLK_BYTES;
    device float* dst       = (device float*)((device char*)arena + dst_off);
    float gate = q5_0_gemv_row_f32(x, wg, nblocks);
    float up   = q5_0_gemv_row_f32(x, wu, nblocks);
    dst[gid] = up * (gate / (1.0f + exp(-gate)));
}

// Fused gate+up Q5_0 GEMV with GELU-approx epilogue.
kernel void q5_0_gelu_mv_f32(
    device float* arena       [[buffer(0)]],
    constant ulong& x_off     [[buffer(1)]],
    constant ulong& gate_off  [[buffer(2)]],
    constant ulong& up_off    [[buffer(3)]],
    constant ulong& dst_off   [[buffer(4)]],
    constant uint& k_dim      [[buffer(5)]],
    constant uint& n_dim      [[buffer(6)]],
    uint gid                  [[thread_position_in_grid]]
) {
    if (gid >= n_dim) return;
    const uint nblocks = (k_dim + 31u) / 32u;
    const uint BLK_BYTES = 22u;
    device const float* x  = (device const float*)((device char*)arena + x_off);
    device const uchar* wg = (device const uchar*)arena + gate_off + (ulong)gid * nblocks * BLK_BYTES;
    device const uchar* wu = (device const uchar*)arena + up_off   + (ulong)gid * nblocks * BLK_BYTES;
    device float* dst       = (device float*)((device char*)arena + dst_off);
    float gate = q5_0_gemv_row_f32(x, wg, nblocks);
    float up   = q5_0_gemv_row_f32(x, wu, nblocks);
    const float kAlpha = 0.044715f;
    const float kSqrt2OverPi = 0.7978845608f;
    float x3 = gate * gate * gate;
    float gelu = 0.5f * gate * (1.0f + tanh(kSqrt2OverPi * (gate + kAlpha * x3)));
    dst[gid] = up * gelu;
}

// Fused down_proj + residual add (Q4_K, m == 1).
//   dst[j] = res[j] + sum_k h[k] * dequant(w[j,k])
// Replaces the down matmul + residual-add elementwise with one dispatch.
kernel void q4k_mv_residual_f32(
    device float* arena       [[buffer(0)]],
    constant ulong& x_off     [[buffer(1)]],
    constant ulong& w_off     [[buffer(2)]],
    constant ulong& dst_off   [[buffer(3)]],
    constant ulong& res_off   [[buffer(4)]],
    constant uint& k_dim      [[buffer(5)]],
    constant uint& n_dim      [[buffer(6)]],
    uint gid                  [[thread_position_in_grid]]
) {
    if (gid >= n_dim) return;
    const uint nblocks = k_dim / DQ_QK_K;
    const uint BLK_BYTES = 144u;
    device const float* x   = (device const float*)((device char*)arena + x_off);
    device const uchar* w0  = (device const uchar*)arena + w_off + (ulong)gid * nblocks * BLK_BYTES;
    device float* dst        = (device float*)((device char*)arena + dst_off);
    device const float* res = (device const float*)((device char*)arena + res_off);
    float acc = q4k_gemv_row_f32(x, w0, nblocks);
    // Match BinaryFull Add (lhs=residual, rhs=down): res + acc.
    dst[gid] = res[gid] + acc;
}

// Fused down_proj + residual add (Q6_K, m == 1).
kernel void q6k_mv_residual_f32(
    device float* arena       [[buffer(0)]],
    constant ulong& x_off     [[buffer(1)]],
    constant ulong& w_off     [[buffer(2)]],
    constant ulong& dst_off   [[buffer(3)]],
    constant ulong& res_off   [[buffer(4)]],
    constant uint& k_dim      [[buffer(5)]],
    constant uint& n_dim      [[buffer(6)]],
    uint gid                  [[thread_position_in_grid]]
) {
    if (gid >= n_dim) return;
    const uint nblocks = k_dim / DQ_QK_K;
    const uint BLK = 210u;
    device const float* x   = (device const float*)((device char*)arena + x_off);
    device const uchar* w0  = (device const uchar*)arena + w_off + (ulong)gid * nblocks * BLK;
    device float* dst        = (device float*)((device char*)arena + dst_off);
    device const float* res = (device const float*)((device char*)arena + res_off);
    float acc = q6k_gemv_row_f32(x, w0, nblocks);
    dst[gid] = res[gid] + acc;
}

// Fused down_proj + residual add (Q5_0, m == 1).
kernel void q5_0_mv_residual_f32(
    device float* arena       [[buffer(0)]],
    constant ulong& x_off     [[buffer(1)]],
    constant ulong& w_off     [[buffer(2)]],
    constant ulong& dst_off   [[buffer(3)]],
    constant ulong& res_off   [[buffer(4)]],
    constant uint& k_dim      [[buffer(5)]],
    constant uint& n_dim      [[buffer(6)]],
    uint gid                  [[thread_position_in_grid]]
) {
    if (gid >= n_dim) return;
    const uint nblocks = (k_dim + 31u) / 32u;
    const uint BLK_BYTES = 22u;
    device const float* x   = (device const float*)((device char*)arena + x_off);
    device const uchar* w0  = (device const uchar*)arena + w_off + (ulong)gid * nblocks * BLK_BYTES;
    device float* dst        = (device float*)((device char*)arena + dst_off);
    device const float* res = (device const float*)((device char*)arena + res_off);
    float acc = q5_0_gemv_row_f32(x, w0, nblocks);
    dst[gid] = res[gid] + acc;
}

// One Q1_0 GEMV output column (18-byte blocks of 128). Same math as `q1_0_mv_f32`.
inline float q1_0_gemv_row_f32(device const float* x, device const uchar* w0, uint nblocks) {
    const uint BLK_BYTES = 18u;
    float4 acc4 = float4(0.0f);
    uint x_idx = 0u;
    for (uint b = 0u; b < nblocks; ++b) {
        uint off = b * BLK_BYTES;
        float d  = dq_read_f16(w0, off);
        float nd = -d;
        device const uchar* qs = w0 + off + 2u;
        for (uint byte = 0u; byte < 16u; ++byte) {
            uint bits = uint(qs[byte]);
            float4 wlo, whi;
            wlo.x = (bits & 1u)   != 0u ? d : nd;
            wlo.y = (bits & 2u)   != 0u ? d : nd;
            wlo.z = (bits & 4u)   != 0u ? d : nd;
            wlo.w = (bits & 8u)   != 0u ? d : nd;
            whi.x = (bits & 16u)  != 0u ? d : nd;
            whi.y = (bits & 32u)  != 0u ? d : nd;
            whi.z = (bits & 64u)  != 0u ? d : nd;
            whi.w = (bits & 128u) != 0u ? d : nd;
            float4 xlo = *(device const float4*)(x + x_idx);
            float4 xhi = *(device const float4*)(x + x_idx + 4u);
            acc4 += xlo * wlo + xhi * whi;
            x_idx += 8u;
        }
    }
    return acc4.x + acc4.y + acc4.z + acc4.w;
}

// Fused gate+up Q1_0 GEMV with SwiGLU (Bonsai-27B decode). Weights may live in
// the external weight MTLBuffer (`wbuf`); `gate_off` / `up_off` are raw offsets.
kernel void q1_0_swiglu_mv_f32(
    device float* arena          [[buffer(0)]],
    constant ulong& x_off        [[buffer(1)]],
    constant ulong& gate_off     [[buffer(2)]],
    constant ulong& up_off       [[buffer(3)]],
    constant ulong& dst_off      [[buffer(4)]],
    constant uint& k_dim         [[buffer(5)]],
    constant uint& n_dim         [[buffer(6)]],
    device const uchar* wbuf     [[buffer(7)]],
    uint gid                     [[thread_position_in_grid]]
) {
    if (gid >= n_dim) return;
    const uint nblocks = k_dim / 128u;
    const uint BLK_BYTES = 18u;
    device const float* x  = (device const float*)((device char*)arena + x_off);
    device const uchar* wg = wbuf + gate_off + (ulong)gid * nblocks * BLK_BYTES;
    device const uchar* wu = wbuf + up_off   + (ulong)gid * nblocks * BLK_BYTES;
    device float* dst      = (device float*)((device char*)arena + dst_off);
    float gate = q1_0_gemv_row_f32(x, wg, nblocks);
    float up   = q1_0_gemv_row_f32(x, wu, nblocks);
    dst[gid] = up * (gate / (1.0f + exp(-gate)));
}

// Simdgroup-cooperative fused gate+up+SwiGLU (llama.cpp-style x reuse).
// Same grid as `q1_0_mv_f32_sg`: 8 outputs / simdgroup, NSG=2. Requires n%8==0.
// buffer(8) flags bit0: x is f16.
kernel void q1_0_swiglu_mv_f32_sg(
    device float* arena          [[buffer(0)]],
    constant ulong& x_off        [[buffer(1)]],
    constant ulong& gate_off     [[buffer(2)]],
    constant ulong& up_off       [[buffer(3)]],
    constant ulong& dst_off      [[buffer(4)]],
    constant uint& k_dim         [[buffer(5)]],
    constant uint& n_dim         [[buffer(6)]],
    device const uchar* wbuf     [[buffer(7)]],
    constant uint& flags         [[buffer(8)]], // bit0: x is f16
    uint3 tgpig                  [[threadgroup_position_in_grid]],
    ushort tiisg                 [[thread_index_in_simdgroup]],
    ushort sgitg                 [[simdgroup_index_in_threadgroup]]
) {
    const short ix = (short)(tiisg / 8u);
    const short il = (short)(tiisg % 8u) * 16;
    const uint nb = k_dim / Q1_QK;
    const bool x_f16 = (flags & 1u) != 0u;
    const bool dst_f16 = (flags & 2u) != 0u;
    const uint NSG = 2u;
    const uint first_row = (tgpig.x * NSG + sgitg) * Q1_NR0;
    if (first_row >= n_dim) return;

    device const float* x_base = (device const float*)((device char*)arena + x_off);
    device const half*  x_half = (device const half*)((device char*)arena + x_off);
    device float*       dst_f  = (device float*)((device char*)arena + dst_off);
    device half*        dst_h  = (device half*)((device char*)arena + dst_off);

    device const uchar* ag_row[Q1_NR0];
    device const uchar* au_row[Q1_NR0];
    #pragma unroll
    for (ushort row = 0; row < Q1_NR0; ++row) {
        const ulong row_base = (ulong)(first_row + row) * (ulong)nb * Q1_BLK_BYTES;
        ag_row[row] = wbuf + gate_off + row_base;
        au_row[row] = wbuf + up_off + row_base;
    }

    float yl[16];
    float sum_g[Q1_NR0] = {0.f};
    float sum_u[Q1_NR0] = {0.f};

    for (uint ib = ix; ib < nb; ib += 4u) {
        const uint x_base_i = ib * Q1_QK + (uint)il;
        float sumy = 0.f;
        #pragma unroll
        for (short i = 0; i < 16; ++i) {
            const uint xi = x_base_i + (uint)i;
            yl[i] = x_f16 ? float(x_half[xi]) : x_base[xi];
            sumy += yl[i];
        }
        #pragma unroll
        for (ushort row = 0; row < Q1_NR0; ++row) {
            device const uchar* bg = ag_row[row] + ib * Q1_BLK_BYTES;
            device const uchar* bu = au_row[row] + ib * Q1_BLK_BYTES;
            const float dg = dq_read_f16(bg, 0u);
            const float du = dq_read_f16(bu, 0u);
            device const uchar* qsg = bg + 2u + (il / 8);
            device const uchar* qsu = bu + 2u + (il / 8);
            const uint g0 = uint(qsg[0]), g1 = uint(qsg[1]);
            const uint u0 = uint(qsu[0]), u1 = uint(qsu[1]);
            float ag = 0.f, au = 0.f;
            #pragma unroll
            for (short i = 0; i < 8; ++i) {
                const float y = yl[i];
                ag += select(0.f, y, ((g0 >> i) & 1u) != 0u);
                au += select(0.f, y, ((u0 >> i) & 1u) != 0u);
            }
            #pragma unroll
            for (short i = 0; i < 8; ++i) {
                const float y = yl[i + 8];
                ag += select(0.f, y, ((g1 >> i) & 1u) != 0u);
                au += select(0.f, y, ((u1 >> i) & 1u) != 0u);
            }
            sum_g[row] += dg * (2.f * ag - sumy);
            sum_u[row] += du * (2.f * au - sumy);
        }
    }

    for (ushort row = 0; row < Q1_NR0; ++row) {
        const uint row_idx = first_row + row;
        if (row_idx >= n_dim) break;
        const float gate = simd_sum(sum_g[row]);
        const float up   = simd_sum(sum_u[row]);
        if (tiisg == 0u) {
            const float out = up * (gate / (1.0f + exp(-gate)));
            if (dst_f16) dst_h[row_idx] = half(out);
            else         dst_f[row_idx] = out;
        }
    }
}

// Fused down_proj + residual add (Q1_0, m == 1).
kernel void q1_0_mv_residual_f32(
    device float* arena          [[buffer(0)]],
    constant ulong& x_off        [[buffer(1)]],
    constant ulong& w_off        [[buffer(2)]],
    constant ulong& dst_off      [[buffer(3)]],
    constant ulong& res_off      [[buffer(4)]],
    constant uint& k_dim         [[buffer(5)]],
    constant uint& n_dim         [[buffer(6)]],
    device const uchar* wbuf     [[buffer(7)]],
    uint gid                     [[thread_position_in_grid]]
) {
    if (gid >= n_dim) return;
    const uint nblocks = k_dim / 128u;
    const uint BLK_BYTES = 18u;
    device const float* x   = (device const float*)((device char*)arena + x_off);
    device const uchar* w0  = wbuf + w_off + (ulong)gid * nblocks * BLK_BYTES;
    device float* dst       = (device float*)((device char*)arena + dst_off);
    device const float* res = (device const float*)((device char*)arena + res_off);
    float acc = q1_0_gemv_row_f32(x, w0, nblocks);
    dst[gid] = res[gid] + acc;
}

// Simdgroup-cooperative down + residual.
// buffer(8) flags bit0: x is f16.
kernel void q1_0_mv_residual_f32_sg(
    device float* arena          [[buffer(0)]],
    constant ulong& x_off        [[buffer(1)]],
    constant ulong& w_off        [[buffer(2)]],
    constant ulong& dst_off      [[buffer(3)]],
    constant ulong& res_off      [[buffer(4)]],
    constant uint& k_dim         [[buffer(5)]],
    constant uint& n_dim         [[buffer(6)]],
    device const uchar* wbuf     [[buffer(7)]],
    constant uint& flags         [[buffer(8)]], // bit0: x is f16
    uint3 tgpig                  [[threadgroup_position_in_grid]],
    ushort tiisg                 [[thread_index_in_simdgroup]],
    ushort sgitg                 [[simdgroup_index_in_threadgroup]]
) {
    const short ix = (short)(tiisg / 8u);
    const short il = (short)(tiisg % 8u) * 16;
    const uint nb = k_dim / Q1_QK;
    const bool x_f16 = (flags & 1u) != 0u;
    const bool dst_f16 = (flags & 2u) != 0u;
    const bool res_f16 = (flags & 4u) != 0u;
    const uint NSG = 2u;
    const uint first_row = (tgpig.x * NSG + sgitg) * Q1_NR0;
    if (first_row >= n_dim) return;

    device const float* x_base = (device const float*)((device char*)arena + x_off);
    device const half*  x_half = (device const half*)((device char*)arena + x_off);
    device float*       dst_f  = (device float*)((device char*)arena + dst_off);
    device half*        dst_h  = (device half*)((device char*)arena + dst_off);
    device const float* res_f  = (device const float*)((device char*)arena + res_off);
    device const half*  res_h  = (device const half*)((device char*)arena + res_off);

    device const uchar* ax[Q1_NR0];
    #pragma unroll
    for (ushort row = 0; row < Q1_NR0; ++row) {
        ax[row] = wbuf + w_off + (ulong)(first_row + row) * (ulong)nb * Q1_BLK_BYTES;
    }

    float yl[16];
    float sumf[Q1_NR0] = {0.f};

    for (uint ib = ix; ib < nb; ib += 4u) {
        const uint x_base_i = ib * Q1_QK + (uint)il;
        float sumy = 0.f;
        #pragma unroll
        for (short i = 0; i < 16; ++i) {
            const uint xi = x_base_i + (uint)i;
            yl[i] = x_f16 ? float(x_half[xi]) : x_base[xi];
            sumy += yl[i];
        }
        #pragma unroll
        for (ushort row = 0; row < Q1_NR0; ++row) {
            device const uchar* blk = ax[row] + ib * Q1_BLK_BYTES;
            const float d = dq_read_f16(blk, 0u);
            device const uchar* qs = blk + 2u + (il / 8);
            const uint b0 = uint(qs[0]);
            const uint b1 = uint(qs[1]);
            float acc = 0.f;
            acc += select(0.f, yl[0],  (b0 & 1u)   != 0u);
            acc += select(0.f, yl[1],  (b0 & 2u)   != 0u);
            acc += select(0.f, yl[2],  (b0 & 4u)   != 0u);
            acc += select(0.f, yl[3],  (b0 & 8u)   != 0u);
            acc += select(0.f, yl[4],  (b0 & 16u)  != 0u);
            acc += select(0.f, yl[5],  (b0 & 32u)  != 0u);
            acc += select(0.f, yl[6],  (b0 & 64u)  != 0u);
            acc += select(0.f, yl[7],  (b0 & 128u) != 0u);
            acc += select(0.f, yl[8],  (b1 & 1u)   != 0u);
            acc += select(0.f, yl[9],  (b1 & 2u)   != 0u);
            acc += select(0.f, yl[10], (b1 & 4u)   != 0u);
            acc += select(0.f, yl[11], (b1 & 8u)   != 0u);
            acc += select(0.f, yl[12], (b1 & 16u)  != 0u);
            acc += select(0.f, yl[13], (b1 & 32u)  != 0u);
            acc += select(0.f, yl[14], (b1 & 64u)  != 0u);
            acc += select(0.f, yl[15], (b1 & 128u) != 0u);
            sumf[row] += d * (2.f * acc - sumy);
        }
    }

    for (ushort row = 0; row < Q1_NR0; ++row) {
        const uint row_idx = first_row + row;
        if (row_idx >= n_dim) break;
        const float total = simd_sum(sumf[row]);
        if (tiisg == 0u) {
            const float rv = res_f16 ? float(res_h[row_idx]) : res_f[row_idx];
            const float out = rv + total;
            if (dst_f16) dst_h[row_idx] = half(out);
            else         dst_f[row_idx] = out;
        }
    }
}

// ── Fused Q2_0 kernels: 128 weights per 34-byte block ─────────────
constant uint Q2_NR0 = 8u;
constant uint Q2_BLK_BYTES = 34u;
constant uint Q2_QK = 128u;
constant uint Q2_MM_TM = 8u;

inline float q2_0_gemv_row_f32(device const float* x, device const uchar* w0, uint nblocks) {
    float acc = 0.0f;
    uint x_idx = 0u;
    for (uint b = 0u; b < nblocks; ++b) {
        device const uchar* blk = w0 + b * Q2_BLK_BYTES;
        const float d = dq_read_f16(blk, 0u);
        device const uchar* qs = blk + 2u;
        for (uint byte = 0u; byte < 32u; ++byte) {
            const uint bits = uint(qs[byte]);
            #pragma unroll
            for (uint i = 0u; i < 4u; ++i) {
                const uint q = (bits >> (2u * i)) & 3u;
                acc += x[x_idx++] * float(int(q) - 1) * d;
            }
        }
    }
    return acc;
}

kernel void q2_0_mv_f32(
    device float* arena           [[buffer(0)]],
    constant ulong& x_off         [[buffer(1)]],
    constant ulong& w_off         [[buffer(2)]],
    constant ulong& dst_off       [[buffer(3)]],
    constant uint& k_dim          [[buffer(4)]],
    constant uint& n_dim          [[buffer(5)]],
    device const uchar* wbuf      [[buffer(7)]],
    uint gid                      [[thread_position_in_grid]]
) {
    if (gid >= n_dim) return;
    const uint nb = k_dim / Q2_QK;
    device const float* x = (device const float*)((device char*)arena + x_off);
    device const uchar* w0 = wbuf + w_off + (ulong)gid * nb * Q2_BLK_BYTES;
    device float* dst = (device float*)((device char*)arena + dst_off);
    dst[gid] = q2_0_gemv_row_f32(x, w0, nb);
}

kernel void q2_0_mv_f32_sg(
    device float* arena           [[buffer(0)]],
    constant ulong& x_off         [[buffer(1)]],
    constant ulong& w_off         [[buffer(2)]],
    constant ulong& dst_off       [[buffer(3)]],
    constant uint& k_dim          [[buffer(4)]],
    constant uint& n_dim          [[buffer(5)]],
    constant uint& flags          [[buffer(6)]],
    device const uchar* wbuf      [[buffer(7)]],
    uint3 tgpig                   [[threadgroup_position_in_grid]],
    ushort tiisg                  [[thread_index_in_simdgroup]],
    ushort sgitg                  [[simdgroup_index_in_threadgroup]]
) {
    const short ix = (short)(tiisg / 8u);
    const short il = (short)(tiisg % 8u) * 16;
    const uint nb = k_dim / Q2_QK;
    const bool x_f16 = (flags & 1u) != 0u;
    const bool dst_f16 = (flags & 2u) != 0u;
    const uint first_row = (tgpig.x * 2u + sgitg) * Q2_NR0;
    if (first_row >= n_dim) return;

    device const float* x_base = (device const float*)((device char*)arena + x_off);
    device const half* x_half = (device const half*)((device char*)arena + x_off);
    device float* dst_f = (device float*)((device char*)arena + dst_off);
    device half* dst_h = (device half*)((device char*)arena + dst_off);
    device const uchar* rows[Q2_NR0];
    #pragma unroll
    for (ushort row = 0; row < Q2_NR0; ++row) {
        rows[row] = wbuf + w_off + (ulong)(first_row + row) * nb * Q2_BLK_BYTES;
    }

    float yl[16];
    float sums[Q2_NR0] = {0.f};
    for (uint ib = ix; ib < nb; ib += 4u) {
        const uint x_base_i = ib * Q2_QK + (uint)il;
        #pragma unroll
        for (short i = 0; i < 16; ++i) {
            const uint xi = x_base_i + (uint)i;
            yl[i] = x_f16 ? float(x_half[xi]) : x_base[xi];
        }
        #pragma unroll
        for (ushort row = 0; row < Q2_NR0; ++row) {
            device const uchar* blk = rows[row] + ib * Q2_BLK_BYTES;
            const float d = dq_read_f16(blk, 0u);
            device const uchar* qs = blk + 2u + (il / 4);
            float acc = 0.f;
            #pragma unroll
            for (short i = 0; i < 16; ++i) {
                const uint q = (uint(qs[i / 4]) >> (2u * uint(i & 3))) & 3u;
                acc += yl[i] * float(int(q) - 1);
            }
            sums[row] += d * acc;
        }
    }
    for (ushort row = 0; row < Q2_NR0; ++row) {
        const uint row_idx = first_row + row;
        if (row_idx >= n_dim) break;
        const float total = simd_sum(sums[row]);
        if (tiisg == 0u) {
            if (dst_f16) dst_h[row_idx] = half(total);
            else dst_f[row_idx] = total;
        }
    }
}

kernel void q2_0_dual_mv_f32_sg(
    device float* arena           [[buffer(0)]],
    constant ulong& x_off         [[buffer(1)]],
    constant ulong& w0_off        [[buffer(2)]],
    constant ulong& w1_off        [[buffer(3)]],
    constant ulong& dst0_off      [[buffer(4)]],
    constant ulong& dst1_off      [[buffer(5)]],
    constant uint4& dims          [[buffer(6)]],
    device const uchar* wbuf      [[buffer(7)]],
    uint3 tgpig                   [[threadgroup_position_in_grid]],
    ushort tiisg                  [[thread_index_in_simdgroup]],
    ushort sgitg                  [[simdgroup_index_in_threadgroup]]
) {
    const uint k_dim = dims.x, n0 = dims.y, n1 = dims.z;
    const bool x_f16 = (dims.w & 1u) != 0u;
    const bool dst_f16 = (dims.w & 2u) != 0u;
    const short ix = (short)(tiisg / 8u);
    const short il = (short)(tiisg % 8u) * 16;
    const uint nb = k_dim / Q2_QK;
    const uint first_row = (tgpig.x * 2u + sgitg) * Q2_NR0;
    if (first_row >= max(n0, n1)) return;

    device const float* x_base = (device const float*)((device char*)arena + x_off);
    device const half* x_half = (device const half*)((device char*)arena + x_off);
    device float* dst0_f = (device float*)((device char*)arena + dst0_off);
    device float* dst1_f = (device float*)((device char*)arena + dst1_off);
    device half* dst0_h = (device half*)((device char*)arena + dst0_off);
    device half* dst1_h = (device half*)((device char*)arena + dst1_off);
    device const uchar* rows0[Q2_NR0];
    device const uchar* rows1[Q2_NR0];
    #pragma unroll
    for (ushort row = 0; row < Q2_NR0; ++row) {
        const ulong row_base = (ulong)(first_row + row) * nb * Q2_BLK_BYTES;
        rows0[row] = wbuf + w0_off + row_base;
        rows1[row] = wbuf + w1_off + row_base;
    }

    float yl[16];
    float sums0[Q2_NR0] = {0.f};
    float sums1[Q2_NR0] = {0.f};
    for (uint ib = ix; ib < nb; ib += 4u) {
        const uint x_base_i = ib * Q2_QK + (uint)il;
        #pragma unroll
        for (short i = 0; i < 16; ++i) {
            const uint xi = x_base_i + (uint)i;
            yl[i] = x_f16 ? float(x_half[xi]) : x_base[xi];
        }
        #pragma unroll
        for (ushort row = 0; row < Q2_NR0; ++row) {
            const uint row_idx = first_row + row;
            device const uchar* b0 = rows0[row] + ib * Q2_BLK_BYTES;
            device const uchar* b1 = rows1[row] + ib * Q2_BLK_BYTES;
            float acc0 = 0.f, acc1 = 0.f;
            if (row_idx < n0) {
                device const uchar* qs = b0 + 2u + (il / 4);
                #pragma unroll
                for (short i = 0; i < 16; ++i) {
                    const uint q = (uint(qs[i / 4]) >> (2u * uint(i & 3))) & 3u;
                    acc0 += yl[i] * float(int(q) - 1);
                }
                sums0[row] += dq_read_f16(b0, 0u) * acc0;
            }
            if (row_idx < n1) {
                device const uchar* qs = b1 + 2u + (il / 4);
                #pragma unroll
                for (short i = 0; i < 16; ++i) {
                    const uint q = (uint(qs[i / 4]) >> (2u * uint(i & 3))) & 3u;
                    acc1 += yl[i] * float(int(q) - 1);
                }
                sums1[row] += dq_read_f16(b1, 0u) * acc1;
            }
        }
    }
    for (ushort row = 0; row < Q2_NR0; ++row) {
        const uint row_idx = first_row + row;
        if (row_idx < n0) {
            const float total = simd_sum(sums0[row]);
            if (tiisg == 0u) {
                if (dst_f16) dst0_h[row_idx] = half(total);
                else dst0_f[row_idx] = total;
            }
        }
        if (row_idx < n1) {
            const float total = simd_sum(sums1[row]);
            if (tiisg == 0u) {
                if (dst_f16) dst1_h[row_idx] = half(total);
                else dst1_f[row_idx] = total;
            }
        }
    }
}

kernel void q2_0_mm_f32(
    device float* arena           [[buffer(0)]],
    constant ulong& x_off         [[buffer(1)]],
    constant ulong& w_off         [[buffer(2)]],
    constant ulong& dst_off       [[buffer(3)]],
    constant uint& m_dim          [[buffer(4)]],
    constant uint& k_dim          [[buffer(5)]],
    constant uint& n_dim          [[buffer(6)]],
    device const uchar* wbuf      [[buffer(7)]],
    uint2 gid                     [[thread_position_in_grid]]
) {
    const uint col = gid.x;
    const uint row0 = gid.y * Q2_MM_TM;
    if (col >= n_dim || row0 >= m_dim) return;
    const uint nb = k_dim / Q2_QK;
    device const float* x = (device const float*)((device char*)arena + x_off);
    device const uchar* w0 = wbuf + w_off + (ulong)col * nb * Q2_BLK_BYTES;
    device float* dst = (device float*)((device char*)arena + dst_off);
    float sums[Q2_MM_TM] = {0.f};
    uint p = 0u;
    for (uint b = 0u; b < nb; ++b) {
        device const uchar* blk = w0 + b * Q2_BLK_BYTES;
        const float d = dq_read_f16(blk, 0u);
        device const uchar* qs = blk + 2u;
        for (uint byte = 0u; byte < 32u; ++byte) {
            const uint bits = uint(qs[byte]);
            float ww[4];
            #pragma unroll
            for (uint i = 0u; i < 4u; ++i) {
                ww[i] = float(int((bits >> (2u * i)) & 3u) - 1) * d;
            }
            for (uint r = 0u; r < Q2_MM_TM; ++r) {
                const uint rr = row0 + r;
                const uint rc = min(rr, m_dim - 1u);
                device const float* xr = x + (ulong)rc * k_dim + p;
                const float v = xr[0] * ww[0] + xr[1] * ww[1]
                              + xr[2] * ww[2] + xr[3] * ww[3];
                if (rr < m_dim) sums[r] += v;
            }
            p += 4u;
        }
    }
    for (uint r = 0u; r < Q2_MM_TM; ++r) {
        const uint rr = row0 + r;
        if (rr < m_dim) dst[(ulong)rr * n_dim + col] = sums[r];
    }
}

kernel void q2_0_swiglu_mv_f32(
    device float* arena           [[buffer(0)]],
    constant ulong& x_off         [[buffer(1)]],
    constant ulong& gate_off      [[buffer(2)]],
    constant ulong& up_off        [[buffer(3)]],
    constant ulong& dst_off       [[buffer(4)]],
    constant uint& k_dim          [[buffer(5)]],
    constant uint& n_dim          [[buffer(6)]],
    device const uchar* wbuf      [[buffer(7)]],
    uint gid                      [[thread_position_in_grid]]
) {
    if (gid >= n_dim) return;
    const uint nb = k_dim / Q2_QK;
    device const float* x = (device const float*)((device char*)arena + x_off);
    device const uchar* wg = wbuf + gate_off + (ulong)gid * nb * Q2_BLK_BYTES;
    device const uchar* wu = wbuf + up_off + (ulong)gid * nb * Q2_BLK_BYTES;
    device float* dst = (device float*)((device char*)arena + dst_off);
    const float gate = q2_0_gemv_row_f32(x, wg, nb);
    const float up = q2_0_gemv_row_f32(x, wu, nb);
    dst[gid] = up * (gate / (1.0f + exp(-gate)));
}

kernel void q2_0_swiglu_mv_f32_sg(
    device float* arena           [[buffer(0)]],
    constant ulong& x_off         [[buffer(1)]],
    constant ulong& gate_off      [[buffer(2)]],
    constant ulong& up_off        [[buffer(3)]],
    constant ulong& dst_off       [[buffer(4)]],
    constant uint& k_dim          [[buffer(5)]],
    constant uint& n_dim          [[buffer(6)]],
    device const uchar* wbuf      [[buffer(7)]],
    constant uint& flags          [[buffer(8)]],
    uint3 tgpig                   [[threadgroup_position_in_grid]],
    ushort tiisg                  [[thread_index_in_simdgroup]],
    ushort sgitg                  [[simdgroup_index_in_threadgroup]]
) {
    const short ix = (short)(tiisg / 8u);
    const short il = (short)(tiisg % 8u) * 16;
    const uint nb = k_dim / Q2_QK;
    const bool x_f16 = (flags & 1u) != 0u;
    const bool dst_f16 = (flags & 2u) != 0u;
    const uint first_row = (tgpig.x * 2u + sgitg) * Q2_NR0;
    if (first_row >= n_dim) return;
    device const float* x_base = (device const float*)((device char*)arena + x_off);
    device const half* x_half = (device const half*)((device char*)arena + x_off);
    device float* dst_f = (device float*)((device char*)arena + dst_off);
    device half* dst_h = (device half*)((device char*)arena + dst_off);
    device const uchar* gate_rows[Q2_NR0];
    device const uchar* up_rows[Q2_NR0];
    #pragma unroll
    for (ushort row = 0; row < Q2_NR0; ++row) {
        const ulong row_base = (ulong)(first_row + row) * nb * Q2_BLK_BYTES;
        gate_rows[row] = wbuf + gate_off + row_base;
        up_rows[row] = wbuf + up_off + row_base;
    }
    float yl[16];
    float gate_sums[Q2_NR0] = {0.f};
    float up_sums[Q2_NR0] = {0.f};
    for (uint ib = ix; ib < nb; ib += 4u) {
        const uint x_base_i = ib * Q2_QK + (uint)il;
        #pragma unroll
        for (short i = 0; i < 16; ++i) {
            const uint xi = x_base_i + (uint)i;
            yl[i] = x_f16 ? float(x_half[xi]) : x_base[xi];
        }
        #pragma unroll
        for (ushort row = 0; row < Q2_NR0; ++row) {
            device const uchar* bg = gate_rows[row] + ib * Q2_BLK_BYTES;
            device const uchar* bu = up_rows[row] + ib * Q2_BLK_BYTES;
            device const uchar* qg = bg + 2u + (il / 4);
            device const uchar* qu = bu + 2u + (il / 4);
            float ag = 0.f, au = 0.f;
            #pragma unroll
            for (short i = 0; i < 16; ++i) {
                const uint shift = 2u * uint(i & 3);
                ag += yl[i] * float(int((uint(qg[i / 4]) >> shift) & 3u) - 1);
                au += yl[i] * float(int((uint(qu[i / 4]) >> shift) & 3u) - 1);
            }
            gate_sums[row] += dq_read_f16(bg, 0u) * ag;
            up_sums[row] += dq_read_f16(bu, 0u) * au;
        }
    }
    for (ushort row = 0; row < Q2_NR0; ++row) {
        const uint row_idx = first_row + row;
        if (row_idx >= n_dim) break;
        const float gate = simd_sum(gate_sums[row]);
        const float up = simd_sum(up_sums[row]);
        if (tiisg == 0u) {
            const float out = up * (gate / (1.0f + exp(-gate)));
            if (dst_f16) dst_h[row_idx] = half(out);
            else dst_f[row_idx] = out;
        }
    }
}

kernel void q2_0_mv_residual_f32(
    device float* arena           [[buffer(0)]],
    constant ulong& x_off         [[buffer(1)]],
    constant ulong& w_off         [[buffer(2)]],
    constant ulong& dst_off       [[buffer(3)]],
    constant ulong& res_off       [[buffer(4)]],
    constant uint& k_dim          [[buffer(5)]],
    constant uint& n_dim          [[buffer(6)]],
    device const uchar* wbuf      [[buffer(7)]],
    uint gid                      [[thread_position_in_grid]]
) {
    if (gid >= n_dim) return;
    const uint nb = k_dim / Q2_QK;
    device const float* x = (device const float*)((device char*)arena + x_off);
    device const uchar* w0 = wbuf + w_off + (ulong)gid * nb * Q2_BLK_BYTES;
    device float* dst = (device float*)((device char*)arena + dst_off);
    device const float* res = (device const float*)((device char*)arena + res_off);
    dst[gid] = res[gid] + q2_0_gemv_row_f32(x, w0, nb);
}

kernel void q2_0_mv_residual_f32_sg(
    device float* arena           [[buffer(0)]],
    constant ulong& x_off         [[buffer(1)]],
    constant ulong& w_off         [[buffer(2)]],
    constant ulong& dst_off       [[buffer(3)]],
    constant ulong& res_off       [[buffer(4)]],
    constant uint& k_dim          [[buffer(5)]],
    constant uint& n_dim          [[buffer(6)]],
    device const uchar* wbuf      [[buffer(7)]],
    constant uint& flags          [[buffer(8)]],
    uint3 tgpig                   [[threadgroup_position_in_grid]],
    ushort tiisg                  [[thread_index_in_simdgroup]],
    ushort sgitg                  [[simdgroup_index_in_threadgroup]]
) {
    const short ix = (short)(tiisg / 8u);
    const short il = (short)(tiisg % 8u) * 16;
    const uint nb = k_dim / Q2_QK;
    const bool x_f16 = (flags & 1u) != 0u;
    const bool dst_f16 = (flags & 2u) != 0u;
    const bool res_f16 = (flags & 4u) != 0u;
    const uint first_row = (tgpig.x * 2u + sgitg) * Q2_NR0;
    if (first_row >= n_dim) return;
    device const float* x_base = (device const float*)((device char*)arena + x_off);
    device const half* x_half = (device const half*)((device char*)arena + x_off);
    device float* dst_f = (device float*)((device char*)arena + dst_off);
    device half* dst_h = (device half*)((device char*)arena + dst_off);
    device const float* res_f = (device const float*)((device char*)arena + res_off);
    device const half* res_h = (device const half*)((device char*)arena + res_off);
    device const uchar* rows[Q2_NR0];
    #pragma unroll
    for (ushort row = 0; row < Q2_NR0; ++row) {
        rows[row] = wbuf + w_off + (ulong)(first_row + row) * nb * Q2_BLK_BYTES;
    }
    float yl[16];
    float sums[Q2_NR0] = {0.f};
    for (uint ib = ix; ib < nb; ib += 4u) {
        const uint x_base_i = ib * Q2_QK + (uint)il;
        #pragma unroll
        for (short i = 0; i < 16; ++i) {
            const uint xi = x_base_i + (uint)i;
            yl[i] = x_f16 ? float(x_half[xi]) : x_base[xi];
        }
        #pragma unroll
        for (ushort row = 0; row < Q2_NR0; ++row) {
            device const uchar* blk = rows[row] + ib * Q2_BLK_BYTES;
            device const uchar* qs = blk + 2u + (il / 4);
            float acc = 0.f;
            #pragma unroll
            for (short i = 0; i < 16; ++i) {
                const uint q = (uint(qs[i / 4]) >> (2u * uint(i & 3))) & 3u;
                acc += yl[i] * float(int(q) - 1);
            }
            sums[row] += dq_read_f16(blk, 0u) * acc;
        }
    }
    for (ushort row = 0; row < Q2_NR0; ++row) {
        const uint row_idx = first_row + row;
        if (row_idx >= n_dim) break;
        const float total = simd_sum(sums[row]);
        if (tiisg == 0u) {
            const float rv = res_f16 ? float(res_h[row_idx]) : res_f[row_idx];
            const float out = rv + total;
            if (dst_f16) dst_h[row_idx] = half(out);
            else dst_f[row_idx] = out;
        }
    }
}
