#version 450
// Single-layer unidirectional GRU (gate order r, z, n; linear_before_reset;
// separate b_ih/b_hh; h0 = 0). One invocation per batch item; private hidden
// state (no shared-memory barriers — naga / NVIDIA portability). hidden ≤ 256;
// larger / multi-layer / bidir / carry take the host fallback.
layout(local_size_x = 64) in;

const uint MAX_H = 256u;

layout(push_constant) uniform PC {
    uint batch;
    uint seq;
    uint input_size;
    uint hidden;
    uint x_off;
    uint wih_off;
    uint whh_off;
    uint bih_off;
    uint bhh_off;
    uint out_off;
    uint seq_stride;
} pc;

void main() {
    uint bi = gl_GlobalInvocationID.x;
    if (bi >= pc.batch || pc.hidden > MAX_H) { return; }
    uint h = pc.hidden;
    uint in_sz = pc.input_size;

    float hs[MAX_H];
    for (uint k = 0u; k < h; k++) { hs[k] = 0.0; }

    for (uint t = 0u; t < pc.seq; t++) {
        uint x_base = pc.x_off + (bi * pc.seq_stride + t) * in_sz;
        float next_h[MAX_H];
        for (uint k = 0u; k < h; k++) {
            float xi[3];
            float hipart[3];
            for (uint g = 0u; g < 3u; g++) {
                uint r = g * h + k;
                float ax = arena_load(pc.bih_off + r);
                uint wih_row = pc.wih_off + r * in_sz;
                for (uint j = 0u; j < in_sz; j++) {
                    ax += arena_load(wih_row + j) * arena_load(x_base + j);
                }
                float ah = arena_load(pc.bhh_off + r);
                uint whh_row = pc.whh_off + r * h;
                for (uint j = 0u; j < h; j++) {
                    ah += arena_load(whh_row + j) * hs[j];
                }
                xi[g] = ax;
                hipart[g] = ah;
            }
            float rg = 1.0 / (1.0 + exp(-(xi[0] + hipart[0])));
            float zg = 1.0 / (1.0 + exp(-(xi[1] + hipart[1])));
            float ng = tanh(xi[2] + rg * hipart[2]);
            next_h[k] = (1.0 - zg) * ng + zg * hs[k];
        }
        for (uint k = 0u; k < h; k++) {
            hs[k] = next_h[k];
            arena_store(pc.out_off + (bi * pc.seq_stride + t) * h + k, hs[k]);
        }
    }
}
