#version 450
// Fused SwiGLU: y = up * silu(gate) with concatenated [..., 2*n_half] input.
// gate_first=1 ⇒ first half is gate, second is up; else up then gate.
// Matches CUDA `fused_swiglu.cu` / Metal `fused_swiglu`.
layout(local_size_x = 256) in;

layout(push_constant) uniform PC {
    uint n_half;
    uint total;
    uint gate_first;
    uint in_off;
    uint out_off;
} pc;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.total) { return; }
    uint row = i / pc.n_half;
    uint col = i % pc.n_half;
    uint base = row * (2u * pc.n_half);
    float up;
    float gate;
    if (pc.gate_first != 0u) {
        gate = arena_load(pc.in_off + base + col);
        up = arena_load(pc.in_off + base + pc.n_half + col);
    } else {
        up = arena_load(pc.in_off + base + col);
        gate = arena_load(pc.in_off + base + pc.n_half + col);
    }
    arena_store(pc.out_off + i, up * (gate / (1.0 + exp(-gate))));
}
