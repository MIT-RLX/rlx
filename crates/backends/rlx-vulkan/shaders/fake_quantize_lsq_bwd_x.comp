#version 450
// FakeQuantizeLSQ ∂L/∂x: STE-clipped — dx = dy when |x/s| ≤ q_max, else 0.
layout(local_size_x = 256) in;

layout(push_constant) uniform PC {
    uint n;
    uint chan_dim;
    uint inner;
    float q_max;
    uint x_off;
    uint scale_off;
    uint dy_off;
    uint dx_off;
} pc;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.n) { return; }
    uint c = (pc.chan_dim <= 1u) ? 0u : ((i / pc.inner) % pc.chan_dim);
    float s = max(arena_load(pc.scale_off + c), 1e-12);
    float z = arena_load(pc.x_off + i) / s;
    arena_store(pc.dx_off + i, (abs(z) <= pc.q_max) ? arena_load(pc.dy_off + i) : 0.0);
}
