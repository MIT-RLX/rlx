#version 450
// Fused (residual add + optional bias) + RMSNorm over the last axis.
// One invocation per outer row. Matches WGSL / CUDA fused_residual_rms_norm.
layout(local_size_x = 64) in;

layout(push_constant) uniform PC {
    uint outer;
    uint inner;
    uint in_off;
    uint residual_off;
    uint bias_off;
    uint gamma_off;
    uint beta_off;
    uint out_off;
    uint has_bias;
    float eps;
} pc;

void main() {
    uint row = gl_GlobalInvocationID.x;
    if (row >= pc.outer || pc.inner == 0u) { return; }
    uint in_base = pc.in_off + row * pc.inner;
    uint res_base = pc.residual_off + row * pc.inner;
    uint out_base = pc.out_off + row * pc.inner;
    float n_inv = 1.0 / float(pc.inner);

    float sum_x2 = 0.0;
    for (uint i = 0u; i < pc.inner; i++) {
        float v = arena_load(in_base + i) + arena_load(res_base + i);
        if (pc.has_bias != 0u) { v += arena_load(pc.bias_off + i); }
        arena_store(out_base + i, v);
        sum_x2 += v * v;
    }
    float inv_rms = inversesqrt(sum_x2 * n_inv + pc.eps);

    for (uint i = 0u; i < pc.inner; i++) {
        float g = arena_load(pc.gamma_off + i);
        float b = arena_load(pc.beta_off + i);
        arena_store(out_base + i, arena_load(out_base + i) * inv_rms * g + b);
    }
}
