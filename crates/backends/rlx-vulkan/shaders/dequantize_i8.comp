#version 450
// INT8 Dequantize matching CUDA `dequantize_i8` / rlx-cpu exec_dequantize.
layout(local_size_x = 256) in;

layout(push_constant) uniform PC {
    uint n;
    uint chan_dim;
    uint inner;
    uint q_word;
    uint out_off;
    uint affine[26];
} pc;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.n) { return; }
    uint c = (pc.chan_dim <= 1u) ? 0u : ((i / pc.inner) % pc.chan_dim);
    float s = uintBitsToFloat(pc.affine[2u * c]);
    int zp = int(pc.affine[2u * c + 1u]);
    int qv = arena_load_i8(pc.q_word, i);
    arena_store_f(pc.out_off + i, float(qv - zp) * s);
}
