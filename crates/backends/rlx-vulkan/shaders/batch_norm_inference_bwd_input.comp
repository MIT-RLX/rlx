#version 450
// BatchNormInferenceBackwardInput: dx = dy · γ · inv_std (frozen stats).
layout(local_size_x = 256) in;


layout(push_constant) uniform PC {
    uint n;
    uint channels;
    float eps;
    uint gamma_off;
    uint var_off;
    uint dy_off;
    uint out_off;
} pc;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.n || pc.channels == 0u) { return; }
    uint c = i % pc.channels;
    float inv = inversesqrt(arena_load(pc.var_off + c) + pc.eps);
    arena_store(pc.out_off + i, arena_load(pc.dy_off + i) * arena_load(pc.gamma_off + c) * inv);
}
