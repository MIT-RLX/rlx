#version 450
// Real INT8 Op::QMatMul matching CUDA q_matmul / rlx-cpu exec_q_mat_mul.
//   x[M,K] i8, w[K,N] i8, bias[N] i32 (f32-lane) → out[M,N] i8
layout(local_size_x = 256) in;

layout(push_constant) uniform PC {
    uint m;
    uint k;
    uint n;
    uint x_word;
    uint w_word;
    uint bias_off;
    uint out_word;
    int x_zp;
    int w_zp;
    int out_zp;
    uint mult_bits;
} pc;

int q_matmul_one(uint idx) {
    uint mi = idx / pc.n;
    uint ni = idx - mi * pc.n;
    int acc = int(trunc(arena_load_f(pc.bias_off + ni)));
    for (uint ki = 0u; ki < pc.k; ki++) {
        int xv = arena_load_i8(pc.x_word, mi * pc.k + ki) - pc.x_zp;
        int wv = arena_load_i8(pc.w_word, ki * pc.n + ni) - pc.w_zp;
        acc += xv * wv;
    }
    float mult = uintBitsToFloat(pc.mult_bits);
    int r = int(q_round_half_away(float(acc) * mult)) + pc.out_zp;
    if (r < -128) { r = -128; }
    if (r > 127) { r = 127; }
    return r;
}

void main() {
    uint idx = gl_GlobalInvocationID.x;
    uint total = pc.m * pc.n;
    if (idx >= total) { return; }
    // One invocation owns each packed uint word — the same launch shape
    // `quantize_i8.comp` uses, and for the same reason: `arena_store_i8` is a
    // read-modify-write of the containing word (naga's GLSL front end has no
    // `atomicCompSwap`), so four invocations writing four consecutive output
    // elements would clobber each other. This kernel did NOT do that, and the
    // result was that only every fourth output survived — a plausible i8 tensor
    // with three quarters of it left at the zero point.
    if ((idx & 3u) != 0u) { return; }
    uint word = 0u;
    for (uint lane = 0u; lane < 4u; lane++) {
        uint j = idx + lane;
        if (j >= total) { break; }
        word |= (uint(q_matmul_one(j)) & 0xFFu) << (lane * 8u);
    }
    arena_store_u(pc.out_word + (idx >> 2u), word);
}
