#version 450
// Element-wise binary op over the shared f32 arena with per-operand
// trailing-broadcast modulus. op: 0=add 1=sub 2=mul 3=div 4=max 5=min 6=pow.
layout(local_size_x = 256) in;


layout(push_constant) uniform PC {
    uint n;       // output element count
    uint a_off;   // f32-element offset of lhs
    uint b_off;   // f32-element offset of rhs
    uint c_off;   // f32-element offset of output
    uint a_mod;   // lhs element count for broadcast (0 = no broadcast)
    uint b_mod;   // rhs element count for broadcast (0 = no broadcast)
    uint op;      // selector
} pc;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.n) { return; }
    uint ai = (pc.a_mod == 0u) ? i : (i % pc.a_mod);
    uint bi = (pc.b_mod == 0u) ? i : (i % pc.b_mod);
    float a = arena_load(pc.a_off + ai);
    float b = arena_load(pc.b_off + bi);
    float c = 0.0;
    switch (pc.op) {
        case 0u: c = a + b; break;
        case 1u: c = a - b; break;
        case 2u: c = a * b; break;
        case 3u: c = a / b; break;
        case 4u: c = max(a, b); break;
        case 5u: c = min(a, b); break;
        // GLSL pow(a,b) = exp(b*log(a)) → NaN for ANY negative base, even
        // integer exponents (pow(-2,2) should be 4). Match Rust f32::powf:
        // signed result for integer exponents, NaN only for negative base with
        // a genuinely fractional exponent (VITS GELU uses x**3, x**2 on signed x).
        case 6u: {
            if (a < 0.0) {
                float rb = round(b);
                if (abs(b - rb) < 1e-4) {
                    float m = pow(abs(a), rb);
                    c = (mod(abs(rb), 2.0) >= 0.5) ? -m : m;
                } else {
                    c = pow(a, b); // negative base, fractional exp → NaN, matches powf
                }
            } else {
                c = pow(a, b);
            }
            break;
        }
        case 7u: c = a - b * trunc(a / b); break;   // mod (fmod)
        case 8u: c = float(int(a) & int(b)); break;
        case 9u: c = float(int(a) | int(b)); break;
        case 10u: c = float(int(a) ^ int(b)); break;
        case 11u: c = float(int(a) << int(b)); break;
        case 12u: c = float(int(a) >> int(b)); break;
        case 13u: c = atan(a, b); break;            // atan2 (GLSL 2-arg atan)
        default: c = 0.0; break;
    }
    arena_store(pc.c_off + i, c);
}
