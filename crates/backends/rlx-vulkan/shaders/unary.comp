#version 450
// Element-wise activation / unary math over the f32 arena.
// op ids (see backend.rs Activation mapping):
//  0 gelu 1 gelu_approx 2 silu 3 relu 4 sigmoid 5 tanh 6 exp 7 log
//  8 sqrt 9 rsqrt 10 neg 11 abs 12 sin 13 cos 14 tan 15 atan 16 round 17 recip
// Cast op ids (f32-uniform arena; the dst dtype value is stored back as f32 —
// see `classify_cast` in backend.rs, kept in sync with unary.cu / unary.cl):
//  100 f32->i8  101 f32->i16 102 f32->i32 103 f32->i64
//  104 f32->u8  105 f32->u32 106 (x!=0)->bool   255 identity copy
// float->int truncates toward zero + saturates (Rust `as` / rlx-cpu); NaN->0.
layout(local_size_x = 256) in;


layout(push_constant) uniform PC {
    uint n;
    uint in_off;
    uint out_off;
    uint op;
} pc;

float gelu_erf(float x) {
    // 0.5 x (1 + erf(x/sqrt2)); approximate erf via tanh-free rational is
    // imprecise, so use the standard tanh approximation's exact-ish erf.
    // erf(z) ≈ tanh(sqrt(2/pi)(z + 0.044715 z^3)) is gelu_approx; for the
    // "exact" gelu we use a high-accuracy erf approximation (Abramowitz 7.1.26).
    float z = x * 0.7071067811865476;
    float t = 1.0 / (1.0 + 0.3275911 * abs(z));
    float y = 1.0 - (((((1.061405429 * t - 1.453152027) * t) + 1.421413741) * t
              - 0.284496736) * t + 0.254829592) * t * exp(-z * z);
    float erf = (z >= 0.0) ? y : -y;
    return 0.5 * x * (1.0 + erf);
}

float gelu_tanh(float x) {
    float c = 0.7978845608028654; // sqrt(2/pi)
    float inner = c * (x + 0.044715 * x * x * x);
    return 0.5 * x * (1.0 + tanh(inner));
}

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.n) { return; }
    float x = arena_load(pc.in_off + i);
    float y = 0.0;
    switch (pc.op) {
        case 0u:  y = gelu_erf(x); break;
        case 1u:  y = gelu_tanh(x); break;
        case 2u:  y = x / (1.0 + exp(-x)); break;          // silu
        case 3u:  y = max(x, 0.0); break;                  // relu
        case 4u:  y = 1.0 / (1.0 + exp(-x)); break;        // sigmoid
        case 5u:  y = tanh(x); break;
        case 6u:  y = exp(x); break;
        case 7u:  y = log(x); break;
        case 8u:  y = sqrt(x); break;
        case 9u:  y = inversesqrt(x); break;               // rsqrt
        case 10u: y = -x; break;
        case 11u: y = abs(x); break;
        case 12u: y = sin(x); break;
        case 13u: y = cos(x); break;
        case 14u: y = tan(x); break;
        case 15u: y = atan(x); break;
        case 16u: y = floor(x + 0.5); break;               // round (half up)
        case 17u: y = 1.0 / x; break;                      // recip / vvrecf
        // f32 -> int: truncate toward zero, saturate to dst range, NaN -> 0.
        case 100u: y = isnan(x) ? 0.0 : clamp(trunc(x), -128.0, 127.0); break;
        case 101u: y = isnan(x) ? 0.0 : clamp(trunc(x), -32768.0, 32767.0); break;
        case 102u: y = isnan(x) ? 0.0 : clamp(trunc(x), -2147483648.0, 2147483647.0); break;
        case 103u: y = isnan(x) ? 0.0 : clamp(trunc(x), -9223372036854775808.0, 9223372036854775807.0); break;
        case 104u: y = isnan(x) ? 0.0 : clamp(trunc(x), 0.0, 255.0); break;
        case 105u: y = isnan(x) ? 0.0 : clamp(trunc(x), 0.0, 4294967295.0); break;
        // -> Bool: x != 0 ? 1 : 0 (NaN is non-zero -> 1, matching Rust).
        case 106u: y = (x != 0.0) ? 1.0 : 0.0; break;
        default:  y = x; break;                            // 255 = identity copy
    }
    arena_store(pc.out_off + i, y);
}
