#version 450
// Op::RoundToFormat: round to a binary float format emulated on f32, with an
// optional power-of-two scale. Bit-identical to
// `rlx_ir::FloatFormat::round_slice_scaled`: exponent, NaN/inf and subnormal
// tests read the f32 bits; `ldexp` and `roundEven` are exact here.
// One work-item per element, or per block when mode == 2.
layout(local_size_x = 64) in;

layout(push_constant) uniform PC {
    uint n;
    uint last_dim;
    uint block;
    uint mode;      // 0 none, 1 per-tensor (amax at amax_off), 2 per block
    int man_bits;
    int emin;
    int emax;
    float max_normal;
    uint in_off;
    uint amax_off;
    uint out_off;
} pc;

int f32_exp(float a) { return int((floatBitsToUint(a) >> 23) & 0xffu) - 127; }

float flush(float y) {
    uint b = floatBitsToUint(y);
    return (b & 0x7fffffffu) < 0x00800000u ? uintBitsToFloat(b & 0x80000000u) : y;
}

float round_fmt(float x) {
    uint bits = floatBitsToUint(x);
    uint ab = bits & 0x7fffffffu;
    uint sgn = bits & 0x80000000u;
    if (ab == 0u || ab > 0x7f800000u) { return x; }
    if (ab < 0x00800000u) { return uintBitsToFloat(sgn); }
    uint maxb = floatBitsToUint(pc.max_normal);
    if (ab >= maxb) { return uintBitsToFloat(sgn | maxb); }
    float ax = uintBitsToFloat(ab);
    int shift = pc.man_bits - max(f32_exp(ax), pc.emin);
    uint qb = min(floatBitsToUint(ldexp(roundEven(ldexp(ax, shift)), -shift)), maxb);
    return uintBitsToFloat(sgn | (qb < 0x00800000u ? 0u : qb));
}

// Bits of |x|, or 0 for NaN, so NaN never wins a maximum.
uint abs_bits(float x) {
    uint b = floatBitsToUint(x) & 0x7fffffffu;
    return b > 0x7f800000u ? 0u : b;
}

int scale_exp(uint amax_bits) {
    if (amax_bits == 0u || amax_bits >= 0x7f800000u) { return 0; }
    return clamp(int(amax_bits >> 23) - 127 - pc.emax, -126, 127);
}

float round_scaled(float x, int e) { return flush(ldexp(round_fmt(ldexp(x, -e)), e)); }

// `FloatFormat::fine_scale` (smallest (1 + m/8)·2^k with s·max ≥ amax; exact
// products) and `fine_reciprocal` (8-entry table and the exponent).
float fine_scale(float amax) {
    // One flat loop without an early return: naga mistranslated a `return`
    // from a nested loop here (it took the second candidate whatever the test).
    int k0 = clamp(f32_exp(amax) - pc.emax - 1, -126, 125);
    float best = uintBitsToFloat(0x7f700000u);
    bool found = false;
    for (int c = 0; c < 24; c++) {
        int k = k0 + c / 8;
        float s = (1.0 + 0.125 * float(c - (c / 8) * 8)) * uintBitsToFloat(uint(k + 127) << 23);
        // Bit compare (both non-negative): the driver cannot rewrite it as a
        // division by max_normal, whose reciprocal is subnormal for bf16.
        if (!found && floatBitsToUint(s * pc.max_normal) >= floatBitsToUint(amax)) {
            best = s;
            found = true;
        }
    }
    return best;
}
float fine_rcp(float s) {
    uint tab[8] = uint[8](0x3f800000u, 0x3f638e39u, 0x3f4ccccdu, 0x3f3a2e8cu,
                          0x3f2aaaabu, 0x3f1d89d9u, 0x3f124925u, 0x3f088889u);
    uint b = floatBitsToUint(s);
    int ne = 127 - int((b >> 23) & 0xffu);
    if (ne < -126) { return 0.0; }
    ne = min(ne, 127);
    return uintBitsToFloat(tab[(b >> 20) & 7u]) * uintBitsToFloat(uint(ne + 127) << 23);
}

// Squared error of a block at scale 2^e, in index order (`FloatFormat::block_scale`);
// multiply and add are separate statements so they are not contracted.
float sq_err(uint start, uint end, int e) {
    float acc = 0.0;
    for (uint i = start; i < end; i++) {
        float x = arena_load(pc.in_off + i);
        float d = round_scaled(x, e) - x;
        float d2 = d * d;
        acc = acc + d2;
    }
    return acc;
}

void main() {
    uint t = gl_GlobalInvocationID.x;
    if (pc.mode >= 2u) {
        uint per_row = (pc.last_dim + pc.block - 1u) / pc.block;
        uint row = t / per_row;
        uint start = row * pc.last_dim + (t % per_row) * pc.block;
        if (start >= pc.n) { return; }
        uint end = min(start + pc.block, row * pc.last_dim + pc.last_dim);
        uint m = 0u;
        for (uint i = start; i < end; i++) { m = max(m, abs_bits(arena_load(pc.in_off + i))); }
        if (pc.mode == 3u) {
            float s = 1.0;
            float r = 1.0;
            if (m != 0u && m < 0x7f800000u) { s = fine_scale(uintBitsToFloat(m)); r = fine_rcp(s); }
            for (uint i = start; i < end; i++) {
                arena_store(pc.out_off + i, flush(round_fmt(arena_load(pc.in_off + i) * r) * s));
            }
            return;
        }
        int e = scale_exp(m);
        // One binade up when the MX scale clips the block max and that rounds
        // the block with a smaller squared error (ties keep the MX scale).
        if (m != 0u && m < 0x7f800000u && e < 127
            && floatBitsToUint(ldexp(uintBitsToFloat(m), -e)) > floatBitsToUint(pc.max_normal)
            && sq_err(start, end, e + 1) < sq_err(start, end, e)) {
            e += 1;
        }
        for (uint i = start; i < end; i++) {
            arena_store(pc.out_off + i, round_scaled(arena_load(pc.in_off + i), e));
        }
        return;
    }
    if (t >= pc.n) { return; }
    int e = pc.mode == 1u ? scale_exp(abs_bits(arena_load(pc.amax_off))) : 0;
    arena_store(pc.out_off + t, round_scaled(arena_load(pc.in_off + t), e));
}
