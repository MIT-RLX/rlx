#version 450
// Scaled dot-product attention with one 256-thread workgroup per (batch,
// head, query) instead of one thread. `attention.comp`
// gives each row a single invocation that walks every key serially — fine
// for a prefill with thousands of rows, but a decode step has B·H rows, so a
// 4-head cross-attention over 4K keys ran as 4 threads. Here the threads split
// each chunk of keys (scores in shared memory), reduce max and sum across the
// workgroup, and accumulate the weighted values in `256 / dh` key slices per
// output dimension. Same push block, masking and
// online-softmax update as `attention.comp`, chunk by chunk, so a fully
// masked row averages its values exactly as there.
layout(local_size_x = 256) in;

const uint MAX_DH = 256u;
const uint CHUNK = 2048u;

layout(push_constant) uniform PC {
    uint b;
    uint nh;
    uint q_s;
    uint k_s;
    uint dh;
    uint q_off;
    uint k_off;
    uint v_off;
    uint o_off;
    uint qrs;
    uint krs;
    uint vrs;
    uint bhsd;
    uint mask_kind;
    uint mask_off;
    uint window;
    float scale;
    float neg;
    float thr;
    // Keys split across two buffers (`k_split` > 0): keys [0, k_split) at
    // k_off / v_off, keys [k_split, k_s) at k2_off / v2_off — a decode step's
    // `concat(past, new)` read in place instead of copied first.
    uint k2_off;
    uint v2_off;
    uint k_split;
} pc;

shared float s[CHUNK];
shared float qs[MAX_DH];
shared float red[256];
// Weighted-V partials: thread t owns dimension t % dh for keys j ≡ t / dh
// (mod 256 / dh), so all 256 threads accumulate, not just dh of them.
shared float part[256];

float block_max(float v) {
    uint t = gl_LocalInvocationID.x;
    red[t] = v;
    barrier();
    for (uint st = 128u; st > 0u; st >>= 1u) {
        if (t < st) { red[t] = max(red[t], red[t + st]); }
        barrier();
    }
    float r = red[0];
    barrier();
    return r;
}

float block_sum(float v) {
    uint t = gl_LocalInvocationID.x;
    red[t] = v;
    barrier();
    for (uint st = 128u; st > 0u; st >>= 1u) {
        if (t < st) { red[t] += red[t + st]; }
        barrier();
    }
    float r = red[0];
    barrier();
    return r;
}

// Arena offset of key / value row `ki` of head `hi` in batch `bi`.
uint kv_base(uint off, uint off2, uint rs, uint bi, uint hi, uint ki) {
    uint len = pc.k_s;
    if (pc.k_split != 0u) {
        if (ki < pc.k_split) {
            len = pc.k_split;
        } else {
            off = off2;
            ki -= pc.k_split;
            len = pc.k_s - pc.k_split;
        }
    }
    return (pc.bhsd != 0u)
        ? off + bi * pc.nh * len * pc.dh + hi * len * pc.dh + ki * pc.dh
        : off + bi * len * rs + ki * rs + hi * pc.dh;
}

void main() {
    uint row = gl_WorkGroupID.x;
    if (row >= pc.b * pc.nh * pc.q_s || pc.dh > MAX_DH) { return; }
    uint t = gl_LocalInvocationID.x;
    uint qi = row % pc.q_s;
    uint hi = (row / pc.q_s) % pc.nh;
    uint bi = row / (pc.q_s * pc.nh);

    uint q_base;
    uint o_base;
    if (pc.bhsd != 0u) {
        q_base = pc.q_off + bi * pc.nh * pc.q_s * pc.dh + hi * pc.q_s * pc.dh + qi * pc.dh;
        o_base = pc.o_off + bi * pc.nh * pc.q_s * pc.dh + hi * pc.q_s * pc.dh + qi * pc.dh;
    } else {
        q_base = pc.q_off + bi * pc.q_s * pc.qrs + qi * pc.qrs + hi * pc.dh;
        o_base = pc.o_off + bi * pc.q_s * (pc.nh * pc.dh) + qi * (pc.nh * pc.dh) + hi * pc.dh;
    }
    if (t < pc.dh) { qs[t] = arena_load(q_base + t); }
    barrier();

    uint q_offset = (pc.k_s > pc.q_s) ? (pc.k_s - pc.q_s) : 0u;
    uint abs_q = q_offset + qi;

    float m = -3.402823466e38;
    float l = 0.0;
    uint slices = 256u / pc.dh;           // ≥ 1 since dh ≤ 256
    uint dim = t % pc.dh;
    uint slice = t / pc.dh;
    bool active = slice < slices;         // the 256 % dh leftover threads idle
    float acc = 0.0;   // this thread's partial of output dimension `dim`

    for (uint c0 = 0u; c0 < pc.k_s; c0 += CHUNK) {
        uint n = min(CHUNK, pc.k_s - c0);
        float cmax = -3.402823466e38;
        for (uint j = t; j < n; j += 256u) {
            uint ki = c0 + j;
            bool masked = false;
            float bias = 0.0;
            if (pc.mask_kind == 1u) {
                masked = (ki > abs_q);
            } else if (pc.mask_kind == 2u) {
                uint lo = (abs_q > pc.window) ? (abs_q - pc.window) : 0u;
                masked = (ki < lo) || (ki > abs_q);
            } else if (pc.mask_kind == 3u) {
                masked = arena_load(pc.mask_off + bi * pc.k_s + ki) < pc.thr;
            } else if (pc.mask_kind == 4u) {
                bias = arena_load(pc.mask_off + (bi * pc.nh + hi) * pc.q_s * pc.k_s + qi * pc.k_s + ki);
            }
            float score;
            if (masked) {
                score = pc.neg;
            } else {
                uint k_base = kv_base(pc.k_off, pc.k2_off, pc.krs, bi, hi, ki);
                float dot = 0.0;
                for (uint d = 0u; d < pc.dh; d++) { dot += qs[d] * arena_load(k_base + d); }
                score = dot * pc.scale + bias;
            }
            s[j] = score;
            cmax = max(cmax, score);
        }
        float m_new = max(m, block_max(cmax));
        float corr = exp(m - m_new);
        float ps = 0.0;
        for (uint j = t; j < n; j += 256u) {
            float p = exp(s[j] - m_new);
            s[j] = p;
            ps += p;
        }
        l = l * corr + block_sum(ps);   // block_sum's barriers publish s[]
        if (active) {
            float a = acc * corr;
            for (uint j = slice; j < n; j += slices) {
                uint ki = c0 + j;
                uint v_base = kv_base(pc.v_off, pc.v2_off, pc.vrs, bi, hi, ki);
                a += s[j] * arena_load(v_base + dim);
            }
            acc = a;
        }
        m = m_new;
        barrier();   // s[] is rewritten by the next chunk
    }
    // Sum the slices of each dimension.
    part[t] = active ? acc : 0.0;
    barrier();
    if (t < pc.dh) {
        float o = 0.0;
        for (uint sl = 0u; sl < slices; sl++) { o += part[sl * pc.dh + t]; }
        arena_store(o_base + t, (l > 0.0) ? o / l : 0.0);
    }
}
