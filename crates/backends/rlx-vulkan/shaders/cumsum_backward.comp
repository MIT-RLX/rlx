#version 450
// Cumsum backward along last axis (one invocation per row).
// exclusive=1 ⇒ dx[j] = sum_{i>j} dy[i]; else inclusive suffix.
layout(local_size_x = 64) in;

layout(push_constant) uniform PC {
    uint outer;
    uint inner;
    uint dy_off;
    uint dx_off;
    uint exclusive;
} pc;

void main() {
    uint row = gl_GlobalInvocationID.x;
    if (row >= pc.outer) { return; }
    uint dy_base = pc.dy_off + row * pc.inner;
    uint dx_base = pc.dx_off + row * pc.inner;
    float suffix = 0.0;
    for (int i = int(pc.inner) - 1; i >= 0; i--) {
        uint ui = uint(i);
        if (pc.exclusive != 0u) {
            arena_store(dx_base + ui, suffix);
            suffix += arena_load(dy_base + ui);
        } else {
            suffix += arena_load(dy_base + ui);
            arena_store(dx_base + ui, suffix);
        }
    }
}
