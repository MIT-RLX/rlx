#version 450
// SAM2-style axial 2-D RoPE on [batch, seq, num_heads * head_dim].
// Matches rlx_ir::ops::axial_rope2d / wgpu axial_rope2d.wgsl.
layout(local_size_x = 256) in;


layout(push_constant) uniform PC {
    uint batch;
    uint seq;
    uint hidden;
    uint end_x;
    uint end_y;
    uint head_dim;
    uint num_heads;
    uint repeat_factor;
    float theta;
    uint in_off;
    uint out_off;
    uint n_total;
} pc;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.n_total) { return; }

    uint d = i % pc.hidden;
    uint q1 = i / pc.hidden;
    uint tok = q1 % pc.seq;
    uint bi = q1 / pc.seq;

    uint head_dim = pc.head_dim;
    uint half = head_dim / 2u;
    uint d_in_head = d % head_dim;
    uint buf_idx = bi * pc.seq * pc.hidden + tok * pc.hidden + d;
    uint head_base = buf_idx - d_in_head;

    // Only even lanes write both pair outputs (avoids races).
    if ((d_in_head & 1u) != 0u) {
        return;
    }

    uint repeat = max(pc.repeat_factor, 1u);
    uint pos = tok / repeat;
    float tx = float(pos % pc.end_x);
    float ty = float(pos / pc.end_x);

    if (d_in_head < half) {
        uint c = d_in_head / 2u;
        float freq = 1.0 / pow(pc.theta, float(4u * c) / float(head_dim));
        float ang = tx * freq;
        float co = cos(ang);
        float si = sin(ang);
        uint ix0 = head_base + 2u * c;
        uint ix1 = ix0 + 1u;
        float x0 = arena_load(pc.in_off + ix0);
        float x1 = arena_load(pc.in_off + ix1);
        arena_store(pc.out_off + ix0, x0 * co - x1 * si);
        arena_store(pc.out_off + ix1, x0 * si + x1 * co);
    } else {
        uint c = (d_in_head - half) / 2u;
        float freq = 1.0 / pow(pc.theta, float(4u * c) / float(head_dim));
        float ang = ty * freq;
        float co = cos(ang);
        float si = sin(ang);
        uint ix0 = head_base + half + 2u * c;
        uint ix1 = ix0 + 1u;
        float x0 = arena_load(pc.in_off + ix0);
        float x1 = arena_load(pc.in_off + ix1);
        arena_store(pc.out_off + ix0, x0 * co - x1 * si);
        arena_store(pc.out_off + ix1, x0 * si + x1 * co);
    }
}
