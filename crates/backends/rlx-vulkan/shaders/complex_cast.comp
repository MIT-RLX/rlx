#version 450
// Standalone complex `Op::Cast` on the f32-uniform arena, dispatched over the
// complex-element index `k in [0, n)`. Representation:
//   C64  = 2 f32 lanes [re, im]                       (8 B/elem)
//   C128 = 4 f32 lanes [re_hi, re_lo, im_hi, im_lo] df64  (16 B/elem)
//
// Every source of a real->complex cast comes from an f32 real (lo=0), so all
// six directions are pure lane MOVES — no compensated df64 arithmetic. The
// C128->C64 narrow drops the `lo` lanes (keeps `hi`); the widen sets them 0.
//
//   mode 0 real->C64 : out[2k]=in[k];   out[2k+1]=0
//   mode 1 C64->real : out[k]=in[2k]
//   mode 2 real->C128: out[4k]=in[k];   out[4k+1..3]=0
//   mode 3 C128->real: out[k]=in[4k]
//   mode 4 C64->C128 : out[4k]=in[2k]; out[4k+1]=0; out[4k+2]=in[2k+1]; out[4k+3]=0
//   mode 5 C128->C64 : out[2k]=in[4k]; out[2k+1]=in[4k+2]
//
// `in_off` / `out_off` are f32-ELEMENT offsets (the start lane of each tensor),
// weight-tagged (bit 31) when the operand lives in the weight buffer — the tag
// survives the small lane arithmetic and `arena_load`/`arena_store` mask it.
// Mirrors rlx-wgpu `complex_cast.wgsl` / rlx-cuda `complex_cast.cu`.
layout(local_size_x = 256) in;

layout(push_constant) uniform PC {
    uint n;        // number of complex elements
    uint in_off;   // f32-element offset of the source
    uint out_off;  // f32-element offset of the destination
    uint mode;     // 0..5 (see table above)
} pc;

void main() {
    uint k = gl_GlobalInvocationID.x;
    if (k >= pc.n) { return; }
    uint i = pc.in_off;
    uint o = pc.out_off;
    switch (pc.mode) {
        case 0u: { // real -> C64
            arena_store(o + 2u * k,      arena_load(i + k));
            arena_store(o + 2u * k + 1u, 0.0);
            break;
        }
        case 1u: { // C64 -> real
            arena_store(o + k, arena_load(i + 2u * k));
            break;
        }
        case 2u: { // real -> C128
            arena_store(o + 4u * k,      arena_load(i + k));
            arena_store(o + 4u * k + 1u, 0.0);
            arena_store(o + 4u * k + 2u, 0.0);
            arena_store(o + 4u * k + 3u, 0.0);
            break;
        }
        case 3u: { // C128 -> real
            arena_store(o + k, arena_load(i + 4u * k));
            break;
        }
        case 4u: { // C64 -> C128
            arena_store(o + 4u * k,      arena_load(i + 2u * k));
            arena_store(o + 4u * k + 1u, 0.0);
            arena_store(o + 4u * k + 2u, arena_load(i + 2u * k + 1u));
            arena_store(o + 4u * k + 3u, 0.0);
            break;
        }
        case 5u: { // C128 -> C64
            arena_store(o + 2u * k,      arena_load(i + 4u * k));
            arena_store(o + 2u * k + 1u, arena_load(i + 4u * k + 2u));
            break;
        }
        default: { break; }
    }
}
