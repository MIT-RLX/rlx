#version 450
// Fused (residual add + optional bias) + LayerNorm or RMSNorm over the last
// axis, one 256-thread workgroup per row. `fused_residual_ln.comp` /
// `fused_residual_rms_norm.comp` give each row one invocation that walks the
// row serially three times — a decode step's single row ran on one thread.
// Here the threads stride the row and reduce in shared memory; each thread
// only rereads the elements it wrote, so `out` may alias the input. Same push
// block as those kernels plus `rms` (0 = LayerNorm, two-pass variance;
// 1 = RMSNorm). fp32 throughout.
layout(local_size_x = 256) in;

layout(push_constant) uniform PC {
    uint outer;
    uint inner;
    uint in_off;
    uint residual_off;
    uint bias_off;
    uint gamma_off;
    uint beta_off;
    uint out_off;
    uint has_bias;
    float eps;
    uint rms;
} pc;

shared float red[256];

float block_sum(float v) {
    uint t = gl_LocalInvocationID.x;
    red[t] = v;
    barrier();
    for (uint st = 128u; st > 0u; st >>= 1u) {
        if (t < st) { red[t] += red[t + st]; }
        barrier();
    }
    float r = red[0];
    barrier();
    return r;
}

void main() {
    uint row = gl_WorkGroupID.x;
    if (row >= pc.outer || pc.inner == 0u) { return; }
    uint t = gl_LocalInvocationID.x;
    uint in_base = pc.in_off + row * pc.inner;
    uint res_base = pc.residual_off + row * pc.inner;
    uint out_base = pc.out_off + row * pc.inner;
    float n_inv = 1.0 / float(pc.inner);

    float s1 = 0.0;
    float s2 = 0.0;
    for (uint i = t; i < pc.inner; i += 256u) {
        float v = arena_load(in_base + i) + arena_load(res_base + i);
        if (pc.has_bias != 0u) { v += arena_load(pc.bias_off + i); }
        arena_store(out_base + i, v);
        s1 += v;
        s2 += v * v;
    }
    float mean;
    float inv;
    if (pc.rms != 0u) {
        mean = 0.0;
        inv = inversesqrt(block_sum(s2) * n_inv + pc.eps);
    } else {
        mean = block_sum(s1) * n_inv;
        float sq = 0.0;
        for (uint i = t; i < pc.inner; i += 256u) {
            float d = arena_load(out_base + i) - mean;
            sq += d * d;
        }
        inv = inversesqrt(block_sum(sq) * n_inv + pc.eps);
    }
    for (uint i = t; i < pc.inner; i += 256u) {
        float g = arena_load(pc.gamma_off + i);
        float b = arena_load(pc.beta_off + i);
        arena_store(out_base + i, (arena_load(out_base + i) - mean) * inv * g + b);
    }
}
