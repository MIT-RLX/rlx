#version 450
// RMS norm over the last axis (length n), matching the CPU reference:
//   y = x / sqrt(mean(x^2) + eps) * gamma + beta
// Inputs: x, gamma, beta (Op::RmsNorm carries all three). One invocation/row.
layout(local_size_x = 64) in;


layout(push_constant) uniform PC {
    uint rows;
    uint n;
    uint x_off;
    uint gamma_off;
    uint beta_off;
    uint out_off;
    float eps;
} pc;

void main() {
    uint row = gl_GlobalInvocationID.x;
    if (row >= pc.rows) { return; }
    uint base = row * pc.n;
    float n_inv = 1.0 / float(pc.n);
    // Two-pass: mean(x²) = mean((x−mean)²) + mean². Subtracting the row mean
    // first keeps the deviation sum well-conditioned under a large DC offset
    // (the canonical form the CPU oracle + all backends match).
    float sum = 0.0;
    for (uint i = 0u; i < pc.n; i++) {
        sum += arena_load(pc.x_off + base + i);
    }
    float mean = sum * n_inv;
    float dev = 0.0;
    for (uint i = 0u; i < pc.n; i++) {
        float d = arena_load(pc.x_off + base + i) - mean;
        dev += d * d;
    }
    float inv = inversesqrt(dev * n_inv + mean * mean + pc.eps);
    for (uint i = 0u; i < pc.n; i++) {
        float g = arena_load(pc.gamma_off + i);
        float b = arena_load(pc.beta_off + i);
        arena_store(pc.out_off + base + i, arena_load(pc.x_off + base + i) * inv * g + b);
    }
}
