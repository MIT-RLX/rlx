#version 450
// Welch PSD accumulate + top-K peaks (one invocation per welch_batch row).
// Matches rlx_ir::audio::welch_peaks_block_f32 / wgpu welch_peaks_gpu.wgsl.
layout(local_size_x = 64) in;

layout(push_constant) uniform PC {
    uint spec_off;
    uint dst_off;
    uint welch_batch;
    uint n_fft;
    uint n_segments;
    uint k;
    uint n_bins;
} pc;

const float NEG_INF = -3.4e38;
const uint MAX_BINS = 512u;

void main() {
    uint row = gl_GlobalInvocationID.x;
    if (row >= pc.welch_batch) { return; }

    uint n_fft = pc.n_fft;
    uint n_bins = pc.n_bins;
    float inv = 1.0 / float(pc.n_segments);
    uint row_len = n_fft * 2u;

    float psd[MAX_BINS];
    for (uint b = 0u; b < n_bins; b++) {
        psd[b] = 0.0;
    }

    for (uint s = 0u; s < pc.n_segments; s++) {
        uint seg_row = row * pc.n_segments + s;
        uint base = pc.spec_off + seg_row * row_len;
        float re0 = arena_load(base);
        float im0 = arena_load(base + n_fft);
        psd[0] = psd[0] + inv * (re0 * re0 + im0 * im0);
        for (uint bin = 1u; bin + 1u < n_bins; bin++) {
            float re = arena_load(base + bin);
            float im = arena_load(base + n_fft + bin);
            psd[bin] = psd[bin] + inv * 2.0 * (re * re + im * im);
        }
        if (n_bins > 1u) {
            uint bin = n_bins - 1u;
            float re = arena_load(base + bin);
            float im = arena_load(base + n_fft + bin);
            psd[bin] = psd[bin] + inv * (re * re + im * im);
        }
    }

    uint out_base = pc.dst_off + row * pc.k * 2u;
    for (uint step = 0u; step < pc.k; step++) {
        float best_v = NEG_INF;
        uint best_i = 0u;
        for (uint j = 0u; j < n_bins; j++) {
            bool taken = false;
            for (uint p = 0u; p < step; p++) {
                if (uint(arena_load(out_base + p * 2u)) == j) {
                    taken = true;
                    break;
                }
            }
            if (taken) { continue; }
            float v = psd[j];
            if (v > best_v || (v == best_v && j < best_i)) {
                best_v = v;
                best_i = j;
            }
        }
        arena_store(out_base + step * 2u, float(best_i));
        arena_store(out_base + step * 2u + 1u, best_v);
    }
}
