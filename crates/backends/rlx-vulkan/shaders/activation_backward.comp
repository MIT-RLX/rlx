#version 450
// Element-wise activation / ReLU backward.
// op ids (match CUDA / wgpu activation_backward, NOT forward unary.comp):
//   0=relu 1=sigmoid 2=tanh 3=exp 4=log 5=sqrt 6=rsqrt
//   7=neg  8=abs     9=gelu 10=silu 11=gelu_approx
//   12=round 13=sin 14=cos 15=tan 16=atan 17=recip
layout(local_size_x = 256) in;


layout(push_constant) uniform PC {
    uint n;
    uint x_off;
    uint dy_off;
    uint dx_off;
    uint op;
} pc;

float erf_approx(float x) {
    // Abramowitz & Stegun 7.1.26 — matches rlx-cpu / wgpu.
    float s = (x >= 0.0) ? 1.0 : -1.0;
    float xa = abs(x);
    float t = 1.0 / (1.0 + 0.3275911 * xa);
    float poly = t * (0.254829592 + t * (-0.284496736 + t * (1.421413741
                + t * (-1.453152027 + t * 1.061405429))));
    return s * (1.0 - poly * exp(-xa * xa));
}

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.n) { return; }
    float x = arena_load(pc.x_off + i);
    float dy = arena_load(pc.dy_off + i);
    float dx = dy;
    switch (pc.op) {
        case 0u: // relu
            dx = (x > 0.0) ? dy : 0.0;
            break;
        case 1u: { // sigmoid
            float xc = clamp(x, -88.0, 88.0);
            float s = 1.0 / (1.0 + exp(-xc));
            dx = s * (1.0 - s) * dy;
        } break;
        case 2u: { // tanh
            float t = tanh(clamp(x, -15.0, 15.0));
            dx = (1.0 - t * t) * dy;
        } break;
        case 3u: // exp
            dx = exp(x) * dy;
            break;
        case 4u: // log
            dx = dy / x;
            break;
        case 5u: { // sqrt
            float s = sqrt(x);
            dx = (s > 0.0) ? (0.5 * dy / s) : 0.0;
        } break;
        case 6u: { // rsqrt
            float s = sqrt(x);
            dx = (s > 0.0) ? (-0.5 * dy / (x * s)) : 0.0;
        } break;
        case 7u: // neg
            dx = -dy;
            break;
        case 8u: // abs
            dx = (x > 0.0) ? dy : ((x < 0.0) ? -dy : 0.0);
            break;
        case 9u: { // gelu (erf)
            const float INV_SQRT2 = 0.7071067811865475;
            const float INV_SQRT_2PI = 0.3989422804014327;
            float phi = 0.5 * (1.0 + erf_approx(x * INV_SQRT2));
            float pdf = INV_SQRT_2PI * exp(-0.5 * x * x);
            dx = (phi + x * pdf) * dy;
        } break;
        case 10u: { // silu
            float xc = clamp(x, -88.0, 88.0);
            float s = 1.0 / (1.0 + exp(-xc));
            dx = s * (1.0 + x * (1.0 - s)) * dy;
        } break;
        case 11u: { // gelu_approx (tanh)
            const float C = 0.7978845608028654;
            const float A = 0.044715;
            float inner = clamp(C * (x + A * x * x * x), -15.0, 15.0);
            float t = tanh(inner);
            float dinner = C * (1.0 + 3.0 * A * x * x);
            float d = 0.5 * (1.0 + t) + 0.5 * x * (1.0 - t * t) * dinner;
            dx = d * dy;
        } break;
        case 12u: // round STE
            dx = dy;
            break;
        case 13u: // sin
            dx = cos(x) * dy;
            break;
        case 14u: // cos
            dx = -sin(x) * dy;
            break;
        case 15u: { // tan
            float t = tan(x);
            dx = (1.0 + t * t) * dy;
        } break;
        case 16u: // atan
            dx = dy / (1.0 + x * x);
            break;
        case 17u: // recip: -1/x²
            dx = -dy / (x * x);
            break;
        default:
            dx = dy;
            break;
    }
    arena_store(pc.dx_off + i, dx);
}
