#version 450
// `RngBackend::Zero` — deterministic all-zero fill, for bisecting whether a
// numerical difference comes from the RNG stream or from everything else.
// On-device so selecting it does not itself change the schedule shape.
layout(local_size_x = 256) in;

layout(push_constant) uniform PC {
    uint n;
    uint out_off;
    float unused_a;
    float unused_b;
    uint unused_seed_lo;
    uint unused_seed_hi;
} pc;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.n) { return; }
    arena_store(pc.out_off + i, 0.0);
}
