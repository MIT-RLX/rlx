// Fma(a, b, c) → Add(Mul(a, b), c) for non-f32 dtypes (f32 gets the exact
// emulation, covered by `lower_fma` unit tests and rlx-runtime probes).
// RUN: lower_fma
graph @fma {
  %0 = {"Input":{"name":"a"}} : [8] f64
  %1 = {"Input":{"name":"b"}} : [8] f64
  %2 = {"Input":{"name":"c"}} : [8] f64
  %3 = Fma(%0, %1, %2) : [8] f64
  return %3
}
// EXPECT
graph @fma {
  %0 = {"Input":{"name":"a"}} : [8] f64
  %1 = {"Input":{"name":"b"}} : [8] f64
  %2 = {"Input":{"name":"c"}} : [8] f64
  %3 = {"Binary":"Mul"}(%0, %1) : [8] f64
  %4 = {"Binary":"Add"}(%3, %2) : [8] f64
  return %4
}
