// @generated by rlxsl::exact — native `/`, `sqrt`, `1/sqrt` (fast math).
fn rlx_div_rn(a: f32, b: f32) -> f32 {
    return a / b;
}

fn rlx_sqrt_rn(x: f32) -> f32 {
    return sqrt(x);
}

fn rlx_rsqrt_rn(x: f32) -> f32 {
    return inverseSqrt(x);
}

fn rlx_exp(x: f32) -> f32 {
    return exp(x);
}

fn rlx_log(x: f32) -> f32 {
    return log(x);
}

fn rlx_tanh(x: f32) -> f32 {
    return tanh(x);
}

fn rlx_sin(x: f32) -> f32 {
    return sin(x);
}

fn rlx_cos(x: f32) -> f32 {
    return cos(x);
}
