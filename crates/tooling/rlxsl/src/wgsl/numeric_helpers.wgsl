// @generated by rlxsl::exact — correctly-rounded `/`, `sqrt`, `1/sqrt`.
fn rlx_div_rn(a: f32, b: f32) -> f32 {
    let q0 = a / b;
    // A zero or non-finite first quotient is already the IEEE answer (bits,
    // not `q0 != q0`: fast math folds that away).
    let bq = bitcast<u32>(q0) & 0x7fffffffu;
    if (bq == 0u || bq >= 0x7f800000u) { return q0; }
    // Divide the significands, `x, y` in [1/2, 1): their quotient lies in
    // (1/2, 2), so every remainder below is a normal number however small `a`
    // and `b` are. (Metal's fast math flushes subnormals: dividing `a` itself,
    // a small dividend's remainder vanished and the correction with it.)
    let fa = frexp(a);
    let fb = frexp(b);
    let x = fa.fract;
    let y = fb.fract;
    let q = x / y;
    var c = q + fma(-y, q, x) / y;
    // The step rounds its correction before adding it, so near a midpoint
    // `c` depends on the first quotient. Move to the neighbour on the
    // quotient's side when the quotient lies past their midpoint (ties to
    // even): `r = x - y·c` is exact, and `r - y·u/2` has the sign of
    // `x - y·(c + n)/2`.
    let r = fma(-y, c, x);
    if (r != 0.0) {
        let up = (r > 0.0) == (y > 0.0);
        let cb = bitcast<u32>(c);
        let nb = select(cb - 1u, cb + 1u, up == (c > 0.0));
        let n = bitcast<f32>(nb);
        let t = fma(-y, (n - c) * 0.5, r);
        if ((t != 0.0 && ((t > 0.0) == (y > 0.0)) == up) || (t == 0.0 && (nb & 1u) == 0u)) {
            c = n;
        }
    }
    // `c·2^e` is exact while it is normal; a subnormal quotient takes one
    // rounding, in the product.
    let e = fa.exp - fb.exp;
    if (e < -100) { return ldexp(c, e + 64) * 0x1p-64f; }
    return ldexp(c, e);
}

fn rlx_sqrt_rn(x: f32) -> f32 {
    let bx = bitcast<u32>(x);
    if ((bx & 0x7fffffffu) == 0u) { return x; }
    if (bx >= 0x7f800000u) {
        // +inf stays; negatives and NaN are NaN. The NaN is built from `bx`:
        // a constant NaN (or inf) is a shader-creation error in Chrome.
        return select(bitcast<f32>((bx & 0u) | 0x7fc00000u), x, bx == 0x7f800000u);
    }
    var s = x;
    var back = 1.0;
    if (x < 0x1p-60f) {
        s = x * 0x1p100f;
        back = 0x1p-50f;
    } else if (x > 0x1p60f) {
        s = x * 0x1p-100f;
        back = 0x1p50f;
    }
    var y = sqrt(s);
    for (var i = 0u; i < 4u; i++) {
        let r = fma(-y, y, s);
        if (r < 0.0) {
            let lo = bitcast<f32>(bitcast<u32>(y) - 1u);
            let u = y - lo;
            if (fma(-lo, lo, s) + r + 0.5 * u * u < 0.0) { y = lo; } else { break; }
        } else {
            let hi = bitcast<f32>(bitcast<u32>(y) + 1u);
            let u = hi - y;
            if (fma(-hi, hi, s) + r + 0.5 * u * u > 0.0) { y = hi; } else { break; }
        }
    }
    return y * back;
}

fn rlx_rsqrt_rn(x: f32) -> f32 {
    return rlx_div_rn(1.0, rlx_sqrt_rn(x));
}

fn rlx_exp(x: f32) -> f32 {
    let bx = bitcast<u32>(x);
    if ((bx & 0x7fffffffu) > 0x7f800000u) { return x; }
    let xc = clamp(x, -110.0, 89.0);
    let n = round(xc * 1.44269504);
    let r = fma(n, -1.428606765330187e-6, fma(n, -0.693145751953125, xc));
    var p = 1.9875691500e-4;
    p = fma(p, r, 1.3981999507e-3);
    p = fma(p, r, 8.3334519073e-3);
    p = fma(p, r, 4.1665795894e-2);
    p = fma(p, r, 1.6666665459e-1);
    p = fma(p, r, 5.0000001201e-1);
    let y = 1.0 + fma(p, r * r, r);
    let yb = bitcast<u32>(y);
    let e = i32((yb >> 23u) & 0xffu) - 127 + i32(n);
    if (e >= -126) { return ldexp(y, i32(n)); }
    // A subnormal result (x below about -87.3), rounded to nearest even from
    // the bits: `ldexp` into the subnormal range is flushed to zero by
    // Metal's fast math and kept by a browser.
    let sh = u32(-126 - e);
    if (sh > 24u) { return 0.0; }
    let m = (yb & 0x7fffffu) | 0x800000u;
    let rem = m & ((1u << sh) - 1u);
    let half = 1u << (sh - 1u);
    var q = m >> sh;
    if (rem > half || (rem == half && (q & 1u) == 1u)) { q += 1u; }
    return bitcast<f32>(q);
}

fn rlx_log(x: f32) -> f32 {
    let bx = bitcast<u32>(x);
    // +inf and NaN are their own log; ±0 is -inf, a negative is NaN — built
    // from `bx`, as a constant inf/NaN is a shader-creation error in Chrome.
    if (bx >= 0x7f800000u && bx <= 0x7fffffffu) { return x; }
    if ((bx & 0x7fffffffu) == 0u) { return bitcast<f32>((bx & 0u) | 0xff800000u); }
    if ((bx >> 31u) != 0u) { return bitcast<f32>((bx & 0u) | 0x7fc00000u); }
    // x = m·2^e, m in [1, 2), split from the bits so a subnormal `x` is
    // normalized with integer ops (fast math would flush it as a float).
    var mant = bx & 0x7fffffu;
    var e = i32(bx >> 23u) - 127;
    if ((bx >> 23u) == 0u) {
        let k = 31u - countLeadingZeros(mant);
        e = i32(k) - 149;
        mant = (mant << (23u - k)) & 0x7fffffu;
    }
    var m = bitcast<f32>(mant | 0x3f800000u);
    if (m > 1.41421356) {
        m = m * 0.5;
        e = e + 1;
    }
    // Cephes' logf: log(1 + t) = t - t²/2 + t³·P(t), t = m - 1 exact.
    let t = m - 1.0;
    var p = 7.0376836292e-2;
    p = fma(p, t, -1.1514610310e-1);
    p = fma(p, t, 1.1676998740e-1);
    p = fma(p, t, -1.2420140846e-1);
    p = fma(p, t, 1.4249322787e-1);
    p = fma(p, t, -1.6668057665e-1);
    p = fma(p, t, 2.0000714765e-1);
    p = fma(p, t, -2.4999993993e-1);
    p = fma(p, t, 3.3333331174e-1);
    let z = t * t;
    let fe = f32(e);
    var y = fma(fe, -2.12194440e-4, t * z * p);
    y = fma(-0.5, z, y);
    return fma(fe, 0.693359375, t + y);
}

fn rlx_tanh(x: f32) -> f32 {
    let ax = abs(x);
    if (ax < 0.625) {
        // Cephes' tanhf: x + x³·P(x²).
        let z = x * x;
        var p = -5.70498872745e-3;
        p = fma(p, z, 2.06390887954e-2);
        p = fma(p, z, -5.37397155531e-2);
        p = fma(p, z, 1.33314422036e-1);
        p = fma(p, z, -3.33332819422e-1);
        return fma(p * z, x, x);
    }
    let t = 1.0 - rlx_div_rn(2.0, rlx_exp(2.0 * ax) + 1.0);
    return select(t, -t, x < 0.0);
}

// sin / cos for twiddles and rotations, from IEEE fma alone (the builtins round
// by the compiler's math mode): Cody-Waite reduction by pi/2 in two parts, then
// degree-9 / degree-8 polynomials. Within 1e-7 absolute for |x| <= 8 pi.
fn rlx_sincos_reduce(x: f32) -> vec2<f32> {
    let q = round(x * 0.63661977);
    let r = fma(q, -7.549789415861596e-08, fma(q, -1.5707962512969971, x));
    return vec2<f32>(r, q);
}

fn rlx_sin_poly(r: f32) -> f32 {
    let z = r * r;
    let p = fma(z, fma(z, fma(z, 2.7557314e-06, -1.984127e-04), 8.3333333e-03), -0.16666667);
    return fma(r * z, p, r);
}

fn rlx_cos_poly(r: f32) -> f32 {
    let z = r * r;
    let p = fma(z, fma(z, fma(z, 2.4801587e-05, -1.3888889e-03), 4.1666668e-02), -0.5);
    return fma(z, p, 1.0);
}

fn rlx_sin(x: f32) -> f32 {
    let rq = rlx_sincos_reduce(x);
    let s = rlx_sin_poly(rq.x);
    let c = rlx_cos_poly(rq.x);
    let k = i32(rq.y) & 3;
    return select(select(select(-c, -s, k == 2), c, k == 1), s, k == 0);
}

fn rlx_cos(x: f32) -> f32 {
    let rq = rlx_sincos_reduce(x);
    let s = rlx_sin_poly(rq.x);
    let c = rlx_cos_poly(rq.x);
    let k = i32(rq.y) & 3;
    return select(select(select(s, -c, k == 2), -s, k == 1), c, k == 0);
}
