class Group:
    """This process's place in a mesh of rlx nodes. Every call blocks until its
    peers take part (with the GIL released, so ranks can be threads)."""
    @staticmethod
    def connect(rank: int, world: int, options: Mapping[str, Any] | None = ...) -> Group: ...
    @staticmethod
    def from_env() -> Group: ...
    def rank(self) -> int: ...
    def world(self) -> int: ...
    def is_leader(self) -> bool: ...
    def barrier(self) -> None: ...
    def send(self, to: int, tag: int, data: Sequence[float]) -> None: ...
    def recv(self, from_: int, tag: int) -> npt.NDArray[np.float32]: ...
    def all_reduce(self, data: Sequence[float], op: str = ...) -> npt.NDArray[np.float32]: ...
    def all_gather(self, data: Sequence[float]) -> npt.NDArray[np.float32]: ...
    def broadcast(self, root: int, data: Sequence[float]) -> npt.NDArray[np.float32]: ...
    def collect_caps(self) -> list[dict[str, Any]]: ...
    def ship_stage(
        self, rank: int, graph: Graph, options: Mapping[str, Any] | None = ...,
    ) -> None: ...
    def send_activation(self, to: int, data: Sequence[float]) -> None: ...
    def recv_activation(self, from_: int) -> npt.NDArray[np.float32]: ...
    def serve_worker(self, options: Mapping[str, Any] | None = ...) -> dict[str, Any]: ...
    def ship_train(self, rank: int, graph: Graph, spec: Mapping[str, Any]) -> None: ...
    def run_train(self, graph: Graph, spec: Mapping[str, Any]) -> dict[str, Any]: ...
    def serve_trainer(self, options: Mapping[str, Any] | None = ...) -> dict[str, Any]: ...

