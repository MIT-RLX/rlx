class Session:
    """Binds compile + execute to one backend and precision."""
    def __init__(
        self, device: str = "cpu", precision: str = "f32", policy: PolicySpec | None = None,
    ) -> None: ...
    @property
    def device(self) -> str: ...
    @property
    def precision(self) -> str: ...
    @property
    def policy(self) -> str | None: ...
    def compile(self, graph: Graph) -> CompiledGraph: ...
    def compile_with(
        self,
        graph: Graph,
        fusion_options: FusionOptions | None = ...,
        kernel_dispatch: str | None = ...,
        policy: PolicySpec | None = ...,
    ) -> CompiledGraph: ...
    def __repr__(self) -> str: ...

class CompiledGraph:
    """Compiled executable; upload params then call ``run`` or ``run_typed``."""
    @property
    def device(self) -> str: ...
    def set_param(self, name: str, data: npt.NDArray[np.float32]) -> None: ...
    def set_params(self, params: Mapping[str, npt.NDArray[np.float32]]) -> int: ...
    def output_shapes(self) -> list[list[int]]: ...
    def output_dtypes(self) -> list[str]: ...
    def inputs(self) -> list[dict[str, Any]]:
        """Declared inputs: ``{"name", "dtype", "shape"}`` (``shape`` is None when symbolic)."""
    def params(self) -> list[dict[str, Any]]:
        """Declared parameters, like ``inputs()``."""
    def outputs(self) -> list[dict[str, Any]]:
        """Outputs in ``run`` order, like ``inputs()``; ``name`` is "" when unnamed."""
    def output_index(self, name: str) -> int:
        """The position in ``run``'s result of the output named ``name``."""
    def check_bindings(self, supplied: Sequence[str] = ...) -> None:
        """Raise naming inputs ``supplied`` leaves unbound and params never set."""
    def allow_unbound(self, names: Sequence[str]) -> None:
        """Declare inputs / params meant to read zeros (no unbound warning)."""
    def run(
        self, inputs: Mapping[str, npt.NDArray[np.float32]],
    ) -> list[npt.NDArray[np.float32]]: ...
    def run_flat(
        self, inputs: Mapping[str, npt.NDArray[np.float32]],
    ) -> list[npt.NDArray[np.float32]]: ...
    def set_param_typed(self, name: str, data: bytes, dtype: DTypeName) -> None: ...
    def run_typed(
        self, inputs: Mapping[str, tuple[bytes, DTypeName]],
    ) -> list[tuple[bytes, str]]: ...
    def __repr__(self) -> str: ...

