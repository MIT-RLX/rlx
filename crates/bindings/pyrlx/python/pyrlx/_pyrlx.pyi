class Partition:
    """A graph split into self-contained parts that run in order: part ``i``
    reads ``imports(i)`` from earlier parts' ``exports`` of the same name."""
    def __init__(self, graph: Graph, assign: Sequence[int]) -> None: ...
    @staticmethod
    def split_at(graph: Graph, cut: Sequence[NodeId]) -> Partition: ...
    @staticmethod
    def components(graph: Graph) -> Partition: ...
    def num_parts(self) -> int: ...
    def __len__(self) -> int: ...
    def graph(self, part: int) -> Graph: ...
    def imports(self, part: int) -> list[str]: ...
    def exports(self, part: int) -> list[str]: ...
    def outputs(self) -> list[tuple[int, int]]: ...
    def merge(self) -> Graph: ...

