    ``beta2``, ``eps``, ``weight_decay``, ``momentum``, ``nesterov``, ``gamma``,
    ``rho``, ``f32_math``."""
    def __init__(self, kind: OptimizerKind = "adamw", **opts: float) -> None: ...
    def step(
        self, params: Mapping[str, tuple[npt.NDArray[np.float32], npt.NDArray[np.float32]]],
    ) -> dict[str, npt.NDArray[np.float32]]: ...
    def set_lr(self, lr: float) -> None: ...

class Trainer:
    """Differentiate-once / compile-once loop over a scalar-loss graph."""
    def __init__(
        self,
        graph: Graph,
        wrt: Sequence[str],
        init: Mapping[str, npt.NDArray[np.float32]],
        device: str = "cpu",
        optimizer: OptimizerKind | Mapping[str, Any] | None = None,
        policy: PolicySpec | None = None,
        clip_norm: float | None = None,
        resident: bool | Literal["unverified"] | None = None,
    ) -> None: ...
    def step(self, batch: Mapping[str, npt.NDArray[np.float32]]) -> float: ...
    def evaluate(self, batch: Mapping[str, npt.NDArray[np.float32]]) -> float: ...
    def run(
        self, steps: int, batch: Any, lr: Any = None, on_step: Any = None, every: int = 1,
    ) -> dict[str, Any]: ...
    def freeze(self, names: Sequence[str] | None = None) -> int: ...
    def unfreeze(self, names: Sequence[str] | None = None) -> int: ...
    def frozen(self) -> list[str]: ...
    def trainable(self) -> list[str]: ...
    def grad_norm(self) -> float | None: ...
    def is_resident(self) -> bool: ...
    def params(self) -> dict[str, npt.NDArray[np.float32]]: ...
    def set_params(self, params: Mapping[str, npt.NDArray[np.float32]]) -> int: ...
    def set_lr(self, lr: float) -> None: ...
    def steps(self) -> int: ...
    def device(self) -> str: ...
    def save(self, path: str) -> int: ...
    def load(self, path: str) -> dict[str, Any]: ...
    @staticmethod
    def from_package(
        path: str, options: dict[str, Any] | None = None, **kw: Any
    ) -> "Trainer": ...
    def save_package(self, path: str, name: str | None = None) -> None: ...

# ── Text (cargo feature `text`, default on) ────────────────────────

class Tokenizer:
    def encode(self, text: str, add_special: bool = True) -> list[int]: ...
    def decode(self, ids: Sequence[int], skip_special: bool = True) -> str: ...
    def decode_incremental(self, id: int) -> str: ...
    def finish_stream(self) -> str: ...
    def reset_stream(self) -> None: ...

class Sampler:
    """Options: ``temperature``, ``top_k``, ``top_p``, ``min_p``, ``typical_p``,
    ``repetition_penalty``, ``frequency_penalty``, ``presence_penalty``, ``seed``."""
    def __init__(self, **opts: float) -> None: ...
    def next(self, logits: Sequence[float]) -> int: ...
    def prime(self, ids: Sequence[int]) -> int: ...
    def reset(self, seed: int | None = None) -> None: ...
    def history(self) -> list[int]: ...

def load_tokenizer(path: str) -> Tokenizer: ...
def argmax(logits: Sequence[float]) -> int: ...
def sample_next(logits: Sequence[float], history: Sequence[int] = ..., **opts: float) -> int: ...
def render_chat(
    source: str, messages: Sequence[Mapping[str, str]], add_generation_prompt: bool = True,
) -> str: ...

# ── models (feature ``models``) ─────────────────────────────

class Model:
    """A model from any provider — an ``.rlxp`` package, a plugin's family
    runner (LLMs, speech, vision, …) — opened by path or id."""
    @staticmethod
    def open(source: str, options: Mapping[str, Any] | None = None, **kw: Any) -> Model: ...
    def info(self) -> dict[str, Any]: ...
    def task(self) -> str: ...
    def run(
        self, inputs: Mapping[str, npt.NDArray[np.float32] | Sequence[float]],
        options: Mapping[str, Any] | None = None, **kw: Any,
    ) -> list[npt.NDArray[np.float32]]: ...
    def run_typed(
        self, inputs: Mapping[str, tuple[bytes, str]],
        options: Mapping[str, Any] | None = None, **kw: Any,
    ) -> list[tuple[bytes, str]]: ...
    def output_shapes(self) -> list[list[int]]: ...
    def output_names(self) -> list[str]: ...
    def predict_logits(self, ids: Sequence[int]) -> list[float]: ...
    def generate(
        self, ids: Sequence[int], max_tokens: int = 16,
        options: Mapping[str, Any] | None = None, **kw: Any,
    ) -> list[int]: ...
    def generate_text(self, prompt: str, options: Mapping[str, Any] | None = None, **kw: Any) -> str: ...
    def chat(
        self, messages: Sequence[Mapping[str, str]] | str,
        options: Mapping[str, Any] | None = None, **kw: Any,
    ) -> str: ...
    def transcribe(
        self, audio: npt.NDArray[np.float32] | Sequence[float], sample_rate: int = 16000,
        options: Mapping[str, Any] | None = None, **kw: Any,
    ) -> str: ...
    def synthesize(
        self, text: str, options: Mapping[str, Any] | None = None, **kw: Any,
    ) -> tuple[npt.NDArray[np.float32], int]: ...
    def embed(
        self, texts: Sequence[str] | str, options: Mapping[str, Any] | None = None, **kw: Any,
    ) -> npt.NDArray[np.float32]: ...

def model_providers() -> list[dict[str, Any]]: ...
def load_model_plugin(path: str) -> list[str]: ...
def save_model(
