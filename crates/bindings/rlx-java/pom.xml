<?xml version="1.0" encoding="UTF-8"?>
<!-- RLX — versatile ML compiler + runtime. MIT OR Apache-2.0. -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>org.rlx</groupId>
  <artifactId>rlx</artifactId>
  <version>0.2.19</version>
  <name>rlx</name>
  <description>Java bindings for rlx over its C ABI (the FFM API, Java 22+).</description>
  <licenses>
    <license><name>MIT OR Apache-2.0</name></license>
  </licenses>
  <properties>
    <maven.compiler.release>22</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>
  <build>
    <plugins>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.5.0</version>
        <executions>
          <execution>
            <id>rlx-test</id>
            <phase>test</phase>
            <goals><goal>exec</goal></goals>
            <configuration>
              <executable>java</executable>
              <arguments>
                <argument>--enable-native-access=ALL-UNNAMED</argument>
                <argument>-classpath</argument>
                <classpath/>
                <argument>org.rlx.RLXTest</argument>
              </arguments>
              <classpathScope>test</classpathScope>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
