<Project Sdk="Microsoft.NET.Sdk">
  <!-- The five runtime examples; run one with: dotnet run (then the example name: inference, training, loading, distributed or backends). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <!-- Run on the newest installed runtime (8, 9, 10, …). -->
    <RollForward>Major</RollForward>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Rlx/Rlx.csproj" />
  </ItemGroup>
</Project>
