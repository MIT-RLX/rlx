<Project Sdk="Microsoft.NET.Sdk">
  <!-- The C# binding against the real library: `dotnet run` exits non-zero on a failure. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <!-- Run on the newest installed runtime (8, 9, 10, …). -->
    <RollForward>Major</RollForward>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Rlx/Rlx.csproj" />
  </ItemGroup>
</Project>
