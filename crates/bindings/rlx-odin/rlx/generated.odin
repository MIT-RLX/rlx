Spd_Batch_Norm_Result :: struct {
	first: Node,
	second: Node,
}

// Riemannian batch norm → `(normalized, batch_mean)`.
spd_batch_norm :: proc(self: Graph, x: Node, gamma: Node, eps: f32, iters: int = 20, tol: f32 = 1e-6) -> (Spd_Batch_Norm_Result, Error) {
	o0: u32
	o1: u32
	if rc := rlx_graph_spd_batch_norm(rawptr(self), u32(x), u32(gamma), eps, u32(iters), tol, &o0, &o1); rc != 0 {
		return {}, Error(rc)
	}
	return Spd_Batch_Norm_Result{first = Node(o0), second = Node(o1)}, .None
}

// The transport step of SPD batch norm against a given `mean`.
spd_batch_norm_transport :: proc(self: Graph, x: Node, mean: Node, gamma: Node, eps: f32) -> (Node, Error) {
	o0: u32
	if rc := rlx_graph_spd_batch_norm_transport(rawptr(self), u32(x), u32(mean), u32(gamma), eps, &o0); rc != 0 {
		return {}, Error(rc)
	}
	return Node(o0), .None
}

