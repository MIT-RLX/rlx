// Write `graph` (borrowed) and its f32 `weights` as an .rlxp model package
// that `Model.open` runs on any device. model: {task, family, outputs: [names], metadata}.
save_model :: proc(graph: Graph, path: string, weights: map[string][]f32, model: string = "") -> Error {
	a_path := strings.clone_to_cstring(path)
	defer delete(a_path)
	a_weights := make_inputs(weights)
	defer free_inputs(a_weights)
	a_model := opt_cstring(model)
	defer delete(a_model)
	if rc := rlx_save_model(rawptr(graph), a_path, raw_data(a_weights.names), raw_data(a_weights.data), raw_data(a_weights.lens), uint(len(a_weights.names)), a_model); rc != 0 {
		return Error(rc)
	}
	return .None
}

