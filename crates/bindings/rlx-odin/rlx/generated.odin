// The library version, e.g. "0.2.18".
version :: proc() -> string {
	return strings.clone_from_cstring(rlx_version())
}

// Backends compiled in and usable on this machine.
devices :: proc() -> ([]string, Error) {
	o0: rawptr
	if rc := rlx_devices(&o0); rc != 0 {
		return {}, Error(rc)
	}
	return take_strings(o0), .None
}

