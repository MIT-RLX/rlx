// One power per `[lo, hi]` band.
band_power :: proc(self: Graph, x: Node, sample_rate: f32, bands: [][]f32) -> (Node, Error) {
	a_bands := flat_frows(bands, 2)
	defer delete(a_bands)
	o0: u32
	if rc := rlx_graph_band_power(rawptr(self), u32(x), sample_rate, raw_data(a_bands), uint(len(bands)), &o0); rc != 0 {
		return {}, Error(rc)
	}
	return Node(o0), .None
}

