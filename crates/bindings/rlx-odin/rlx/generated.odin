// Framed, windowed magnitude (or `power`) spectrogram; `log` takes `ln`.
spectrogram :: proc(self: Graph, x: Node, frame_len: int, hop: int, window: string = "hann", power: bool = true, log: bool = false) -> (Node, Error) {
	a_window := strings.clone_to_cstring(window)
	defer delete(a_window)
	o0: u32
