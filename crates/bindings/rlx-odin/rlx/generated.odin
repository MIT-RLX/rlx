// Whether a compile (or a body-graph argument) consumed it.
is_consumed :: proc(self: Graph) -> bool {
	return rlx_graph_is_consumed(rawptr(self))
}

// Copy `source` into `target` (both borrowed; `target` grows) and return
// `source`'s outputs as `target` nodes. options: {bind: {leaf name: node},
// prefix, adapt_shapes}. Unbound same-named leaves are shared (a tied weight)
// unless `prefix` keeps them apart. On error `target` is unchanged.
splice :: proc(target: Graph, source: Graph, options: string = "") -> ([]Node, Error) {
	a_options := opt_cstring(options)
	defer delete(a_options)
	o0: Slice
	if rc := rlx_splice(rawptr(target), rawptr(source), a_options, &o0); rc != 0 {
		return {}, Error(rc)
	}
	return take_u32s(&o0), .None
}

// `a` and `b` side by side: a's outputs, then b's; same-named leaves shared.
parallel :: proc(a: Graph, b: Graph, name: Maybe(string) = nil) -> (Graph, Error) {
	a_name := maybe_cstring(name)
	defer delete(a_name)
	o0: rawptr
	if rc := rlx_parallel(rawptr(a), rawptr(b), a_name, &o0); rc != 0 {
		return {}, Error(rc)
	}
	return Graph(o0), .None
}

// `b` after `a`: b's inputs, in creation order, are fed by a's outputs.
sequential :: proc(a: Graph, b: Graph, name: Maybe(string) = nil) -> (Graph, Error) {
	a_name := maybe_cstring(name)
	defer delete(a_name)
	o0: rawptr
	if rc := rlx_sequential(rawptr(a), rawptr(b), a_name, &o0); rc != 0 {
		return {}, Error(rc)
	}
	return Graph(o0), .None
}

