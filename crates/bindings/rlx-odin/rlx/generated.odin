scan :: proc(self: Graph, init: Node, body: Graph, length: int, xs: []Node = nil, bcasts: []Node = nil, checkpoints: int = 0, trajectory: bool = false) -> (Node, Error) {
	o0: u32
	if rc := rlx_graph_scan(rawptr(self), u32(init), rawptr(body), u32(length), raw_data(xs), uint(len(xs)), raw_data(bcasts), uint(len(bcasts)), u32(checkpoints), trajectory, &o0); rc != 0 {
		return {}, Error(rc)
	}
	return Node(o0), .None
}

