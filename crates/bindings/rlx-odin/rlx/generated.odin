// A deep copy — compile one, keep building on the other.
clone :: proc(self: Graph) -> (Graph, Error) {
	o0: rawptr
	if rc := rlx_graph_clone(rawptr(self), &o0); rc != 0 {
		return {}, Error(rc)
	}
