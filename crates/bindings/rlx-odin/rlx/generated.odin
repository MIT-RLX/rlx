// A graph whose outputs are [loss, …d(loss)/d(wrt)], with a `d_output` seed input.
grad :: proc(graph: Graph, wrt: []Node) -> (Graph, Error) {
	o0: rawptr
	if rc := rlx_grad(rawptr(graph), raw_data(wrt), uint(len(wrt)), &o0); rc != 0 {
