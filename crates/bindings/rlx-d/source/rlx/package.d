/// rlx for D, over its C ABI (`librlx_capi`): every C function, generated by
/// rlx-bindgen from rlx-bind's tables (`rlx.generated`, `rlx.capi`), on the
/// hand-written `rlx.support` and `rlx.manual`. Functions behind a feature the
/// default library lacks need `-version=rlx_<feature>` (e.g. `rlx_fpga`).
module rlx;

public import std.json : JSONValue, parseJSON;
public import std.typecons : Nullable, Tuple, nullable;

public import rlx.generated;
public import rlx.manual;
public import rlx.support : NONE, RlxErrorKind, RlxException, TypedTensor;
