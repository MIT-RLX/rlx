/target
# Sibling target dirs from alternate toolchains (e.g. target-beta100 for a beta
# rustc) are build output too. Without this, `git add .` descends into tens of
# gigabytes and hashes all of it.
/target*/
/models
*.bak
rlx-cuda/docker/vendor/

# rig.sh — local remote CUDA rig (see rig.sh; config under scripts/rig/)
rig.sh
scripts/.host
scripts/rig/

# local-only docs (not in repo history)
PLAN.md
AGENTS.md

# android build outputs (details in android/.gitignore)
android/target/
android/build/
android/.gradle/
android/app/build/
android/**/intermediates/

# SwiftPM build output for the Swift binding
crates/bindings/rlx-swift/.build/
crates/bindings/rlx-swift/.swiftpm/
crates/bindings/rlx-swift/build/

.env
.env.local
.DS_Store
/weights
.venv-sam3/
.tmp/

# Python bytecode cache
__pycache__/
*.pyc

# rlx-bake demo artifacts (encrypted models)
crates/io/rlx-bake/examples/out/

# pyrlx from_torch example output (generated, machine-specific paths)
crates/bindings/pyrlx/examples/out_*/

# large binaries — fetch/build locally, do not commit
/papers/
**/_pyrlx*.so
*.skin

# MNIST/IDX training data. Every consumer takes an explicit path (the
# cortex-M trainer defaults to torchvision's `~/.cache/torchvision-mnist`),
# so nothing in the tree needs a checked-in copy.
/data/

# rlx-tiny training corpus — regenerate with the rlx-tiny tokenizer.
*.rlxts

# Verilator build output for the FPGA reference designs. Regenerate from the
# checked-in SystemVerilog, inside the design dir:
#   verilator --binary --build -j 0 --top-module tb_bench \
#     -Wno-fatal -Wno-WIDTHEXPAND -Wno-UNUSEDSIGNAL \
#     ./layers/*.sv ./primitives/*.sv ./tb_bench.sv ./top.sv -o sim_bench
crates/backends/rlx-fpga/hw/*/obj_dir/

# `cargo run -p rlxsl --example export` output — generated kernel source,
# written for inspection only and never re-imported.
rlxsl-generated/

# `rlx-cortexm-trainer` writes its INT8 weights to a path relative to the
# crate root; a stale CWD-relative copy used to land here.
crates/backends/rlx-cortexm/trainer/rlx-cortexm/

# clippy output log (machine-specific absolute paths)
clippy.log

# DriverKit extension build output (`rlx-egpu/dext/build.sh`, RLX_DEXT_OUT).
# Holds a signed .dext bundle, the helper binary and the .iig-generated
# sources — all reproducible from dext/, and none of it belongs in a crate
# package.
crates/backends/rlx-egpu/dext/build/

# compiled GPU shader artifacts (built at runtime / by microbenches; never checked in)
*.metallib
*.air
# Metal pipeline cache (RLX_METAL_PIPELINE_CACHE default lives in the temp dir,
# but guard against an in-tree override leaking compiled kernels)
rlx-metal-pipelines/

# Apple node demo — generated artifacts (build with ios/build-xcframework.sh
# and `xcodegen generate`; the sources are project.yml + Sources/).
ios/build/
ios/Demo/RlxDemo.xcodeproj/
# Generated by xcodegen from each target's `info:` block in project.yml.
ios/Demo/Info/
ios/Demo/Sources/Info.plist

# Assembled standalone demo site (build artifact of tools/build_site.py).
crates/bindings/rlx-web/site/
# The GitHub Pages site (`just build-pages`; CI assembles its own).
/_site/
# The page sources in examples/tab-cluster/ are committed so the folder is
# browsable, but its wasm bundle is an 8.4 MB build artifact — rebuild it with
# `just build-cluster-site`. Drop this line if the folder should deploy
# straight from a clone, knowing the binary then lives in history forever.
examples/*/pkg/

# Packaged binding releases (`just package-bindings`, scripts/bindings_release.py).
/dist/
